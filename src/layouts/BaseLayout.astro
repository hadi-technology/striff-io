---
import "../styles/global.css";
import PostHog from "../components/posthog.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const {
  title = "Striff",
  description = "Architecture-aware pull request review inside GitHub.",
  canonical = "https://striff.io/",
  ogImage = "https://striff.io/og-image.png",
  ogType = "website",
  robots = "index,follow"
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0f172a" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Striff" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <!-- Scroll reveals start hidden and are only ever unhidden by script, so the hidden state
         is gated on script actually running. Without this, JS disabled or blocked leaves most
         of a page permanently invisible. Must stay in <head>, before first paint. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.json" />
    <PostHog />
  </head>
  <body>
    <Header />
    <div id="main-content" tabindex="-1">
      <slot />
    </div>
    <Footer />

    <button class="scroll-top" type="button" data-scroll-top aria-label="Scroll back to top">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7" />
      </svg>
    </button>

    <script>
      import { initAnalytics } from "../scripts/analytics.js";

      initAnalytics();
    </script>

    <script is:inline>
      // Scroll to top. Hidden near the top of the page, where it would cover content and
      // do nothing anyway.
      (function () {
        var btn = document.querySelector("[data-scroll-top]");
        if (!btn) return;

        var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var queued = false;

        function update() {
          queued = false;
          btn.classList.toggle("is-visible", window.scrollY > 600);
        }

        window.addEventListener("scroll", function () {
          if (queued) return;
          queued = true;
          requestAnimationFrame(update);
        }, { passive: true });

        btn.addEventListener("click", function () {
          window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
        });

        update();
      })();
    </script>

    <script is:inline>
      (function () {
        var items = Array.from(document.querySelectorAll("[data-reveal]"));
        if (!items.length) return;

        // No observer, no reveal: show everything rather than leaving the page blank.
        if (typeof IntersectionObserver === "undefined") {
          items.forEach(function (item) { item.classList.add("is-visible"); });
          return;
        }

        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.12, rootMargin: "0px 0px -40px 0px" });

        items.forEach(function (item, index) {
          item.style.transitionDelay = Math.min(index * 35, 220) + "ms";
          observer.observe(item);
        });
      })();
    </script>
  </body>
</html>
