---
/**
 * The documented-rule rows: the sentence from the docs with its file and line; the rule it
 * became, in plain English and as the formula that is evaluated (typeset by KaTeX at build
 * time); and the verdict on this pull request with the two satisfaction facts it rests on,
 * M_before and M_after. An optional witness line names what the change did. With
 * `logicNote`, a small expandable note says why the verdicts are rigorous. The homepage hero
 * uses an illustrative example with the note; the flagship blog post shows the real
 * ecChronos run.
 */
import InlineCodeText from "./InlineCodeText.astro";
import { tex } from "../lib/tex";
import "katex/dist/katex.min.css";

interface Props {
  rows: any[];
  baseSha?: string;
  headSha?: string;
  logicNote?: boolean;
}

const { rows, baseSha, headSha, logicNote = false } = Astro.props;
const phiLabel = (i: number) => tex(String.raw`\varphi_{${i + 1}} \coloneqq`);
const satBefore = (i: number) => tex(String.raw`\mathcal{M}_{\mathrm{before}} \htmlClass{sat}{\models} \varphi_{${i + 1}}`);
const satAfter = (i: number, holds: boolean) =>
  tex(holds
    ? String.raw`\mathcal{M}_{\mathrm{after}} \htmlClass{sat}{\models} \varphi_{${i + 1}}`
    : String.raw`\mathcal{M}_{\mathrm{after}} \htmlClass{unsat}{\nvDash} \varphi_{${i + 1}}`);
const phi = tex(String.raw`\varphi`);
const model = tex(String.raw`\mathcal{M}`);
const brokeFacts = tex(String.raw`\mathcal{M}_{\mathrm{before}} \htmlClass{sat}{\models} \varphi \text{ and } \mathcal{M}_{\mathrm{after}} \htmlClass{unsat}{\nvDash} \varphi`);
---

<div class="hcc-table">
  <div class="hcc-thead" aria-hidden="true">
    <span>The sentence in your docs</span>
    <span>The rule it became</span>
    <span>On this PR</span>
  </div>
  {rows.map((row, i) => (
    <div class={`hcc-row hcc-row-${row.verdict}`}>
      <span class="hcc-quote">
        <InlineCodeText class="hcc-quote-text" text={row.quote} />
        <span class="hcc-quote-src">
          <svg viewBox="0 0 16 16" width="11" height="11" fill="currentColor" aria-hidden="true"><path d="M2 1.75C2 .784 2.784 0 3.75 0h6.586c.464 0 .909.184 1.237.513l2.914 2.914c.329.328.513.773.513 1.237v9.586A1.75 1.75 0 0 1 13.25 16h-9.5A1.75 1.75 0 0 1 2 14.25Zm1.75-.25a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25h9.5a.25.25 0 0 0 .25-.25V6h-2.75A1.75 1.75 0 0 1 9 4.25V1.5Zm6.75.062V4.25c0 .138.112.25.25.25h2.688l-.011-.013-2.914-2.914Z"/></svg>
          {row.doc}<b>:{row.line}</b>
        </span>
      </span>
      <span class="hcc-rule">
        <svg class="hcc-rule-arrow" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 3v5a3 3 0 0 0 3 3h9"/><path d="m10.5 7.5 3.5 3.5-3.5 3.5"/></svg>
        <span class="hcc-rule-body">
          <span class="hcc-rule-foot">
            <InlineCodeText class="hcc-rule-text hcc-rule-reading" text={row.statement} />
            {row.craft && <span class="hcc-craft">{row.craft}</span>}
          </span>
          {row.logic && (
            <span class="hcc-formula" aria-hidden="true">
              <span class="hcc-formula-label" set:html={phiLabel(i)} />
              {row.logic.map((line: string[]) => (
                <span class="hcc-formula-line">
                  {line.map((chunk, j) => (
                    <>{j > 0 && " "}<span class="hcc-formula-chunk" set:html={tex(chunk)} /></>
                  ))}
                </span>
              ))}
            </span>
          )}
          {row.witness && <InlineCodeText class="hcc-witness" text={row.witness} />}
        </span>
      </span>
      <span class="hcc-verdict-cell">
        <span class={`hcc-status is-${row.verdict}`}>
          <span class="hcc-status-head">
            {row.verdict === "held" && (
              <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M8 16A8 8 0 1 1 8 0a8 8 0 0 1 0 16Zm3.78-9.72a.75.75 0 0 0-1.06-1.06L6.75 9.19 5.28 7.72a.75.75 0 0 0-1.06 1.06l2 2a.75.75 0 0 0 1.06 0l4.5-4.5Z"/></svg>
            )}
            {row.verdict === "violated" && (
              <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M2.343 13.657A8 8 0 1 1 13.658 2.343 8 8 0 0 1 2.343 13.657ZM6.03 4.97a.751.751 0 0 0-1.06 1.06L6.94 8 4.97 9.97a.75.75 0 1 0 1.06 1.06L8 9.06l1.97 1.97a.75.75 0 0 0 1.06-1.06L9.06 8l1.97-1.97a.75.75 0 0 0-1.06-1.06L8 6.94Z"/></svg>
            )}
            {row.verdictLabel}
          </span>
          <span class="hcc-status-sat" aria-hidden="true">
            <span title={baseSha ? `base ${baseSha}` : undefined} set:html={satBefore(i)} />
            <span title={headSha ? `head ${headSha}` : undefined} set:html={satAfter(i, row.head)} />
          </span>
          <span class="sr-only">{row.head ? "The rule held before this pull request and still holds after it." : "The rule held before this pull request and is broken after it."}</span>
        </span>
      </span>
    </div>
  ))}
</div>
{logicNote && (
  <details class="hcc-proof">
    <summary>
      <span class="hcc-proof-kicker">Neurosymbolic &middot; formal model checking</span>
      <span class="hcc-proof-q">Why this is rigorous</span>
      <svg class="hcc-proof-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </summary>
    <div class="hcc-proof-body">
      <p>A language model reads each sentence in your docs and proposes the rule it states. The rule is compiled into a formula <span set:html={phi} /> in first-order logic, and a parser turns the code before and after the pull request into finite models <span set:html={model} /> of its types, members and references. Every verdict is formal model checking in the logical sense: does the model satisfy the formula?</p>
      <p>A rule is broken by the pull request when <span set:html={brokeFacts} />, and held when nothing in the pull request breaks it. The language model reads and proposes; the program decides.</p>
    </div>
  </details>
)}
