---
const navLinks = [
  { label: "Examples", href: "/#examples" },
  { label: "How It Works", href: "/#how" },
  { label: "Pricing", href: "/pricing" }
];

const contactNavLink = { label: "Contact", href: "/contact" };
const primaryCtaLabel = "Install";
const primaryCtaHref = "https://chromewebstore.google.com/detail/striffs-for-github/gcbcjajnjbplgkhnbemlkadgnjnfjoen";
---

<header class="site-header sticky top-0 z-50 border-b border-slate-200/60 bg-[rgba(255,255,255,0.72)] backdrop-blur-2xl">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-3 text-lg font-bold tracking-tight">
      <span class="flex h-11 w-11 items-center justify-center rounded-2xl border border-white/70 bg-[linear-gradient(180deg,rgba(255,255,255,0.95),rgba(239,246,255,0.92))] shadow-[0_16px_36px_rgba(15,23,42,0.08)]">
        <img src="/icon.svg" alt="Striff logo" class="h-7 w-7" />
      </span>
      <span class="hidden sm:inline font-logo">Striff</span>
    </a>

    <style is:global>
      .font-logo {
        font-family: "Sora", system-ui, sans-serif;
        color: #0f172a;
        letter-spacing: -0.03em;
      }
    </style>
    <nav class="hidden flex-1 items-center gap-2 md:ml-10 md:flex">
      {navLinks.map((link) => (
        <a class="nav-link" href={link.href}>
          {link.label}
        </a>
      ))}
      <a class="nav-link md:ml-auto" href={contactNavLink.href}>
        {contactNavLink.label}
      </a>
    </nav>
    <div class="hidden md:flex md:ml-4">
      <a class="btn-primary" href={primaryCtaHref} target="_blank" rel="noopener noreferrer">{primaryCtaLabel}</a>
    </div>
    <button
      class="md:hidden"
      data-menu-toggle
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">Open menu</span>
      <div class="flex h-10 w-10 items-center justify-center rounded-2xl border border-slate-200/80 bg-white/86 text-slate-900 shadow-[0_12px_28px_rgba(15,23,42,0.08)]">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
      </div>
    </button>
  </div>
  <div
    id="mobile-menu"
    data-mobile-menu
    class="hidden border-t border-slate-200/70 bg-[rgba(255,255,255,0.92)] px-6 py-4 md:hidden"
  >
    <div class="flex flex-col gap-2">
      {navLinks.map((link) => (
        <a class="nav-link" href={link.href}>
          {link.label}
        </a>
      ))}
      <a class="nav-link" href={contactNavLink.href}>
        {contactNavLink.label}
      </a>
      <a class="btn-primary w-full" href={primaryCtaHref} target="_blank" rel="noopener noreferrer">{primaryCtaLabel}</a>
    </div>
  </div>
</header>

<script is:inline>
  var toggle = document.querySelector("[data-menu-toggle]");
  var menu = document.querySelector("[data-mobile-menu]");
  if (toggle && menu) {
    toggle.addEventListener("click", function () {
      var isHidden = menu.classList.toggle("hidden");
      toggle.setAttribute("aria-expanded", String(!isHidden));
    });
    menu.querySelectorAll("a").forEach(function (link) {
      link.addEventListener("click", function () {
        menu.classList.add("hidden");
        toggle.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>
