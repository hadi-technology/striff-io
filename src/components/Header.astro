---
const navLinks = [
  { label: "Examples", href: "/#examples" },
  { label: "For Teams", href: "/#how" },
  { label: "Pricing", href: "/pricing" },
  { label: "Blog", href: "/blog" },
  { label: "Contact", href: "/contact" }
];
const primaryCtaLabel = "Install App";
const primaryCtaHref = "https://github.com/apps/striff-app/installations/new";
const extensionCtaLabel = "Extension";
const extensionCtaHref = "https://chromewebstore.google.com/detail/striffs-for-github/gcbcjajnjbplgkhnbemlkadgnjnfjoen";
---

<header class="site-header sticky top-0 z-50">
  <div class="mx-auto flex max-w-[90rem] items-center justify-between px-6 py-3">
    <a href="/" class="site-brand flex items-center gap-3 text-lg font-bold tracking-tight">
      <span class="site-logo-tile">
        <img src="/icon.svg" alt="Striff logo" class="h-6 w-6" />
      </span>
      <span class="hidden sm:inline font-logo">Striff</span>
    </a>

    <style is:global>
      .font-logo {
        font-family: "Inter", system-ui, sans-serif;
        color: #f1f5f9;
        letter-spacing: 0;
      }
    </style>
    <nav class="hidden flex-1 items-center gap-2 md:ml-10 md:flex">
      {navLinks.map((link) => (
        <a class="nav-link" href={link.href}>
          {link.label}
        </a>
      ))}
    </nav>
    <div class="hidden md:flex md:ml-4 items-center gap-3">
      <a class="btn-chrome" href={extensionCtaHref} target="_blank" rel="noopener noreferrer">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10" />
          <circle cx="12" cy="12" r="4" />
          <line x1="21.17" y1="8" x2="12" y2="8" />
          <line x1="3.95" y1="6.06" x2="8.54" y2="14" />
          <line x1="10.88" y1="21.94" x2="15.46" y2="14" />
        </svg>
        {extensionCtaLabel}
      </a>
      <a class="btn-primary" href={primaryCtaHref} target="_blank" rel="noopener noreferrer">
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
        </svg>
        {primaryCtaLabel}
      </a>
      <div id="auth-button-root"></div>
    </div>
    <button
      class="md:hidden"
      data-menu-toggle
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">Open menu</span>
      <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-slate-100">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
      </div>
    </button>
  </div>
  <div
    id="mobile-menu"
    data-mobile-menu
    class="hidden border-t border-white/10 bg-slate-950/95 px-6 py-4 backdrop-blur md:hidden"
  >
    <div class="flex flex-col gap-2">
      {navLinks.map((link) => (
        <a class="nav-link" href={link.href}>
          {link.label}
        </a>
      ))}
      <a class="btn-chrome w-full" href={extensionCtaHref} target="_blank" rel="noopener noreferrer">{extensionCtaLabel}</a>
      <a class="btn-primary w-full" href={primaryCtaHref} target="_blank" rel="noopener noreferrer">{primaryCtaLabel}</a>
    </div>
  </div>
</header>

<script is:inline>
  var siteHeader = document.querySelector(".site-header");
  if (siteHeader) {
    var onHeaderScroll = function () {
      siteHeader.classList.toggle("is-scrolled", window.scrollY > 8);
    };
    window.addEventListener("scroll", onHeaderScroll, { passive: true });
    onHeaderScroll();
  }

  var toggle = document.querySelector("[data-menu-toggle]");
  var menu = document.querySelector("[data-mobile-menu]");
  if (toggle && menu) {
    toggle.addEventListener("click", function () {
      var isHidden = menu.classList.toggle("hidden");
      toggle.setAttribute("aria-expanded", String(!isHidden));
    });
    menu.querySelectorAll("a").forEach(function (link) {
      link.addEventListener("click", function () {
        menu.classList.add("hidden");
        toggle.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>

<script>
  import { createRoot } from "react-dom/client";
  import { createElement } from "react";
  import AuthButton from "../components/AuthButton";

  const authRoot = document.getElementById("auth-button-root");
  if (authRoot) {
    createRoot(authRoot).render(createElement(AuthButton));
  }
</script>
