---
const navLinks = [
  { label: "Why Striff", href: "/#proof" },
  { label: "Product", href: "/#features" },
  { label: "How It Works", href: "/#how" }
];

const contactNavLink = { label: "Contact", href: "/contact" };
const primaryCtaLabel = "Install Plugin";
const primaryCtaHref = "https://chromewebstore.google.com/detail/striffs-for-github/gcbcjajnjbplgkhnbemlkadgnjnfjoen";
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-[#24292e] backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-3 text-lg font-bold tracking-tight">
      <img src="/icon.svg" alt="Striff logo" class="h-9 w-9" />
      <span class="hidden sm:inline font-logo">Striff</span>
    </a>

    <style is:global>
      .font-logo {
        font-family: "Rubik", system-ui, sans-serif;
        background: linear-gradient(135deg, #fff5c0 0%, #ffec88 40%, #c9a830 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        letter-spacing: 0.02em;
      }
    </style>
    <nav class="hidden flex-1 items-center gap-2 md:ml-10 md:flex">
      {navLinks.map((link) => (
        <a class="nav-link" href={link.href}>
          {link.label}
        </a>
      ))}
      <a class="nav-link md:ml-auto" href={contactNavLink.href}>
        {contactNavLink.label}
      </a>
    </nav>
    <div class="hidden md:flex md:ml-4">
      <a class="btn-primary" href={primaryCtaHref} target="_blank" rel="noopener noreferrer">
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2A10 10 0 0 1 20.66 7H12Z" fill="#EA4335" />
          <path d="M20.66 7A10 10 0 0 1 12 22l4.33-7.5Z" fill="#FBBC04" />
          <path d="M12 22A10 10 0 0 1 3.34 7h8.66Z" fill="#34A853" />
          <circle cx="12" cy="12" r="4.1" fill="#4285F4" stroke="#EAF2FF" stroke-width="1" />
        </svg>
        {primaryCtaLabel}
      </a>
    </div>
    <button
      class="md:hidden"
      data-menu-toggle
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">Open menu</span>
      <div class="flex h-10 w-10 items-center justify-center rounded-full border border-white/20 bg-white/10 text-white shadow-sm">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
      </div>
    </button>
  </div>
  <div
    id="mobile-menu"
    data-mobile-menu
    class="hidden border-t border-white/10 bg-[#24292e] px-6 py-4 md:hidden"
  >
    <div class="flex flex-col gap-2">
      {navLinks.map((link) => (
        <a class="nav-link" href={link.href}>
          {link.label}
        </a>
      ))}
      <a class="nav-link" href={contactNavLink.href}>
        {contactNavLink.label}
      </a>
      <a class="btn-primary w-full" href={primaryCtaHref} target="_blank" rel="noopener noreferrer">{primaryCtaLabel}</a>
    </div>
  </div>
</header>

<script is:inline>
  var toggle = document.querySelector("[data-menu-toggle]");
  var menu = document.querySelector("[data-mobile-menu]");
  if (toggle && menu) {
    toggle.addEventListener("click", function () {
      var isHidden = menu.classList.toggle("hidden");
      toggle.setAttribute("aria-expanded", String(!isHidden));
    });
    menu.querySelectorAll("a").forEach(function (link) {
      link.addEventListener("click", function () {
        menu.classList.add("hidden");
        toggle.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>
