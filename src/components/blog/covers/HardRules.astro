---
/**
 * Cover for the documented-rules post: who the findings are in. Seven public repositories most
 * readers will recognise, drawn to their star counts, each one carrying a documented rule its own
 * code no longer satisfies. The bars grow on reveal so the scale arrives in order, largest first.
 */
const rows = [
  { name: "alibaba/arthas", stars: 37558, label: "37.6k" },
  { name: "redisson/redisson", stars: 24402, label: "24.4k" },
  { name: "apache/dolphinscheduler", stars: 14500, label: "14.5k" },
  { name: "redis/jedis", stars: 12372, label: "12.4k" },
  { name: "aspnetboilerplate", stars: 11998, label: "12.0k" },
  { name: "dotnet/BenchmarkDotNet", stars: 11496, label: "11.5k" },
  { name: "spring-projects/spring-ai", stars: 9482, label: "9.5k" },
];
const X = 232;
const W = 316;
const TOP = 104;
const STEP = 33;
const max = rows[0].stars;
---

<g class="cv-fade">
  <text class="cv-mono cv-caps cv-faint" x="40" y="46" font-size="11">Documented rules, public repositories</text>
  <text class="cv-mono cv-caps cv-faint" x="600" y="46" font-size="11" text-anchor="end">Sep 2026</text>
</g>

<g class="cv-fade" style="--d:0.1s">
  <text class="cv-num" x="40" y="86" font-size="34">58</text>
  <text class="cv-mute" x="92" y="80" font-size="13">repositories carry a rule</text>
  <text class="cv-mute" x="92" y="95" font-size="13">their own code no longer satisfies</text>
</g>

{rows.map((row, i) => (
  <g>
    <text class="cv-mono cv-mute cv-fade" style={`--d:${0.3 + i * 0.07}s`} x={X - 12} y={TOP + i * STEP + 4} font-size="11.5" text-anchor="end">{row.name}</text>
    <rect class="cv-track" x={X} y={TOP + i * STEP - 6} width={W} height="10" rx="5" />
    <rect
      class={`${i === 0 ? "cv-fill-mod" : "cv-fill-tone"} cv-grow-x`}
      style={`--d:${0.45 + i * 0.07}s`}
      x={X}
      y={TOP + i * STEP - 6}
      width={(W * row.stars / max).toFixed(1)}
      height="10"
      rx="5"
    />
    <text class="cv-mono cv-faint cv-fade" style={`--d:${0.85 + i * 0.07}s`} x={X + W + 10} y={TOP + i * STEP + 4} font-size="11">{row.label}</text>
  </g>
))}

<path class="cv-hair" d="M40 348 H600" />

<g class="cv-fade" style="--d:1.15s">
  <text class="cv-num" x="40" y="382" font-size="26">470,086</text>
  <text class="cv-mute" x="152" y="381" font-size="12.5">stars across the 58</text>
  <text class="cv-mono cv-caps cv-faint" x="600" y="381" font-size="10.5" text-anchor="end">7,161 rules &middot; 609 pull requests</text>
</g>
