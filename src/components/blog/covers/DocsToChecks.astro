---
/**
 * Cover for the documented-rules post: docs, then the rule a sentence became, then its check at
 * both revisions, then the pull request's verdict. The ecChronos #1786 case the post walks
 * through: README line 136, the rule "NodeWorker depends on RepairScheduler", held at the base,
 * failed at the head, one violated and 27 held of 28 rules. The doc line turns red once the head
 * fails, because that is the moment the sentence stopped being true.
 */
import { arrowHead } from "./geom";

const docLines = [
  { n: 133, y: 136, w: 112 },
  { n: 134, y: 160, w: 92 },
  { n: 135, y: 184, w: 104 },
  { n: 137, y: 246, w: 84 },
  { n: 138, y: 270, w: 108 },
  { n: 139, y: 294, w: 70 },
];
const toBase = "M428 200 C446 200 444 134 462 134";
const toHead = "M428 224 C446 224 444 272 462 272";
---

<g class="cv-fade">
  <text class="cv-mono cv-caps cv-faint" x="40" y="50" font-size="11">Ericsson/ecchronos · PR #1786</text>
  <text class="cv-mono cv-caps cv-faint" x="600" y="50" font-size="11" text-anchor="end">Docs → rules → checks</text>
</g>

<!-- The document -->
<g class="cv-fade" style="--d:0.1s">
  <rect class="cv-box" x="40" y="80" width="190" height="236" rx="10" />
  <path class="cv-box-head" d="M40 90 a10 10 0 0 1 10 -10 H220 a10 10 0 0 1 10 10 V110 H40 Z" />
  <text class="cv-mono" x="54" y="99" font-size="11.5">README.md</text>
  <text class="cv-mono cv-faint" x="216" y="99" font-size="10" text-anchor="end">core.impl</text>
  {docLines.map((line) => (
    <g>
      <text class="cv-mono cv-faint" x="52" y={line.y + 4} font-size="9.5">{line.n}</text>
      <rect class="cv-doc-line" x="80" y={line.y - 2} width={line.w} height="5" rx="2.5" />
    </g>
  ))}
  <text class="cv-mono cv-faint" x="52" y="218" font-size="9.5">136</text>
</g>
<rect class="cv-hl cv-hl--mod cv-fade" style="--d:0.35s" x="74" y="200" width="150" height="28" rx="6" />
<rect class="cv-hl cv-hl--del cv-fade" style="--d:2.35s" x="74" y="200" width="150" height="28" rx="6" />
<text class="cv-mono cv-fade" style="--d:0.35s" x="82" y="218" font-size="10">Calls RepairScheduler…</text>

<!-- Sentence to rule -->
<path class="cv-e cv-e--mod cv-draw" style="--d:0.6s" pathLength="1" d="M226 214 H270" />
<path class="cv-ah cv-ah--mod cv-fade" style="--d:0.95s" d={arrowHead(226, 214, 272, 214)} />
<path class="cv-pulse cv-pulse--mod" style="--d:1s" pathLength="1" d="M226 214 H270" />

<g class="cv-fade" style="--d:0.75s">
  <rect class="cv-box" x="274" y="172" width="154" height="84" rx="10" />
  <text class="cv-mono cv-caps cv-faint" x="288" y="192" font-size="9.5">Rule</text>
  <text class="cv-mono" x="288" y="215" font-size="12.5">NodeWorker</text>
  <text class="cv-mono cv-mute" x="288" y="238" font-size="12.5">→ RepairScheduler</text>
</g>

<!-- Evaluated at both revisions -->
<path class="cv-e cv-e--add cv-draw" style="--d:1.2s" pathLength="1" d={toBase} />
<path class="cv-ah cv-ah--add cv-fade" style="--d:1.55s" d={arrowHead(444, 134, 462, 134)} />
<path class="cv-pulse cv-pulse--add" style="--d:1.5s" pathLength="1" d={toBase} />

<path class="cv-e cv-e--del cv-draw" style="--d:1.3s" pathLength="1" d={toHead} />
<path class="cv-glow-del cv-flash" style="--d:2.1s" d={toHead} />
<path class="cv-ah cv-ah--del cv-fade" style="--d:1.65s" d={arrowHead(444, 272, 462, 272)} />
<path class="cv-pulse cv-pulse--del" style="--d:1.6s" pathLength="1" d={toHead} />

<g class="cv-fade" style="--d:1.45s">
  <rect class="cv-pill cv-pill--add" x="464" y="112" width="136" height="44" rx="10" />
  <circle class="cv-fill-add" cx="484" cy="134" r="8" />
  <path class="cv-tick" d="M480 134.5 l3 3 l5.5 -6" />
  <text x="500" y="131" font-size="12.5">holds at base</text>
  <text class="cv-mono cv-faint" x="500" y="147" font-size="9.5">d188eb1b33</text>
</g>
<g class="cv-fade" style="--d:1.75s">
  <rect class="cv-pill cv-pill--del" x="464" y="250" width="136" height="44" rx="10" />
  <circle class="cv-fill-del" cx="484" cy="272" r="8" />
  <path class="cv-tick" d="M480.5 268.5 l7 7 M487.5 268.5 l-7 7" />
  <text class="cv-c-del" x="500" y="269" font-size="12.5">fails at head</text>
  <text class="cv-mono cv-faint" x="500" y="285" font-size="9.5">0288412016</text>
</g>

<!-- The check on the pull request -->
<path class="cv-e cv-e--del cv-draw" style="--d:2s" pathLength="1" d="M532 294 V330" />
<path class="cv-ah cv-ah--del cv-fade" style="--d:2.25s" d={arrowHead(532, 300, 532, 334)} />
<path class="cv-pulse cv-pulse--del" style="--d:2.2s" pathLength="1" d="M532 294 V330" />

<g class="cv-fade" style="--d:2.15s">
  <rect class="cv-box" x="40" y="336" width="560" height="40" rx="10" />
  <text x="58" y="360" font-size="12.5" font-weight="600">Striff check</text>
  <text class="cv-c-del" x="186" y="360" font-size="12.5">1 violated</text>
  <circle class="cv-fill-add" cx="282" cy="356" r="4" />
  <text class="cv-mute" x="292" y="360" font-size="12.5">27 held</text>
  <text class="cv-mono cv-faint" x="584" y="360" font-size="10.5" text-anchor="end">28 rules checked</text>
</g>
<circle class="cv-fill-del cv-blink" style="--d:2.4s" cx="176" cy="356" r="4" />
