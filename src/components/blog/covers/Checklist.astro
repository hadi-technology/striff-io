---
/**
 * Cover for the review-checklist post. Top: step 3 on a real layering rule from the post, "domain
 * does not depend on infrastructure": infrastructure already depends on domain, and one new edge
 * points back across the boundary. Bottom: the seven steps, filled by how far the post says a
 * machine can take each (1 and 3 to 6 fully, 2 mostly, 7 not really).
 */
import { arrowHead, sCurve } from "./geom";

const W = 86;
const H = 50;
const boxes = [
  { x: 58, y: 128 },
  { x: 58, y: 206 },
  { x: 190, y: 166, hot: true },
  { x: 366, y: 128 },
  { x: 366, y: 206 },
  { x: 498, y: 166, hot: true },
];

// Existing edges: inside each layer, and infrastructure depending on domain (the allowed way).
const allowed = [
  sCurve(144, 153, 190, 181),
  sCurve(144, 231, 190, 201),
  sCurve(498, 181, 452, 153),
  sCurve(498, 201, 452, 231),
  sCurve(366, 145, 276, 176),
  sCurve(366, 239, 276, 206),
];
const breach = "M276 191 H496";

const steps = [
  { n: 1, state: "full" },
  { n: 2, state: "half" },
  { n: 3, state: "full" },
  { n: 4, state: "full" },
  { n: 5, state: "full" },
  { n: 6, state: "full" },
  { n: 7, state: "none" },
];
---

<g class="cv-fade">
  <text class="cv-mono cv-caps cv-faint" x="40" y="52" font-size="10.5">Your docs</text>
  <text class="cv-serif" x="128" y="53" font-size="16" font-style="italic">“domain does not depend on infrastructure”</text>
  <text class="cv-mono cv-caps cv-faint" x="600" y="52" font-size="10.5" text-anchor="end">Step 3</text>
</g>

<g class="cv-fade" style="--d:0.1s">
  <rect class="cv-zone" x="36" y="84" width="262" height="192" rx="14" />
  <text class="cv-mono cv-mute" x="52" y="106" font-size="11.5">domain</text>
  <rect class="cv-zone" x="342" y="84" width="262" height="192" rx="14" />
  <text class="cv-mono cv-mute" x="358" y="106" font-size="11.5">infrastructure</text>
</g>

{allowed.map((edge, i) => (
  <g>
    <path class="cv-e cv-draw" style={`--d:${0.45 + i * 0.08}s`} pathLength="1" d={edge.d} />
    <path class="cv-ah cv-fade" style={`--d:${0.9 + i * 0.08}s`} d={arrowHead(edge.from[0], edge.from[1], edge.to[0], edge.to[1])} />
  </g>
))}

{boxes.map((box, i) => (
  <g class="cv-fade" style={`--d:${0.2 + i * 0.06}s`}>
    <rect class={box.hot ? "cv-box cv-box--mod" : "cv-box"} x={box.x} y={box.y} width={W} height={H} rx="7" />
    <path class="cv-hair" d={`M${box.x} ${box.y + 16} H${box.x + W}`} />
    <rect class={box.hot ? "cv-fill-mod" : "cv-doc-line"} x={box.x + 9} y={box.y + 6} width="34" height="4" rx="2" />
    <rect class="cv-doc-line" x={box.x + 9} y={box.y + 25} width={box.hot ? 58 : 48} height="4" rx="2" />
    <rect class="cv-doc-line" x={box.x + 9} y={box.y + 35} width={box.hot ? 40 : 30} height="4" rx="2" />
  </g>
))}

<!-- The new edge: drawn as an addition, then flagged as the breach it is. -->
<path class="cv-glow-del cv-flash" style="--d:1.95s" d={breach} />
<path class="cv-e cv-e--breach cv-draw" style="--d:1.3s" pathLength="1" d={breach} />
<path class="cv-ah cv-ah--del cv-fade" style="--d:1.75s" d={arrowHead(470, 191, 498, 191, 8)} />
<path class="cv-pulse cv-pulse--del" style="--d:2.2s" pathLength="1" d={breach} />
<g class="cv-pop" style="--d:1.9s">
  <circle class="cv-x-mark" cx="320" cy="191" r="9" />
  <path class="cv-x-stroke" d="M316.5 187.5 l7 7 M323.5 187.5 l-7 7" />
</g>
<text class="cv-c-del cv-fade" style="--d:2s" x="320" y="300" font-size="12.5" text-anchor="middle">New edge: domain → infrastructure</text>

<text class="cv-mono cv-caps cv-faint cv-fade" style="--d:0.3s" x="40" y="342" font-size="10.5">7 steps</text>
{steps.map((step, i) => {
  const x = 104 + i * 40;
  return (
    <g class="cv-pop" style={`--d:${0.5 + i * 0.09}s`}>
      <rect class={`cv-step cv-step--${step.state}`} x={x} y="322" width="30" height="30" rx="7" />
      {step.state === "half" && <path class="cv-step-half" d={`M${x + 30} 329 V345 a7 7 0 0 1 -7 7 H${x + 7} Z`} />}
      <text class={step.state === "none" ? "cv-mono cv-faint" : "cv-mono"} x={x + 15} y="341" font-size="11.5" text-anchor="middle">{step.n}</text>
    </g>
  );
})}
<g class="cv-fade" style="--d:1.1s">
  <rect class="cv-step cv-step--full" x="404" y="322" width="11" height="11" rx="3" />
  <text class="cv-mute" x="422" y="332" font-size="11.5">a machine can take it</text>
  <rect class="cv-step cv-step--none" x="404" y="341" width="11" height="11" rx="3" />
  <text class="cv-mute" x="422" y="351" font-size="11.5">needs your judgment</text>
</g>
