---
/**
 * Cover for the stale-instructions post: the line itself, and the dates around it. An agent
 * instruction file with line 258 lit, above a timeline in which the class it names is deprecated,
 * named, deleted, and still named today. The stretch after the deletion is drawn in red, because
 * that is the part of the timeline where the sentence is wrong.
 */
const lines = [
  { n: 256, text: "- Server primitives (tools, prompts, resources) are…" },
  { n: 257, text: "- Support both attribute-based registration (…)" },
  { n: 258, text: "- Use `McpServerFactory` to create server instances", hl: true },
  { n: 259, text: "" },
];
const CARD_X = 80;
const CARD_Y = 70;
const CARD_W = 480;

// Not to scale: the first three events fall within three months of each other, so they get even
// spacing, and the ten months after the deletion get the rest of the rail.
const TY = 300;
const T1 = 540;
const events = [
  { x: 110, label: "obsoleted", date: "Sep 2025", tone: "cv-fill-slate" },
  { x: 200, label: "line written", date: "Oct 2025", tone: "cv-fill-mod" },
  { x: 290, label: "class deleted", date: "Dec 2025", tone: "cv-fill-del" },
  { x: T1, label: "still there", date: "Sep 2026", tone: "cv-fill-tone" },
];
const DEL = events[2].x;
---

<g class="cv-fade">
  <text class="cv-mono cv-caps cv-faint" x={CARD_X} y="46" font-size="10.5">modelcontextprotocol/csharp-sdk</text>
  <text class="cv-mono cv-faint" x={CARD_X + CARD_W} y="46" font-size="10.5" text-anchor="end">.github/copilot-instructions.md</text>
</g>

<g class="cv-fade" style="--d:0.15s">
  <rect class="cv-box" x={CARD_X} y={CARD_Y} width={CARD_W} height="132" rx="10" />
  {lines.map((line, i) => (
    <g>
      {line.hl && <rect class="cv-hl--del" x={CARD_X + 1} y={CARD_Y + 14 + i * 28} width={CARD_W - 2} height="26" />}
      <text class="cv-mono cv-faint" x={CARD_X + 34} y={CARD_Y + 31 + i * 28} font-size="11" text-anchor="end">{line.n}</text>
      <text class={`cv-mono ${line.hl ? "" : "cv-mute"}`} x={CARD_X + 48} y={CARD_Y + 31 + i * 28} font-size="12">{line.text}</text>
    </g>
  ))}
</g>

<path class="cv-hair" d={`M${events[0].x} ${TY} H${T1}`} />
<path class="cv-e cv-e--del cv-grow-x" style="--d:0.9s" d={`M${DEL} ${TY} H${T1}`} stroke-width="3" />
<text class="cv-mono cv-c-del cv-fade" style="--d:1.2s" x={(DEL + T1) / 2} y={TY - 12} font-size="11" text-anchor="middle">documented, not in the code &middot; 10 months</text>

{events.map((e, i) => (
  <g class="cv-fade" style={`--d:${0.4 + i * 0.15}s`}>
    <circle class={e.tone} cx={e.x} cy={TY} r="6" />
    <text class="cv-mono cv-faint" x={e.x} y={TY + 26} font-size="10" text-anchor="middle">{e.date}</text>
    <text class="cv-mute" x={e.x} y={TY + 42} font-size="11.5" text-anchor="middle">{e.label}</text>
  </g>
))}
