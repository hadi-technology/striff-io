---
/**
 * Cover for the "receipt" post: the finding's receipt, printed. The five lines are the post's own
 * receipt for ecChronos #1786, and the notes either side say who produced each line: quoted from
 * the docs, proposed by the model, computed at both revisions, decided by a program.
 */
interface Props {
  uid: string;
}

const { uid } = Astro.props;

const LEFT = 185;
const RIGHT = 455;
const TOP = 40;
const BOTTOM = 346;
const TEETH = 18;
const tooth = (RIGHT - LEFT) / TEETH;
let edge = `M${LEFT} ${TOP} H${RIGHT} V${BOTTOM}`;
for (let i = 0; i < TEETH; i++) edge += ` l${-tooth / 2} 8 l${-tooth / 2} -8`;
edge += " Z";

const rows = [
  { y: 124, key: "doc", value: "core.impl/README.md:136" },
  { y: 146, key: "says", value: "“Calls RepairScheduler…”" },
  { y: 168, key: "rule", value: "NodeWorker → RepairScheduler" },
];
const revisions = [
  { y: 206, key: "base", sha: "d188eb1b33", verdict: "holds ✓", tone: "cv-r-ok" },
  { y: 228, key: "head", sha: "0288412016", verdict: "fails ✗", tone: "cv-r-bad" },
];
const barcode = [2, 1, 3, 1, 1, 2, 1, 3, 2, 1, 1, 2, 3, 1, 2, 1, 1, 3, 1, 2, 2, 1, 3, 1, 1, 2, 1, 2, 3, 1];
let bx = 250;
const bars = barcode.map((w, i) => {
  const bar = { x: bx, w: i % 2 === 0 ? w * 1.4 : 0 };
  bx += w * 1.4 + 1.6;
  return bar;
}).filter((bar) => bar.w > 0);

const notes = [
  { side: "left", y: 132, lines: ["quoted from", "your docs"], dot: "cv-fill-slate" },
  { side: "left", y: 176, lines: ["proposed by", "the model"], dot: "cv-fill-add" },
  { side: "right", y: 214, lines: ["computed at", "both revisions"], dot: "cv-fill-mod" },
  { side: "right", y: 276, lines: ["decided by", "a program"], dot: "cv-fill-mod" },
];
---

<defs>
  <clipPath id={`${uid}-slot`}>
    <rect x="-1000" y="36" width="2640" height="1000" />
  </clipPath>
</defs>

{notes.map((note, i) => {
  const left = note.side === "left";
  const tx = left ? 160 : 480;
  const lx1 = left ? 166 : RIGHT + 4;
  const lx2 = left ? LEFT - 4 : 474;
  return (
    <g class="cv-fade" style={`--d:${1.2 + i * 0.16}s`}>
      <path class="cv-hair" d={`M${lx1} ${note.y - 4} H${lx2}`} />
      <circle class={note.dot} cx={left ? lx2 : lx1} cy={note.y - 4} r="2.5" />
      {note.lines.map((line, j) => (
        <text class="cv-mute" x={tx} y={note.y + j * 16 - (note.lines.length - 1) * 8} font-size="12.5" text-anchor={left ? "end" : "start"}>{line}</text>
      ))}
    </g>
  );
})}

<g clip-path={`url(#${uid}-slot)`}>
  <g class="cv-print">
    <path class="cv-paper-shadow" d={edge} transform="translate(5 7)" />
    <path class="cv-paper" d={edge} />
    <text class="cv-r cv-r-strong" x="320" y="68" font-size="11.5" text-anchor="middle" letter-spacing="2">STRIFF CHECK</text>
    <text class="cv-r cv-r-mute" x="320" y="86" font-size="10" text-anchor="middle">ericsson/ecchronos #1786</text>
    <path class="cv-r-rule" d="M205 100 H435" />
    {rows.map((row) => (
      <g>
        <text class="cv-r cv-r-mute" x="205" y={row.y} font-size="10.5">{row.key}</text>
        <text class="cv-r" x="244" y={row.y} font-size="10.5">{row.value}</text>
      </g>
    ))}
    <path class="cv-r-rule" d="M205 184 H435" />
    {revisions.map((row) => (
      <g>
        <text class="cv-r cv-r-mute" x="205" y={row.y} font-size="10.5">{row.key}</text>
        <text class="cv-r" x="244" y={row.y} font-size="10.5">{row.sha}</text>
        <text class={`cv-r ${row.tone}`} x="435" y={row.y} font-size="10.5" text-anchor="end">{row.verdict}</text>
      </g>
    ))}
    <path class="cv-r-rule" d="M205 246 H435" />
    <text class="cv-r cv-r-mute" x="205" y="272" font-size="10.5">verdict</text>
    <text class="cv-r cv-r-mute" x="320" y="306" font-size="9.5" text-anchor="middle">true at base · false at head</text>
    {bars.map((bar) => <rect class="cv-r-code" x={bar.x.toFixed(1)} y="318" width={bar.w.toFixed(1)} height="16" />)}
    <g transform="translate(378 270) rotate(-8)">
      <g class="cv-stamp" style="--d:1.95s">
        <rect class="cv-stamp-box" x="-58" y="-17" width="116" height="34" rx="5" />
        <text class="cv-stamp-t" x="0" y="5.5" font-size="15" text-anchor="middle" letter-spacing="2.5">VIOLATED</text>
      </g>
    </g>
  </g>
</g>

<rect class="cv-slot" x="165" y="28" width="310" height="14" rx="7" />
