---
/**
 * Head tags every blog page shares: the RSS feed, preloads for the two faces the first screen is
 * set in, and the switch that animates post covers. The @font-face rules live in styles/blog.css.
 */
import { BLOG_NAME } from "../../lib/blog";
---

<link rel="alternate" type="application/rss+xml" title={BLOG_NAME} href="/blog/rss.xml" />
<link rel="preload" href="/fonts/newsreader-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

<!-- Cover motion (PostCover). Armed before first paint, and only when the reader welcomes motion
     and the observer exists, so the hidden start states never apply otherwise. A cover plays once
     it is a third in view; hovering its card replays the pulses. -->
<script is:inline>
  (function (d) {
    if (!window.matchMedia || !matchMedia("(prefers-reduced-motion: no-preference)").matches) return;
    if (!("IntersectionObserver" in window)) return;
    d.documentElement.classList.add("cv-motion");
    var start = function () {
      var seen = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("cv-play");
          seen.unobserve(entry.target);
        });
      }, { threshold: 0.3 });
      d.querySelectorAll("[data-cv]").forEach(function (cover) {
        seen.observe(cover);
        var host = cover.closest("[data-cv-host]");
        if (!host) return;
        host.addEventListener("pointerenter", function () {
          if (cover.classList.contains("cv-play")) cover.classList.toggle("cv-again");
        });
      });
    };
    if (d.readyState === "loading") d.addEventListener("DOMContentLoaded", start);
    else start();
  })(document);
</script>
