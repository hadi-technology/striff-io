---
/**
 * Cover art for a post: a small component graph generated from the post's slug and tinted by its
 * category, so every post has its own picture and keeps it on every build. Purely decorative: it
 * is hidden from assistive technology and carries no information the card does not already say.
 */
import { categoryTone } from "../../lib/blog";

interface Props {
  slug: string;
  category: string;
  class?: string;
}

const { slug, category, class: extra = "" } = Astro.props;
const tone = categoryTone(category);

function hash(text: string): number {
  let h = 2166136261;
  for (let i = 0; i < text.length; i++) {
    h ^= text.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

// mulberry32: a tiny seeded generator, so the same slug always draws the same graph.
function seeded(seed: number): () => number {
  let state = seed;
  return () => {
    state = (state + 0x6d2b79f5) | 0;
    let t = Math.imul(state ^ (state >>> 15), 1 | state);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const seed = hash(slug);
const rand = seeded(seed);
const uid = `cv${seed.toString(36)}`;

const W = 480;
const H = 300;
const COLS = 4;
const ROWS = 3;
const NODE_W = 78;
const NODE_H = 36;

const cells = Array.from({ length: COLS * ROWS }, (_, i) => i);
for (let i = cells.length - 1; i > 0; i--) {
  const j = Math.floor(rand() * (i + 1));
  [cells[i], cells[j]] = [cells[j]!, cells[i]!];
}

const nodes = cells.slice(0, 7).map((cell) => {
  const col = cell % COLS;
  const row = Math.floor(cell / COLS);
  const cx = (W / COLS) * (col + 0.5) + (rand() - 0.5) * 28;
  const cy = (H / ROWS) * (row + 0.5) + (rand() - 0.5) * 24;
  return {
    cx,
    cy,
    x: Math.round(cx - NODE_W / 2),
    y: Math.round(cy - NODE_H / 2),
    bars: [22 + Math.round(rand() * 30), 14 + Math.round(rand() * 26)],
  };
});

// Each node links to its nearest earlier node: always connected, never a hairball.
type Edge = { from: number; to: number; kind: "base" | "added" | "removed" };
const edges: Edge[] = [];
for (let i = 1; i < nodes.length; i++) {
  let nearest = 0;
  let best = Infinity;
  for (let j = 0; j < i; j++) {
    const d = Math.hypot(nodes[i]!.cx - nodes[j]!.cx, nodes[i]!.cy - nodes[j]!.cy);
    if (d < best) {
      best = d;
      nearest = j;
    }
  }
  edges.push({ from: nearest, to: i, kind: "base" });
}

const hot = Math.floor(rand() * nodes.length);
for (const edge of edges) {
  if (edge.from === hot || edge.to === hot) edge.kind = "added";
}
const removable = edges.find((edge) => edge.kind === "base");
if (removable) removable.kind = "removed";

const curve = (a: (typeof nodes)[number], b: (typeof nodes)[number]) => {
  const mid = (a.cx + b.cx) / 2;
  return `M${a.cx.toFixed(1)} ${a.cy.toFixed(1)} C${mid.toFixed(1)} ${a.cy.toFixed(1)} ${mid.toFixed(1)} ${b.cy.toFixed(1)} ${b.cx.toFixed(1)} ${b.cy.toFixed(1)}`;
};

const glow = nodes[hot]!;
---

<svg
  class={`sb-cover sb-cover--${tone} ${extra}`.trim()}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={`${uid}-bg`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" class="cv-s1" />
      <stop offset="1" class="cv-s2" />
    </linearGradient>
    <radialGradient id={`${uid}-glow`} cx={(glow.cx / W).toFixed(3)} cy={(glow.cy / H).toFixed(3)} r="0.6">
      <stop offset="0" class="cv-g1" />
      <stop offset="1" class="cv-g2" />
    </radialGradient>
    <pattern id={`${uid}-dots`} width="16" height="16" patternUnits="userSpaceOnUse">
      <circle cx="1.5" cy="1.5" r="1" class="cv-dot" />
    </pattern>
  </defs>
  <rect width={W} height={H} fill={`url(#${uid}-bg)`} />
  <rect width={W} height={H} fill={`url(#${uid}-glow)`} />
  <rect width={W} height={H} fill={`url(#${uid}-dots)`} />
  <g>
    {edges.map((edge) => (
      <path class={`cv-edge cv-edge--${edge.kind}`} d={curve(nodes[edge.from]!, nodes[edge.to]!)} />
    ))}
  </g>
  <g>
    {nodes.map((node, i) => (
      <g class={i === hot ? "cv-node cv-node--hot" : "cv-node"} transform={`translate(${node.x} ${node.y})`}>
        <rect class="cv-box" width={NODE_W} height={NODE_H} rx="6" />
        <line class="cv-rule" x1="0" x2={NODE_W} y1="12" y2="12" />
        <rect class="cv-bar" x="8" y="5" width="30" height="3" rx="1.5" />
        <rect class="cv-bar cv-bar--dim" x="8" y="18" width={node.bars[0]} height="3" rx="1.5" />
        <rect class="cv-bar cv-bar--dim" x="8" y="26" width={node.bars[1]} height="3" rx="1.5" />
      </g>
    ))}
  </g>
</svg>
