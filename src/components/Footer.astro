---
const cwsUrl = "https://chromewebstore.google.com/detail/striffs-for-github/gcbcjajnjbplgkhnbemlkadgnjnfjoen";
---

<footer class="site-footer border-t border-white/10 bg-[linear-gradient(180deg,rgba(8,15,30,0.96),rgba(12,22,40,0.98))] py-14 backdrop-blur-xl">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 footer-grid md:grid-cols-[1.1fr_1.4fr_auto] md:items-start">
    <div class="max-w-xs footer-brand">
      <div class="font-semibold footer-title">Striff</div>
      <p class="mt-3 text-base footer-copy">Architecture-aware pull request review for teams that care about structural quality.</p>
      <a class="footer-install-link" href={cwsUrl} target="_blank" rel="noopener noreferrer">Install the Chrome extension</a>
    </div>
    <div class="flex flex-wrap gap-x-7 gap-y-3 footer-links">
      <a class="flex items-center gap-2 transition-colors duration-200" href="https://github.com/hadi-technology/striff-lib" aria-label="Striff GitHub">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.51 2.87 8.33 6.84 9.68.5.1.68-.22.68-.48 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1.01.07 1.54 1.08 1.54 1.08.9 1.58 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.15-4.56-5.11 0-1.13.39-2.05 1.03-2.78-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.06.8-.23 1.66-.34 2.52-.35.86.01 1.72.12 2.52.35 1.9-1.34 2.74-1.06 2.74-1.06.55 1.41.2 2.45.1 2.71.64.73 1.03 1.65 1.03 2.78 0 3.97-2.34 4.85-4.57 5.1.36.32.68.96.68 1.94 0 1.4-.01 2.53-.01 2.88 0 .27.18.59.69.48A10.03 10.03 0 0 0 22 12.26C22 6.58 17.52 2 12 2z" />
        </svg>
        GitHub
      </a>
      <a class="flex items-center gap-2 transition-colors duration-200" href="https://www.iccq.ru/2021.html" target="_blank" rel="noopener noreferrer" aria-label="ICCQ 2021 research paper">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M12 14l9-5-9-5-9 5 9 5z"/><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
        </svg>
        Research · ICCQ 2021
      </a>
      <a class="transition-colors duration-200" href={cwsUrl} target="_blank" rel="noopener noreferrer">Extension</a>
      <a class="transition-colors duration-200" href="/#examples">Examples</a>
      <a class="transition-colors duration-200" href="/pricing">Pricing</a>
      <a class="transition-colors duration-200" href="/contact">Contact</a>
      <a class="transition-colors duration-200" href="/privacy">Privacy</a>
      <a class="transition-colors duration-200" href="/terms">Terms</a>
      <a class="transition-colors duration-200" href="/cookies">Cookies</a>
    </div>
    <div class="text-sm footer-legal md:text-right">
      Striff is a trademark of HADI Technology.
    </div>
  </div>
</footer>
