      <a class="transition-colors duration-200 hover:text-ink" href={cwsUrl} target="_blank" rel="noopener noreferrer">Extension</a>
      <a class="transition-colors duration-200 hover:text-ink" href="/#github-check">Roadmap</a>
      <a class="transition-colors duration-200 hover:text-ink" href="/contact">Contact</a>
      <a class="transition-colors duration-200 hover:text-ink" href="/privacy">Privacy</a>
      <a class="transition-colors duration-200 hover:text-ink" href="/terms">Terms</a>
      <a class="transition-colors duration-200 hover:text-ink" href="/cookies">Cookies</a>
