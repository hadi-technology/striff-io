  // Campaign parameters are for the first pageview only. Once it has been captured they are
  // taken out of the address bar, so a copied or bookmarked link does not carry them on. Where
  // the analytics library is blocked there is no pageview to wait for, and they go at once.
  var stripCampaignParams = function () {
    var url = new URL(window.location.href), found = false;
    Array.from(url.searchParams.keys()).forEach(function (key) {
      if (/^utm_/i.test(key)) { url.searchParams.delete(key); found = true; }
    });
    if (found) window.history.replaceState(window.history.state, "", url.pathname + url.search + url.hash);
  };
  posthog.init(apiKey || '', {
    api_host: apiHost || '',
    defaults: '2026-01-30',
    loaded: function (ph) {
      ph.on('eventCaptured', function (event) {
        if (event && event.event === '$pageview') stripCampaignParams();
      });
    }
  })
  var library = document.querySelector('script[src$="/static/array.js"]');
  if (library) library.addEventListener('error', stripCampaignParams);
</script>
