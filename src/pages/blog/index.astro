---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogHead from "../../components/blog/BlogHead.astro";
import Byline from "../../components/blog/Byline.astro";
import PostCard from "../../components/blog/PostCard.astro";
import PostCover from "../../components/blog/PostCover.astro";
import {
  BLOG_DESCRIPTION,
  BLOG_MISSION,
  BLOG_NAME,
  SITE,
  categorySlug,
  categoryTone,
  formatDate,
  getPublishedPosts,
  readingMinutes,
} from "../../lib/blog";
import "../../styles/blog.css";

const posts = await getPublishedPosts();
const [featured, ...rest] = posts;

const categories = Array.from(
  posts
    .reduce((all, post) => {
      const key = categorySlug(post.data.category);
      const entry = all.get(key) ?? { key, name: post.data.category, count: 0 };
      entry.count += 1;
      return all.set(key, entry);
    }, new Map<string, { key: string; name: string; count: number }>())
    .values()
).sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout
  title={`${BLOG_NAME} · Blog`}
  description="Notes on documented architecture, structural review and keeping a codebase coherent while agents write most of it."
  canonical={`${SITE}/blog`}
  scheme="auto"
>
  <Fragment slot="head">
    <BlogHead />
  </Fragment>

  <main class="sb sb-index">
    <div class="sb-shell">
      <header class="sb-masthead">
        <div class="sb-masthead-bar">
          <p class="sb-label">Blog</p>
          <a class="sb-rss" href="/blog/rss.xml">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9" /><path d="M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1" /></svg>
            RSS feed
          </a>
        </div>
        <h1 class="sb-masthead-title">Striff <em>Engineering</em></h1>
        <div class="sb-masthead-foot">
          <p class="sb-masthead-mission">{BLOG_MISSION}</p>
          <p class="sb-masthead-desc">{BLOG_DESCRIPTION}</p>
        </div>
      </header>

      {categories.length > 1 && (
        <div class="sb-filter" data-sb-filter>
          <p class="sb-label" id="sb-filter-label">Topics</p>
          <div class="sb-filter-chips" role="group" aria-labelledby="sb-filter-label">
            <button type="button" class="sb-chip" data-filter="all" aria-pressed="true">
              All <span class="sb-chip-count">{posts.length}</span>
            </button>
            {categories.map((category) => (
              <button type="button" class="sb-chip" data-filter={category.key} aria-pressed="false">
                {category.name} <span class="sb-chip-count">{category.count}</span>
              </button>
            ))}
          </div>
        </div>
      )}

      {featured && (
        <article class="sb-feature" data-sb-item data-category={categorySlug(featured.data.category)} data-cv-host>
          <div class="sb-feature-cover">
            <PostCover slug={featured.slug} category={featured.data.category} cover={featured.data.cover} variant="feature" />
          </div>
          <div class="sb-feature-body">
            <div class="sb-feature-meta">
              <span class="sb-latest">Latest</span>
              <p class="sb-meta">
                <span class={`sb-cat sb-tone-${categoryTone(featured.data.category)}`}>{featured.data.category}</span>
                <time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time>
                <span>{readingMinutes(featured)} min read</span>
              </p>
            </div>
            <h2 class="sb-feature-title"><a href={`/blog/${featured.slug}`}>{featured.data.title}</a></h2>
            <p class="sb-feature-dek">{featured.data.description}</p>
            <div class="sb-feature-foot">
              <Byline name={featured.data.author} role={featured.data.authorRole} avatar={featured.data.authorAvatar} size="sm" />
              <span class="sb-readmore" aria-hidden="true">
                Read article
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
              </span>
            </div>
          </div>
        </article>
      )}

      {rest.length > 0 && (
        <section class="sb-more" data-sb-more aria-labelledby="sb-more-title">
          <div class="sb-section-head">
            <h2 id="sb-more-title" class="sb-label">More articles</h2>
          </div>
          <div class="sb-grid">
            {rest.map((post) => <PostCard post={post} filterable />)}
          </div>
        </section>
      )}

      {posts.length === 0 && <p class="sb-empty">No posts yet. Check back soon.</p>}
    </div>
  </main>

  <script is:inline>
    // Topic filter. Every post is in the page; this only hides the ones outside the chosen topic.
    (function () {
      var bar = document.querySelector("[data-sb-filter]");
      if (!bar) return;
      var buttons = Array.prototype.slice.call(bar.querySelectorAll("button[data-filter]"));
      var items = Array.prototype.slice.call(document.querySelectorAll("[data-sb-item]"));
      var more = document.querySelector("[data-sb-more]");

      function apply(key) {
        var restShown = 0;
        items.forEach(function (item) {
          var match = key === "all" || item.getAttribute("data-category") === key;
          item.hidden = !match;
          if (match && item.hasAttribute("data-sb-rest")) restShown++;
        });
        if (more) more.hidden = restShown === 0;
        buttons.forEach(function (button) {
          button.setAttribute("aria-pressed", String(button.getAttribute("data-filter") === key));
        });
      }

      buttons.forEach(function (button) {
        button.addEventListener("click", function () {
          apply(button.getAttribute("data-filter"));
        });
      });
    })();
  </script>
</BaseLayout>
