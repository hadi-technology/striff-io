---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");

const posts = allPosts
  .map((post) => ({
    title: post.data.title,
    description: post.data.description,
    date: post.data.date,
    slug: post.id,
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<BaseLayout
  title="Blog - Striff"
  description="Architecture-aware code review insights, engineering patterns, and product updates from the Striff team."
  canonical="https://striff.io/blog"
>
  <main class="pb-20 pt-16">
    <div class="mx-auto max-w-[90rem] px-6">
      <div class="mx-auto max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-500" data-reveal>Blog</p>
        <h1 class="mt-3 text-balance" data-reveal>Insights on architecture-aware code review.</h1>
        <p class="section-subcopy mt-4" data-reveal>
          Engineering patterns, real findings from open-source PRs, and updates on making structural review part of every pull request.
        </p>
      </div>

      <div class="mx-auto mt-12 grid max-w-5xl gap-5 md:grid-cols-2">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="blog-card" data-reveal>
            <p class="blog-card-date">
              {new Date(post.date).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </p>
            <h2 class="blog-card-title">{post.title}</h2>
            <p class="blog-card-desc">{post.description}</p>
            <span class="blog-card-link">
              Read more
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
            </span>
          </a>
        ))}
      </div>

      {posts.length === 0 && (
        <div class="mx-auto mt-16 max-w-md text-center">
          <p class="text-slate-500">No posts yet. Check back soon.</p>
        </div>
      )}
    </div>
  </main>
</BaseLayout>
