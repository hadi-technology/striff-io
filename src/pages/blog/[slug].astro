---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogHead from "../../components/blog/BlogHead.astro";
import Byline from "../../components/blog/Byline.astro";
import PostCard from "../../components/blog/PostCard.astro";
import { render } from "astro:content";
import {
  BLOG_NAME,
  SITE,
  categoryTone,
  formatDate,
  getPublishedPosts,
  readingMinutes,
  relatedPosts,
} from "../../lib/blog";
import "katex/dist/katex.min.css";
import "../../styles/blog.css";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, related: relatedPosts(post, posts) },
  }));
}

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, ogImage, author, authorRole, authorAvatar, category } = post.data;

const minutes = readingMinutes(post);
const url = `${SITE}/blog/${post.slug}`;
const image = ogImage || `${SITE}/og-image.png`;
const published = date.toISOString();
const toc = headings.filter((heading) => heading.depth === 2);
const installUrl = "https://github.com/apps/striff-app/installations/new";

// Plain intent links: no share widgets, no third-party script, nothing loads until a reader clicks.
const shareLinks = [
  {
    label: "X",
    href: `https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`,
    icon: "x",
  },
  {
    label: "LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`,
    icon: "linkedin",
  },
  {
    label: "Hacker News",
    href: `https://news.ycombinator.com/submitlink?u=${encodeURIComponent(url)}&t=${encodeURIComponent(title)}`,
    icon: "hn",
  },
];

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: published,
  author: { "@type": "Person", name: author, jobTitle: authorRole },
  publisher: {
    "@type": "Organization",
    name: "Striff",
    url: SITE,
    logo: { "@type": "ImageObject", url: `${SITE}/icon-192.png` },
  },
  mainEntityOfPage: url,
  image,
  articleSection: category,
  timeRequired: `PT${minutes}M`,
}).replace(/</g, "\\u003c");
---

<BaseLayout title={`${title} · ${BLOG_NAME}`} description={description} canonical={url} ogImage={image} ogType="article">
  <Fragment slot="head">
    <BlogHead />
    <meta name="author" content={author} />
    <meta property="article:published_time" content={published} />
    <meta property="article:author" content={author} />
    <meta property="article:section" content={category} />
    <meta name="twitter:label1" content="Written by" />
    <meta name="twitter:data1" content={author} />
    <meta name="twitter:label2" content="Reading time" />
    <meta name="twitter:data2" content={`${minutes} min read`} />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </Fragment>

  <main class="sb sb-post">
    <div class="sb-progress" aria-hidden="true"></div>

    <article>
      <header class="sb-hero">
        <div class="sb-shell">
          <div class="sb-frame">
            <div class="sb-hero-main">
              <p class="sb-kicker">
                <a class="sb-kicker-home" href="/blog">{BLOG_NAME}</a>
                <span class="sb-kicker-sep" aria-hidden="true">/</span>
                <span class={`sb-cat sb-tone-${categoryTone(category)}`}>{category}</span>
              </p>
              <h1 class="sb-title">{title}</h1>
              <p class="sb-dek">{description}</p>
              <div class="sb-hero-meta">
                <Byline name={author} role={authorRole} avatar={authorAvatar} />
                <p class="sb-meta">
                  <time datetime={published}>{formatDate(date)}</time>
                  <span>{minutes} min read</span>
                </p>
              </div>
            </div>
          </div>
        </div>
      </header>

      <div class="sb-shell">
        <div class="sb-frame sb-body">
          <div class="sb-main">
            {toc.length > 1 && (
              <details class="sb-toc-mobile">
                <summary>
                  On this page
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                </summary>
                <ol>
                  {toc.map((heading) => (
                    <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
                  ))}
                </ol>
              </details>
            )}
            <div class="sb-prose" data-sb-prose>
              <Content />
            </div>
          </div>
          {toc.length > 1 && (
            <aside class="sb-rail" aria-label="Table of contents">
              <nav class="sb-toc">
                <p class="sb-label">On this page</p>
                <ol>
                  {toc.map((heading) => (
                    <li><a href={`#${heading.slug}`} data-toc-link={heading.slug}>{heading.text}</a></li>
                  ))}
                </ol>
              </nav>
            </aside>
          )}
        </div>
      </div>

      <footer class="sb-shell">
        <div class="sb-frame">
          <div class="sb-frame-main">
            <div class="sb-afterword">
              <div class="sb-endmark" aria-hidden="true"><span></span><span></span><span></span></div>
              <div class="sb-signoff">
                <div>
                  <p class="sb-label">Written by</p>
                  <Byline name={author} role={authorRole} avatar={authorAvatar} size="lg" />
                </div>
                <div>
                  <p class="sb-label" id="sb-share-label">Share this article</p>
                  <div class="sb-share-row" role="group" aria-labelledby="sb-share-label">
                    <button type="button" class="sb-share-btn sb-share-copy" data-sb-copy data-url={url}>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>
                      <span data-sb-copy-label>Copy link</span>
                    </button>
                    {shareLinks.map((link) => (
                      <a class="sb-share-btn sb-share-btn--icon" href={link.href} target="_blank" rel="noopener noreferrer" title={`Share on ${link.label}`}>
                        {link.icon === "x" && (
                          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
                        )}
                        {link.icon === "linkedin" && (
                          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
                        )}
                        {link.icon === "hn" && (
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8.5 7.5 12 13v4M15.5 7.5 12 13" /></svg>
                        )}
                        <span class="sr-only">Share on {link.label} (opens in a new tab)</span>
                      </a>
                    ))}
                  </div>
                  <p class="sr-only" aria-live="polite" data-sb-copy-status></p>
                </div>
              </div>
            </div>

            <section class="sb-cta" aria-labelledby="sb-cta-title">
              <div>
                <p class="sb-label">The Striff GitHub App</p>
                <h2 id="sb-cta-title" class="sb-cta-title">Your documented architecture, checked on every pull request.</h2>
              </div>
              <div class="sb-cta-actions">
                <a class="sb-btn sb-btn--primary" href={installUrl} target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" /></svg>
                  Install the GitHub App
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
                <a class="sb-btn sb-btn--quiet" href="/pricing">See pricing</a>
              </div>
            </section>
          </div>
        </div>
      </footer>
    </article>

    {related.length > 0 && (
      <div class="sb-shell">
        <section class="sb-related" aria-labelledby="sb-related-title">
          <div class="sb-section-head">
            <h2 id="sb-related-title" class="sb-label">Keep reading</h2>
            <a class="sb-section-link" href="/blog">All articles</a>
          </div>
          <div class="sb-grid sb-grid--3">
            {related.map((relatedPost) => <PostCard post={relatedPost} />)}
          </div>
        </section>
      </div>
    )}
  </main>

  <script is:inline>
    (function () {
      // Section anchors: a hover link on every heading, for copying a link to one section.
      var prose = document.querySelector("[data-sb-prose]");
      if (prose) {
        prose.querySelectorAll("h2[id], h3[id]").forEach(function (heading) {
          var anchor = document.createElement("a");
          anchor.className = "sb-anchor";
          anchor.href = "#" + heading.id;
          anchor.tabIndex = -1;
          anchor.setAttribute("aria-hidden", "true");
          anchor.textContent = "#";
          heading.appendChild(anchor);
        });
      }

      // Table of contents: the active section is the last heading above the upper third of the screen.
      var links = Array.prototype.slice.call(document.querySelectorAll("[data-toc-link]"));
      var targets = links.map(function (link) {
        return document.getElementById(link.getAttribute("data-toc-link"));
      });
      if (links.length) {
        var current = -2;
        var queued = false;
        var update = function () {
          queued = false;
          var line = window.innerHeight * 0.3;
          var active = -1;
          for (var i = 0; i < targets.length; i++) {
            if (targets[i] && targets[i].getBoundingClientRect().top <= line) active = i;
          }
          if (active === current) return;
          current = active;
          links.forEach(function (link, i) {
            var on = i === active;
            link.classList.toggle("is-active", on);
            if (on) link.setAttribute("aria-current", "location");
            else link.removeAttribute("aria-current");
          });
        };
        window.addEventListener("scroll", function () {
          if (queued) return;
          queued = true;
          requestAnimationFrame(update);
        }, { passive: true });
        window.addEventListener("resize", update);
        update();
      }

      // The phone table of contents closes once a section is chosen.
      var mobileToc = document.querySelector(".sb-toc-mobile");
      if (mobileToc) {
        mobileToc.addEventListener("click", function (event) {
          if (event.target.closest("a")) mobileToc.open = false;
        });
      }

      // Copy link, with a fallback for browsers without the async clipboard.
      var copy = document.querySelector("[data-sb-copy]");
      if (copy) {
        var label = copy.querySelector("[data-sb-copy-label]");
        var status = document.querySelector("[data-sb-copy-status]");
        var timer;
        var copied = function () {
          copy.classList.add("is-copied");
          label.textContent = "Link copied";
          if (status) status.textContent = "Link copied to the clipboard.";
          clearTimeout(timer);
          timer = setTimeout(function () {
            copy.classList.remove("is-copied");
            label.textContent = "Copy link";
            if (status) status.textContent = "";
          }, 2200);
        };
        var fallback = function (text) {
          var field = document.createElement("textarea");
          field.value = text;
          field.setAttribute("readonly", "");
          field.style.position = "fixed";
          field.style.opacity = "0";
          document.body.appendChild(field);
          field.select();
          try {
            if (document.execCommand("copy")) copied();
          } catch (error) {}
          document.body.removeChild(field);
        };
        copy.addEventListener("click", function () {
          var text = copy.getAttribute("data-url");
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(copied, function () { fallback(text); });
          } else {
            fallback(text);
          }
        });
      }
    })();
  </script>
</BaseLayout>
