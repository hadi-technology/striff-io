---
import BaseLayout from "../layouts/BaseLayout.astro";

const apiBaseUrl = "https://api.striff.io";
---
<BaseLayout
  title="GitHub App Installed | Striff"
  description="Complete setup for your Striff GitHub App installation."
  canonical="https://striff.io/installed"
>
  <main class="bg-slate-50 text-slate-900">
    <section class="mx-auto max-w-4xl px-6 py-16 md:py-24">
      <div class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm md:p-12">
        <p class="inline-flex rounded-full border border-green-200 bg-green-50 px-4 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-green-800">
          Installation complete
        </p>
        <h1 class="mt-5 text-4xl font-black tracking-tight text-slate-950 md:text-5xl">
          Striff is connected to your GitHub.
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
          Striff will now post structural review check-runs on your pull requests.
          Public repositories are free. Private repositories require an active subscription.
        </p>

        <div id="plan-prompt" class="mt-8 rounded-2xl border border-amber-200 bg-amber-50 p-6">
          <h2 class="text-lg font-bold text-slate-900">Planning to use private repositories?</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Select a plan below to enable Striff on private pull requests. Your tier then adjusts
            automatically to how many repos are actually active each billing period: upgrades and
            downgrades apply to your next invoice, and a quiet month drops to $0.
          </p>
        </div>

        <div class="mt-8 grid gap-4 sm:grid-cols-3">
          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <p class="text-sm font-semibold uppercase tracking-[0.24em] text-slate-500">Free</p>
            <p class="mt-1 text-2xl font-black text-slate-950">$0</p>
            <p class="mt-1 text-xs text-slate-500">Public repos only</p>
            <p class="mt-3 text-sm text-slate-600">Already active. No further steps needed.</p>
          </div>
          <div class="rounded-2xl border-2 border-blue-500 bg-blue-50 p-5">
            <p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-700">Starter</p>
            <p class="mt-1 text-2xl font-black text-slate-950">$29<span class="text-sm font-medium text-slate-500">/mo</span></p>
            <p class="mt-1 text-xs text-slate-500">Up to 5 active repos</p>
            <button data-plan="starter" class="plan-checkout-btn mt-3 inline-flex w-full justify-center rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 transition-colors">
              Subscribe
            </button>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <p class="text-sm font-semibold uppercase tracking-[0.24em] text-slate-500">Team</p>
            <p class="mt-1 text-2xl font-black text-slate-950">$59<span class="text-sm font-medium text-slate-500">/mo</span></p>
            <p class="mt-1 text-xs text-slate-500">Up to 15 active repos</p>
            <button data-plan="team" class="plan-checkout-btn mt-3 inline-flex w-full justify-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800 transition-colors">
              Subscribe
            </button>
          </div>
        </div>

        <p id="checkout-status" class="mt-4 text-sm text-slate-500"></p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/dashboard" class="btn-primary inline-flex justify-center">Go to your dashboard</a>
          <a href="/pricing" class="btn-secondary inline-flex justify-center text-sm">See all plans &rarr;</a>
        </div>
      </div>
    </section>
  </main>

  <script is:inline define:vars={{ apiBaseUrl }}>
    const params = new URLSearchParams(window.location.search);
    const installationId = params.get("installation_id");
    const setupAction = params.get("setup_action");
    const statusEl = document.getElementById("checkout-status");

    if (setupAction === "update") {
      document.querySelector("h1").textContent = "Installation updated.";
      const prompt = document.getElementById("plan-prompt");
      if (prompt) prompt.remove();
    }

    if (setupAction === "request") {
      // An org member requested the install; nothing exists until an org owner approves,
      // so success chrome and plan buttons would all be wrong here.
      document.querySelector(".inline-flex").textContent = "Request sent";
      document.querySelector("h1").textContent = "Installation requested. Waiting for owner approval.";
      document.querySelector("h1").nextElementSibling.textContent =
        "An organization owner needs to approve the Striff installation. Once they do, come back to your dashboard. No further action is needed from you right now.";
      const prompt = document.getElementById("plan-prompt");
      if (prompt) prompt.remove();
      document.querySelectorAll(".plan-checkout-btn").forEach((btn) => {
        btn.closest(".rounded-2xl")?.remove();
      });
    } else if (!installationId) {
      statusEl.textContent = "No installation ID detected. If you came from GitHub, the ID should be in the URL.";
    }

    document.querySelectorAll(".plan-checkout-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (!installationId) {
          statusEl.textContent = "Missing installation ID. Please reinstall the GitHub App.";
          return;
        }
        const plan = btn.dataset.plan;
        // Redirect to dashboard which handles Stripe checkout
        window.location.href = `/dashboard?installation_id=${encodeURIComponent(installationId)}&plan=${plan}`;
      });
    });
  </script>
</BaseLayout>
