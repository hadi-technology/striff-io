---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Subscription Started | Striff"
  description="Your Striff subscription checkout finished."
  canonical="https://striff.io/billing/success"
>
  <main class="bg-slate-50 text-slate-900">
    <section class="mx-auto max-w-4xl px-6 py-16 md:py-24">
      <div class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm md:p-12">
        <p class="inline-flex rounded-full border border-blue-200 bg-blue-50 px-4 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-blue-800">
          Checkout complete
        </p>
        <h1 class="mt-5 text-4xl font-black tracking-tight text-slate-950 md:text-5xl">
          Payment complete. Welcome aboard.
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
          Your subscription is being activated. This usually takes a few seconds while Stripe
          confirms the payment. Private-repo analysis switches on automatically; your dashboard's
          Billing tab will show the plan once activation completes.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/dashboard" class="btn-primary inline-flex justify-center">Go to your dashboard</a>
          <a href="/" class="btn-secondary inline-flex justify-center">Back to homepage</a>
        </div>
      </div>
    </section>
  </main>

</BaseLayout>
