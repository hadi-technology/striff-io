---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Account | Striff"
  description="Manage your Striff subscription and billing."
  canonical="https://striff.io/account"
>
  <main class="bg-slate-50 text-slate-900">
    <section class="mx-auto max-w-4xl px-6 py-16 md:py-24">
      <div class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm md:p-12">
        <p class="inline-flex rounded-full border border-slate-300 bg-slate-50 px-4 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-slate-700">
          Account
        </p>
        <h1 class="mt-5 text-4xl font-black tracking-tight text-slate-950 md:text-5xl">
          Manage your subscription.
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
          Open the Stripe billing portal to update your payment method, download invoices, or cancel your plan.
        </p>

        <div class="mt-8 grid gap-4 md:grid-cols-[1fr_auto]">
          <input
            id="installation-id"
            type="text"
            placeholder="GitHub installation ID"
            class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none ring-0"
          />
          <button id="portal-button" class="btn-primary justify-center" type="button">Open billing portal</button>
        </div>
        <p id="portal-status" class="mt-4 text-sm text-slate-500"></p>

        <div class="mt-10 space-y-6">
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 text-sm leading-7 text-slate-600">
            <p class="font-semibold text-slate-900">What you can do in the billing portal</p>
            <ul class="mt-3 space-y-2">
              <li>Update your payment method or billing email</li>
              <li>Download past invoices</li>
              <li>Cancel your subscription at the end of the current billing period</li>
              <li>Switch between Starter, Team, and Scale plans</li>
            </ul>
          </div>

          <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-sm leading-7 text-slate-700">
            <p class="font-semibold text-slate-900">How to stop being charged</p>
            <ul class="mt-3 space-y-2">
              <li><strong>Remove private repos</strong> from the Striff GitHub App in your GitHub settings. Your tier auto-adjusts based on the number of connected private repositories.</li>
              <li><strong>Cancel your subscription</strong> in the billing portal above. You'll keep access until the end of the current billing period.</li>
              <li><strong>Uninstall the Striff GitHub App</strong> entirely from <a href="https://github.com/settings/installations" class="font-medium text-blue-600 hover:underline" target="_blank" rel="noopener noreferrer">GitHub Settings &rarr; Integrations</a>. This disconnects all repos and stops billing.</li>
            </ul>
            <p class="mt-3 text-slate-500">Public repositories are always free and do not affect billing.</p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 text-sm leading-7 text-slate-600">
            <p class="font-semibold text-slate-900">Where is my installation ID?</p>
            <p class="mt-2">You can find it in the URL when you manage your GitHub App installations:
              <a href="https://github.com/settings/installations" class="font-medium text-blue-600 hover:underline" target="_blank" rel="noopener noreferrer">github.com/settings/installations</a>.
              Click "Configure" on the Striff app and look for <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">installation_id=</code> in the URL.
            </p>
            <p class="mt-2">The billing portal link is also included in every Striff check-run comment on your pull requests.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    const button = document.getElementById("portal-button");
    const input = document.getElementById("installation-id");
    const status = document.getElementById("portal-status");
    const params = new URLSearchParams(window.location.search);
    const presetId = params.get("installation_id");
    if (input && presetId) input.value = presetId;

    button?.addEventListener("click", async () => {
      if (!input || !status) return;
      const installationId = input.value.trim();
      if (!installationId) {
        status.textContent = "Enter an installation ID first.";
        return;
      }
      status.textContent = "Opening billing portal...";
      try {
        const response = await fetch(`https://api.striff.io/api/v1/billing/portal?installation_id=${encodeURIComponent(installationId)}`, {
          method: "POST"
        });
        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }
        const payload = await response.json();
        if (payload.portalUrl) {
          window.location.href = payload.portalUrl;
          return;
        }
        throw new Error("Missing portalUrl");
      } catch (error) {
        status.textContent = "Could not create a billing portal session. Verify the installation ID and try again.";
      }
    });
  </script>
</BaseLayout>
