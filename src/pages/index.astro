  <script is:inline define:vars={{ rotatingPhrases }}>
    const toggle = document.querySelector("[data-menu-toggle]");
    const menu = document.querySelector("[data-mobile-menu]");

    if (toggle && menu) {
      toggle.addEventListener("click", () => {
        const isHidden = menu.classList.toggle("hidden");
        toggle.setAttribute("aria-expanded", String(!isHidden));
      });

      menu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          menu.classList.add("hidden");
          toggle.setAttribute("aria-expanded", "false");
        });
      });
    }

	const initPanzoom = (container) => {
	      const content = container.querySelector("[data-panzoom-content]");
	      if (!content) return;

	      const clamp = (value, min, max) => Math.min(Math.max(value, min), max);
	      const parseNumber = (value, fallback) => {
	        const num = Number.parseFloat(value);
	        return Number.isFinite(num) ? num : fallback;
	      };

		      const minScale = parseNumber(container.dataset.panzoomMinScale, 0.6);
		      const maxScale = parseNumber(container.dataset.panzoomMaxScale, 3.2);
		      const initialScale = clamp(
		        parseNumber(container.dataset.panzoomInitialScale, 1),
		        minScale,
		        maxScale
		      );
          const explicitInitialX = parseNumber(container.dataset.panzoomInitialX, NaN);
          const explicitInitialY = parseNumber(container.dataset.panzoomInitialY, NaN);
		      const rect = container.getBoundingClientRect();
		      const contentW = content.offsetWidth;
		      const contentH = content.offsetHeight;

	      const centerOnX = parseNumber(container.dataset.panzoomCenterOnX, NaN);
	      const centerOnY = parseNumber(container.dataset.panzoomCenterOnY, NaN);

		      let initialX, initialY;
          if (Number.isFinite(explicitInitialX) && Number.isFinite(explicitInitialY)) {
            initialX = explicitInitialX;
            initialY = explicitInitialY;
          } else if (Number.isFinite(centerOnX) && Number.isFinite(centerOnY)) {
		        // Center on specific SVG coordinates (SVG viewBox is 1899x1742)
		        const natW = 1899;
		        const natH = 1742;
	        const scX = contentW / natW;
	        const scY = contentH / natH;
	        const px = centerOnX * scX;
	        const py = centerOnY * scY;
	        initialX = rect.width / 2 - px * initialScale;
	        initialY = rect.height / 2 - py * initialScale;
	      } else {
	        initialX = (rect.width - contentW * initialScale) / 2;
	        initialY = (rect.height - contentH * initialScale) / 2;
	      }

		      const state = {
		        scale: initialScale,
		        x: initialX,
		        y: initialY
		      };
		      let isPanning = false;
          let activePointerId = null;
		      let start = { x: 0, y: 0 };
		      let animFrame = null;

	      const apply = () => {
	        content.style.transform = `translate(${state.x}px, ${state.y}px) scale(${state.scale})`;
	      };

	      const animateTo = (targetState, duration) => {
	        if (animFrame) cancelAnimationFrame(animFrame);
	        const from = { x: state.x, y: state.y, scale: state.scale };
	        const startTime = performance.now();
	        const step = (now) => {
	          const t = Math.min((now - startTime) / duration, 1);
	          const ease = 1 - Math.pow(1 - t, 3);
	          state.x = from.x + (targetState.x - from.x) * ease;
	          state.y = from.y + (targetState.y - from.y) * ease;
	          state.scale = from.scale + (targetState.scale - from.scale) * ease;
	          apply();
	          if (t < 1) animFrame = requestAnimationFrame(step);
	        };
	        animFrame = requestAnimationFrame(step);
	      };

	      container._pzAnimateTo = animateTo;
	      container._pzState = state;

	      apply();

	      container.addEventListener(
	        "wheel",
	        (event) => {
	          event.preventDefault();
	          if (animFrame) { cancelAnimationFrame(animFrame); animFrame = null; }
	          const rect = container.getBoundingClientRect();
	          const cursorX = event.clientX - rect.left;
	          const cursorY = event.clientY - rect.top;
	          const scaleDelta = Math.exp(-event.deltaY * 0.0012);
	          const nextScale = clamp(state.scale * scaleDelta, minScale, maxScale);

	          const dx = (cursorX - state.x) / state.scale;
	          const dy = (cursorY - state.y) / state.scale;

	          state.scale = nextScale;
	          state.x = cursorX - dx * state.scale;
	          state.y = cursorY - dy * state.scale;

	          apply();
	        },
        { passive: false }
      );

	      container.addEventListener("pointerdown", (event) => {
          if (!event.isPrimary) return;
          event.preventDefault();
	        if (animFrame) { cancelAnimationFrame(animFrame); animFrame = null; }
          activePointerId = event.pointerId;
	        isPanning = true;
	        container.classList.add("panzoom-grabbing");
	        start = { x: event.clientX - state.x, y: event.clientY - state.y };
	        if (container.setPointerCapture) {
            container.setPointerCapture(event.pointerId);
          }
	      });

	      container.addEventListener("pointermove", (event) => {
	        if (!isPanning || event.pointerId !== activePointerId) return;
	        state.x = event.clientX - start.x;
	        state.y = event.clientY - start.y;
	        apply();
	      });

	      const endPan = (event) => {
          if (event && activePointerId !== null && event.pointerId !== activePointerId) return;
	        isPanning = false;
          activePointerId = null;
	        container.classList.remove("panzoom-grabbing");
	      };

	      container.addEventListener("pointerup", (event) => {
          if (container.releasePointerCapture && activePointerId === event.pointerId) {
            container.releasePointerCapture(event.pointerId);
          }
          endPan(event);
        });
	      container.addEventListener("pointercancel", (event) => {
          if (container.releasePointerCapture && activePointerId === event.pointerId) {
            container.releasePointerCapture(event.pointerId);
          }
          endPan(event);
        });
          container.addEventListener("lostpointercapture", endPan);
		    };

	    document.querySelectorAll("[data-panzoom]").forEach(initPanzoom);

      document.querySelectorAll("[data-how-accordion-item]").forEach((item) => {
        const trigger = item.querySelector("[data-how-accordion-trigger]");
        if (!trigger) return;

        trigger.addEventListener("click", () => {
          if (item.hasAttribute("data-how-accordion-featured")) {
            const shouldOpen = !item.classList.contains("is-open");
            item.classList.toggle("is-open", shouldOpen);

            const featuredTrigger = item.querySelector("[data-how-accordion-trigger]");
            const featuredPanel = item.querySelector("[data-how-accordion-panel]");

            if (featuredTrigger) {
              featuredTrigger.setAttribute("aria-expanded", shouldOpen ? "true" : "false");
              featuredTrigger.classList.toggle("how-tab-card-active", shouldOpen);
            }

            if (featuredPanel) {
              featuredPanel.setAttribute("aria-hidden", shouldOpen ? "false" : "true");
            }
            return;
          }

          const root = item.closest("[data-how-accordion-root]");
          if (!root) return;
          const shouldOpen = !item.classList.contains("is-open");

          root.querySelectorAll("[data-how-accordion-item]:not([data-how-accordion-featured])").forEach((otherItem) => {
            const isActive = otherItem === item && shouldOpen;
            otherItem.classList.toggle("is-open", isActive);

            const otherTrigger = otherItem.querySelector("[data-how-accordion-trigger]");
            const otherPanel = otherItem.querySelector("[data-how-accordion-panel]");

            if (otherTrigger) {
              otherTrigger.setAttribute("aria-expanded", isActive ? "true" : "false");
              otherTrigger.classList.toggle("how-tab-card-active", isActive);
            }

            if (otherPanel) {
              otherPanel.setAttribute("aria-hidden", isActive ? "false" : "true");
            }
          });
        });
      });

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const initTypeRotator = (rotator) => {
      if (!rotatingPhrases.length) return;
      const textEl = rotator.querySelector(".type-rotator-text") || rotator;

      let phraseIndex = 0;
      let charIndex = rotatingPhrases[0].length;
      let isDeleting = true;
      let timeoutId = null;

      const typeSpeed = 45;
      const deleteSpeed = 30;
      const holdTime = 2600;
      const pauseAfterDelete = 250;

      const stop = () => {
        if (!timeoutId) return;
        clearTimeout(timeoutId);
        timeoutId = null;
      };

      const tick = () => {
        if (document.hidden || prefersReducedMotion.matches) {
          stop();
          return;
        }

        const phrase = rotatingPhrases[phraseIndex];
        if (!isDeleting) {
          charIndex += 1;
          textEl.textContent = phrase.slice(0, charIndex);
          if (charIndex >= phrase.length) {
            isDeleting = true;
            timeoutId = setTimeout(tick, holdTime);
            return;
          }
          timeoutId = setTimeout(tick, typeSpeed);
          return;
        }

        charIndex -= 1;
        textEl.textContent = phrase.slice(0, charIndex);
        if (charIndex <= 0) {
          isDeleting = false;
          phraseIndex = (phraseIndex + 1) % rotatingPhrases.length;
          timeoutId = setTimeout(tick, pauseAfterDelete);
          return;
        }
        timeoutId = setTimeout(tick, deleteSpeed);
      };

      const start = (delay = 0) => {
        if (timeoutId) return;
        if (prefersReducedMotion.matches) {
          textEl.textContent = rotatingPhrases[0];
          return;
        }
        timeoutId = setTimeout(tick, delay);
      };

      const handleVisibility = () => {
        if (document.hidden) {
          stop();
        } else {
          start();
        }
      };

      document.addEventListener("visibilitychange", handleVisibility);

      const handleMotionChange = (event) => {
        if (event.matches) {
          stop();
          textEl.textContent = rotatingPhrases[0];
          phraseIndex = 0;
          charIndex = rotatingPhrases[0].length;
          isDeleting = true;
        } else {
          start(holdTime);
        }
      };

      if (prefersReducedMotion.addEventListener) {
        prefersReducedMotion.addEventListener("change", handleMotionChange);
      } else if (prefersReducedMotion.addListener) {
        prefersReducedMotion.addListener(handleMotionChange);
      }

      textEl.textContent = rotatingPhrases[0];
      start(holdTime);
    };

    document.querySelectorAll("[data-type-rotator]").forEach(initTypeRotator);

    document.querySelectorAll("video[data-playback-rate]").forEach(function (v) {
      v.playbackRate = parseFloat(v.dataset.playbackRate);

      // Pause on load, play when scrolled into view
      v.pause();
      v.removeAttribute("autoplay");
      var observed = false;
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting && !observed) {
            observed = true;
            v.play().catch(function () {});
          }
        });
      }, { threshold: 0.25 });
      observer.observe(v);
    });

    // PostHog event tracking
    (function () {
      // Track all primary CTA button clicks (Get the Plugin / Download)
      document.querySelectorAll("a.btn-primary").forEach(function (el) {
        el.addEventListener("click", function () {
          window.posthog?.capture("get_plugin_clicked", {
            label: el.textContent.trim(),
            href: el.getAttribute("href"),
          });
        });
      });

      // Track secondary CTA "Learn how it works"
      document.querySelectorAll("a.btn-secondary").forEach(function (el) {
        el.addEventListener("click", function () {
          window.posthog?.capture("learn_how_clicked");
        });
      });

      // Track GitHub and Feedback link clicks
      document.querySelectorAll('a[href*="github.com"]').forEach(function (el) {
        el.addEventListener("click", function () {
          if (el.href.includes("discussions")) {
            window.posthog?.capture("feedback_link_clicked");
          } else {
            window.posthog?.capture("github_link_clicked", { href: el.href });
          }
        });
      });

      // Track first hero diagram pan/zoom interaction per page load
      var heroPanned = false;
      document.querySelectorAll("[data-panzoom]").forEach(function (container) {
        container.addEventListener("pointerdown", function () {
          if (!heroPanned) {
            heroPanned = true;
            window.posthog?.capture("hero_diagram_panned");
          }
        });
      });
    })();

    // Waitlist form
    document.querySelectorAll("[data-waitlist-form]").forEach(function(form) {
      form.addEventListener("submit", function(e) {
        e.preventDefault();
        var formData = new FormData(form);
        fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams(formData).toString()
        }).then(function() {
          form.innerHTML = '<p class="waitlist-success">You\'re on the list. We\'ll let you know when it launches.</p>';
          window.posthog?.capture("waitlist_signup", { form: form.getAttribute("name") });
        }).catch(function() {
          form.submit();
        });
      });
    });
  </script>
