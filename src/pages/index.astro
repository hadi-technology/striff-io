          </div>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    // Hero findings -> check report. Each finding in the hero overlay is the summary of a
    // line further down in the report, so clicking one scrolls to that exact line and flashes
    // it. The report is a section rather than a hidden tab, so nothing here reveals content:
    // it only saves the reader the hunt.
    (function () {
      var reportSection = document.getElementById("report");
      if (!reportSection) return;

      var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var flashTimer = null;

      function goTo(el, flash) {
        if (!el) return;
        el.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "center" });
        if (!flash) return;

        clearTimeout(flashTimer);
        document.querySelectorAll(".is-report-flash").forEach(function (n) {
          n.classList.remove("is-report-flash");
        });
        // Restart the animation even when the same row is clicked twice.
        void el.offsetWidth;
        el.classList.add("is-report-flash");
        flashTimer = setTimeout(function () { el.classList.remove("is-report-flash"); }, 2600);
      }

      document.querySelectorAll("[data-report-jump]").forEach(function (btn) {
        btn.addEventListener("click", function () { goTo(reportSection, false); });
      });

      document.querySelectorAll("[data-report-target]").forEach(function (row) {
        var anchor = document.querySelector(
          '[data-report-anchor="' + row.getAttribute("data-report-target") + '"]'
        );
        if (!anchor) return;

        row.addEventListener("click", function () { goTo(anchor, true); });
        row.addEventListener("keydown", function (e) {
          if (e.key !== "Enter" && e.key !== " ") return;
          e.preventDefault();
          goTo(anchor, true);
        });
      });
    })();

    (function () {
      var tabs = document.querySelectorAll("[data-tab-index]");
      var slides = document.querySelectorAll("[data-slide-index]");
      var dots = document.querySelectorAll("[data-dot-index]");
      var prevBtn = document.querySelector('[data-nav="prev"]');
      var nextBtn = document.querySelector('[data-nav="next"]');
      var current = 0;
      var total = tabs.length;

      function showSlide(index) {
        current = ((index % total) + total) % total;

        tabs.forEach(function (t, i) { t.classList.toggle("is-active", i === current); });
        slides.forEach(function (s, i) { s.classList.toggle("is-active", i === current); });
        dots.forEach(function (d, i) { d.classList.toggle("is-active", i === current); });

        var activeSlide = slides[current];
        if (activeSlide) {
          var stage = activeSlide.querySelector("[data-panzoom]");
          if (stage && stage._panzoomReset) {
            stage._panzoomReset();
          }
        }
      }

      tabs.forEach(function (tab, i) {
        tab.addEventListener("click", function () { showSlide(i); });
      });

      dots.forEach(function (dot, i) {
        dot.addEventListener("click", function () { showSlide(i); });
      });

      if (prevBtn) prevBtn.addEventListener("click", function () { showSlide(current - 1); });
      if (nextBtn) nextBtn.addEventListener("click", function () { showSlide(current + 1); });
    })();

    // Pan and zoom lives in src/scripts/panzoom.js, shared with the examples page.

    // Findings overlay toggle
    (function () {
      var overlay = document.querySelector("[data-findings-overlay]");
      var toggle = document.querySelector("[data-findings-toggle]");
      if (!overlay || !toggle) return;

      // Stop panzoom from swallowing clicks on the overlay
      ["pointerdown", "pointerup", "click", "wheel"].forEach(function (evt) {
        overlay.addEventListener(evt, function (e) { e.stopPropagation(); });
      });

      toggle.addEventListener("click", function (e) {
        e.preventDefault();
        e.stopPropagation();
        overlay.classList.toggle("is-open");
      });
    })();

    // Team showcase: autoplaying rotating tabs
    (function () {
      var root = document.querySelector("[data-teams-showcase]");
      if (!root) return;

      var tabs = root.querySelectorAll("[data-teams-tab-index]");
      var panels = root.querySelectorAll("[data-teams-panel-index]");
      var total = tabs.length;
      var current = 0;
      var timer = null;
      var startedAt = 0;
      var AUTOPLAY_MS = 6000;
      var reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      // Set once the reader shows intent (taps, or picks a tab). Rotation never comes back:
      // having the panel change under you mid-paragraph is worse than a static section.
      var stopped = false;

      function currentFill() {
        var fill = tabs[current] && tabs[current].querySelector(".teams-tab-progress-fill");
        return fill || null;
      }

      function restartTimer(duration) {
        if (timer) clearTimeout(timer);
        timer = setTimeout(function () { activate(current + 1); }, duration);
      }

      function activate(index) {
        current = ((index % total) + total) % total;

        tabs.forEach(function (tab, i) {
          var isActive = i === current;
          tab.classList.toggle("is-active", isActive);
          tab.setAttribute("aria-selected", isActive ? "true" : "false");
          var fill = tab.querySelector(".teams-tab-progress-fill");
          if (fill) {
            fill.style.animation = "none";
            fill.style.animationPlayState = "";
            void fill.offsetWidth;
            fill.style.animation = "";
          }
        });

        panels.forEach(function (panel, i) { panel.classList.toggle("is-active", i === current); });

        // The docs tile is pannable but too small to carry its own reset button, so returning
        // to a tab returns its diagram to the framing that makes the point.
        var activePanel = panels[current];
        if (activePanel) {
          activePanel.querySelectorAll("[data-panzoom]").forEach(function (stage) {
            if (stage._panzoomReset) stage._panzoomReset();
          });
        }

        startedAt = Date.now();
        if (!reduceMotion && !stopped) restartTimer(AUTOPLAY_MS);
      }

      tabs.forEach(function (tab, i) {
        tab.addEventListener("click", function () { activate(i); });
      });

      function pause() {
        if (timer) { clearTimeout(timer); timer = null; }
        var fill = currentFill();
        if (fill) fill.style.animationPlayState = "paused";
      }

      function resume() {
        if (reduceMotion || stopped) return;
        var fill = currentFill();
        if (fill) fill.style.animationPlayState = "running";
        var elapsed = Date.now() - startedAt;
        restartTimer(Math.max(AUTOPLAY_MS - elapsed, 400));
      }

      root.addEventListener("mouseenter", pause);
      root.addEventListener("mouseleave", resume);

      // Hovering was the only way to pause; keyboard and touch users had no way at all, and
      // this section carries the densest copy on the page.
      function stopAutoplay() {
        stopped = true;
        if (timer) { clearTimeout(timer); timer = null; }
        var fill = currentFill();
        if (fill) fill.style.animation = "none";
      }

      root.addEventListener("focusin", pause);
      root.addEventListener("focusout", resume);
      root.addEventListener("touchstart", stopAutoplay, { passive: true });
      tabs.forEach(function (tab) { tab.addEventListener("click", stopAutoplay); });

      // Rotating on a tab nobody is looking at just means returning to a different panel.
      document.addEventListener("visibilitychange", function () {
        if (document.hidden) pause(); else resume();
      });

      activate(0);
    })();

    // Scales a fixed-natural-width mock down to fit its tile, preserving proportions
    // (used by both the live metrics dashboard preview and the GitHub checks mock).
    function setupPreviewScale(frameAttr, scaleAttr) {
      var frames = document.querySelectorAll("[" + frameAttr + "]");
      if (!frames.length) return;

      function rescale(frame) {
        var scaleEl = frame.querySelector("[" + scaleAttr + "]");
        // offsetWidth reads the untransformed layout box, so it stays a stable basis
        // to rescale from no matter what scale is currently applied.
        var naturalWidth = scaleEl && scaleEl.offsetWidth;
        if (!naturalWidth) return;
        var factor = frame.clientWidth / naturalWidth;
        scaleEl.style.transform = "scale(" + factor + ")";
      }

      var resizeObserver =
        typeof ResizeObserver !== "undefined"
          ? new ResizeObserver(function (entries) {
              entries.forEach(function (entry) { rescale(entry.target); });
            })
          : null;

      frames.forEach(function (frame) {
        if (resizeObserver) {
          resizeObserver.observe(frame);
        } else {
          window.addEventListener("resize", function () { rescale(frame); });
        }
        rescale(frame);
      });
    }

    setupPreviewScale("data-metrics-preview", "data-metrics-preview-scale");
    setupPreviewScale("data-github-preview", "data-github-preview-scale");
  </script>

  <script>
    import { initPanzoom } from "../scripts/panzoom.js";

    initPanzoom({ minScaleFloor: 1.2 });
  </script>
</BaseLayout>
