---
import BaseLayout from "../layouts/BaseLayout.astro";

const pluginReleased = false;
const discussionsUrl = "https://github.com/hadi-technology/striff-lib/discussions";
const feedbackUrl = "https://github.com/hadi-technology/striff-io/discussions/1";

const navLinks = [
  { label: "Why Striffs", href: "#why" },
  { label: "How to Read", href: "#how" },
  { label: "Extension", href: "#plugin" }
];

const rotatingPhrases = [
  "guide AI-generated code.",
  "catch architectural drift.",
  "understand system-level impact.",
  "reason about structural changes."
];

const callouts = [
  {
    number: "①",
    title: "Change coloring",
    description:
      "Green = added, red = removed, amber = modified, gray = unchanged context.",
    top: "12%",
    left: "14%"
  },
  {
    number: "②",
    title: "UML-based class structure",
    description:
      "Classes and relationships are rendered in a familiar UML-style layout.",
    top: "18%",
    left: "63%"
  },
  {
    number: "③",
    title: "Object-oriented metrics",
    description:
      "Selected metrics highlight growth, coupling, and architectural hot spots.",
    top: "48%",
    left: "22%"
  },
  {
    number: "④",
    title: "Class comments",
    description:
      "Docstrings and comments surface intent and design rationale.",
    top: "52%",
    left: "58%"
  },
  {
    number: "⑤",
    title: "Summarized components",
    description:
      "Unchanged or irrelevant parts collapse to preserve readability.",
    top: "76%",
    left: "78%"
  }
];

const carouselItems = callouts.map((callout) => ({
  ...callout,
  src: "/diagram-placeholder.svg"
}));

const languageSupport = [
  {
    name: "Java",
    logoUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/java/java-original.svg",
    status: "Supported",
    statusClass: "status-supported"
  },
  {
    name: "C#",
    logoUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/csharp/csharp-original.svg",
    status: "Coming soon",
    statusClass: "status-soon"
  },
  {
    name: "Go",
    logoUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/go/go-original.svg",
    status: "Coming soon",
    statusClass: "status-soon"
  },
  {
    name: "Python",
    logoUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg",
    status: "Coming soon",
    statusClass: "status-soon"
  },
  {
    name: "TypeScript",
    logoUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg",
    status: "Coming soon",
    statusClass: "status-soon"
  }
];

const benefits = [
  {
    title: "Detect architectural drift early",
    body: "Spot widening dependencies and design drift before they become refactors."
  },
  {
    title: "Guide agent-generated code",
    body: "Give automation guardrails by reviewing structure, not just syntax."
  },
  {
    title: "Review intent, not just output",
    body: "Understand what a change means for the system, not just the file diff."
  },
  {
    title: "Make large PRs navigable",
    body: "Compress context so reviewers can focus on high-impact areas first."
  }
];

const pluginButtons = pluginReleased
  ? [
      { label: "Chrome Web Store", href: "#" },
      { label: "Firefox Add-ons", href: "#" },
      { label: "Edge Add-ons", href: "#" }
    ]
  : [
      { label: "Join waitlist", href: "#" },
      { label: "View demo", href: "#" },
      { label: "GitHub", href: "#" }
    ];
---

<BaseLayout
  title="Striff - Structural diffs for modern code reviews"
  description="Striffs visualize how pull requests change your system's architecture so you can guide AI-generated code."
>
  <header class="sticky top-0 z-50 border-b border-white/40 bg-white/70 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="#" class="flex items-center gap-3 text-lg font-semibold tracking-tight text-ink">
        <img src="/download.svg" alt="Striff logo" class="h-9 w-9" />
        <span>Striff</span>
      </a>
      <nav class="hidden items-center gap-2 md:flex">
        {navLinks.map((link) => (
          <a class="nav-link" href={link.href}>
            {link.label}
          </a>
        ))}
        <a class="nav-link" href={feedbackUrl}>Feedback</a>
        <a class="flex items-center gap-2 hover:text-ink" href="https://github.com/hadi-technology/striff-lib" aria-label="Striff GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.51 2.87 8.33 6.84 9.68.5.1.68-.22.68-.48 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1.01.07 1.54 1.08 1.54 1.08.9 1.58 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.15-4.56-5.11 0-1.13.39-2.05 1.03-2.78-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.06.8-.23 1.66-.34 2.52-.35.86.01 1.72.12 2.52.35 1.9-1.34 2.74-1.06 2.74-1.06.55 1.41.2 2.45.1 2.71.64.73 1.03 1.65 1.03 2.78 0 3.97-2.34 4.85-4.57 5.1.36.32.68.96.68 1.94 0 1.4-.01 2.53-.01 2.88 0 .27.18.59.69.48A10.03 10.03 0 0 0 22 12.26C22 6.58 17.52 2 12 2z" />
          </svg>
          GitHub
        </a>
      </nav>
      <div class="hidden md:flex">
        <a class="btn-primary" href="#plugin">Get the Plugin</a>
      </div>
      <button
        class="md:hidden"
        data-menu-toggle
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Open menu</span>
        <div class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white/80 text-ink shadow-sm">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="4" y1="7" x2="20" y2="7" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="17" x2="20" y2="17" />
          </svg>
        </div>
      </button>
    </div>
    <div
      id="mobile-menu"
      data-mobile-menu
      class="hidden border-t border-white/50 bg-white/80 px-6 py-4 md:hidden"
    >
      <div class="flex flex-col gap-2">
        {navLinks.map((link) => (
          <a class="nav-link" href={link.href}>
            {link.label}
          </a>
        ))}
        <a class="nav-link" href={feedbackUrl}>Feedback</a>
        <a class="flex items-center gap-2 hover:text-ink" href="https://github.com/hadi-technology/striff-lib">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.51 2.87 8.33 6.84 9.68.5.1.68-.22.68-.48 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1.01.07 1.54 1.08 1.54 1.08.9 1.58 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.15-4.56-5.11 0-1.13.39-2.05 1.03-2.78-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.06.8-.23 1.66-.34 2.52-.35.86.01 1.72.12 2.52.35 1.9-1.34 2.74-1.06 2.74-1.06.55 1.41.2 2.45.1 2.71.64.73 1.03 1.65 1.03 2.78 0 3.97-2.34 4.85-4.57 5.1.36.32.68.96.68 1.94 0 1.4-.01 2.53-.01 2.88 0 .27.18.59.69.48A10.03 10.03 0 0 0 22 12.26C22 6.58 17.52 2 12 2z" />
          </svg>
          GitHub
        </a>
        <a class="btn-primary w-full" href="#plugin">Get the Plugin</a>
      </div>
    </div>
  </header>

  <main>
    <section class="relative overflow-hidden pb-16 pt-20">
      <div class="mx-auto flex max-w-4xl flex-col items-center gap-10 px-6 text-center">
        <div class="space-y-8 animate-fade-up">
          <div class="space-y-6">
            <h1 class="text-balance">Structural diffs for modern code reviews</h1>
            <p class="subheadline-line">
              Striffs™ visualize how pull requests change your system's architecture so you can:{" "}
              <span class="type-rotator" data-type-rotator aria-live="polite">
                <span class="type-rotator-text">{rotatingPhrases[0]}</span>
                <span class="type-caret" aria-hidden="true"></span>
