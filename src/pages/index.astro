          </p>
        </div>
        <div class="mt-10">
          <div class="surface space-y-4" data-carousel>
            <div class="grid gap-6 md:grid-cols-[0.35fr_0.65fr] md:items-start">
              <div class="flex flex-col gap-3">
                {carouselItems.map((item, index) => (
                  <div>
                    <button
                      class="tab-btn w-full text-left"
                      type="button"
                      data-carousel-tab
                      data-index={index}
                      aria-selected={index === 0 ? "true" : "false"}
                      aria-expanded={index === 0 ? "true" : "false"}
                      aria-controls={`accordion-${index}`}
