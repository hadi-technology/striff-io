  <script is:inline>
    // Findings overlay toggle
    (function () {
      var overlay = document.querySelector("[data-findings-overlay]");
      var toggle = document.querySelector("[data-findings-toggle]");
      if (!overlay || !toggle) return;

      // Keep clicks on the overlay from reaching the diagram beneath it
      ["pointerdown", "pointerup", "click", "wheel"].forEach(function (evt) {
        overlay.addEventListener(evt, function (e) { e.stopPropagation(); });
      });

      toggle.addEventListener("click", function (e) {
        e.preventDefault();
        e.stopPropagation();
        overlay.classList.toggle("is-open");
      });
    })();


    // Scales a fixed-natural-width mock down to fit its tile, preserving proportions
    // (used by both the live metrics dashboard preview and the GitHub checks mock).
    function setupPreviewScale(frameAttr, scaleAttr) {
      var frames = document.querySelectorAll("[" + frameAttr + "]");
      if (!frames.length) return;

      function rescale(frame) {
        var scaleEl = frame.querySelector("[" + scaleAttr + "]");
        // offsetWidth reads the untransformed layout box, so it stays a stable basis
        // to rescale from no matter what scale is currently applied.
        var naturalWidth = scaleEl && scaleEl.offsetWidth;
        if (!naturalWidth) return;
        var factor = frame.clientWidth / naturalWidth;
        scaleEl.style.transform = "scale(" + factor + ")";
      }

      var resizeObserver =
        typeof ResizeObserver !== "undefined"
          ? new ResizeObserver(function (entries) {
              entries.forEach(function (entry) { rescale(entry.target); });
            })
          : null;

      frames.forEach(function (frame) {
        if (resizeObserver) {
          resizeObserver.observe(frame);
        } else {
          window.addEventListener("resize", function () { rescale(frame); });
        }
        rescale(frame);
      });

      // Recharts' ResponsiveContainer measures itself on mount. Inside this frame it
      // mounts before the scale factor is applied and latches a zero width, so every
      // sparkline rendered as an empty box. Nudging it once the frame is sized makes
      // it re-measure. rAF twice: once past layout, once past React's commit.
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          frames.forEach(rescale);
          window.dispatchEvent(new Event("resize"));
        });
      });
    }

    setupPreviewScale("data-metrics-preview", "data-metrics-preview-scale");
    setupPreviewScale("data-github-preview", "data-github-preview-scale");
  </script>

  <script>
    // Headline rotator: the kind of document changes, the promise does not. The slot
    // eases to each word's own width, so the comma always sits against the word, and
    // the second line is on its own row so nothing below it reflows. Still under
    // reduced motion, paused while the tab is hidden.
    (function () {
      var rot = document.querySelector("[data-h1-rot]");
      if (!rot) return;
      var words = Array.prototype.slice.call(rot.querySelectorAll(".h1-rot-word"));
      var i = 0;
      function fit() { rot.style.width = words[i].offsetWidth + "px"; }
      fit();
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
      window.addEventListener("resize", fit);
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      rot.classList.add("is-live");
      function tick() {
        if (document.hidden) return;
        var out = words[i];
        i = (i + 1) % words.length;
        var next = words[i];
        out.classList.remove("is-on");
        out.classList.add("is-out");
        next.classList.add("is-on");
        fit();
        setTimeout(function () {
          out.style.transition = "none";
          out.classList.remove("is-out");
          void out.offsetWidth;
          out.style.transition = "";
        }, 650);
      }
      setInterval(tick, 2800);
    })();
  </script>

