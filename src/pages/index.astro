---
import BaseLayout from "../layouts/BaseLayout.astro";
import { readFileSync } from "node:fs";

const pluginReleased = true;
const feedbackUrl = "https://github.com/hadi-technology/striff-io/discussions/1";
const primaryCtaLabel = "Install Plugin";
const primaryCtaHref = "#plugin";
const secondaryCtaLabel = "See product proof";
const secondaryCtaHref = "#proof";
const heroDiagramSvgRaw = readFileSync(
  new URL("../../public/hero-diagram-main.svg", import.meta.url),
  "utf8"
);

const cropHeroSvg = (viewBox: string, className: string) =>
  heroDiagramSvgRaw
    .replace(/viewBox="[^"]*"/, `viewBox="${viewBox}"`)
    .replace(/width="[^"]*"/, "")
    .replace(/height="[^"]*"/, "")
    .replace('preserveAspectRatio="none"', 'preserveAspectRatio="xMidYMid meet"')
    .replace(/style="[^"]*"/, "")
    .replace("<svg ", `<svg class="${className}" `);

const whyStriffSvg = cropHeroSvg("1138 1148 468 438", "why-visual-svg");
const howChangeComponentSvg = cropHeroSvg("1148 1148 458 156", "how-change-component-svg");
const howReviewNoteSvg = cropHeroSvg("1324 10 390 282", "how-tab-snippet-svg");
const howMetricsSnippetSvg = cropHeroSvg("126 436 310 94", "how-tab-snippet-svg");
const howUmlDiagramSvg = cropHeroSvg("1088 1088 560 520", "how-tab-snippet-svg");

const howChangeSnippetSvg = `
  <div class="how-change-live-wrap">
    ${howChangeComponentSvg}
    <div class="how-change-legend" aria-hidden="true">
      <span class="how-change-chip how-change-chip-add">Added()</span>
      <span class="how-change-chip how-change-chip-modify">Modified()</span>
      <span class="how-change-chip how-change-chip-remove">Removed()</span>
    </div>
  </div>
`;

const howUmlSnippetSvg = `
  <div class="how-uml-live-wrap">
    ${howUmlDiagramSvg}
  </div>
`;

const navLinks = [
  { label: "Why Striff", href: "#proof" },
  { label: "Product", href: "#features" },
  { label: "How It Works", href: "#how" },
  { label: pluginReleased ? "Install" : "Extension", href: "#plugin" }
];

const rotatingPhrases = [
  "review AI-generated PRs with confidence",
  "catch coupling drift before merge",
  "see blast radius before reading files",
  "focus on the riskiest system changes first"
];

const proofPills = [
  {
    label: "GitHub pull request review",
    tone: "#2563eb",
    glyph: "PR"
  },
  {
    label: "Java, Python, TypeScript",
    tone: "#0f766e",
    glyph: "{ }"
  },
  {
    label: "Inline architecture notes",
    tone: "#b45309",
    glyph: "AI"
  },
  {
    label: "Metrics and risk signals",
    tone: "#7c3aed",
    glyph: "Σ"
  }
];

const comparisonRows = [
  {
    left: "File diff shows what lines changed.",
    right: "Striff shows what moved structurally: dependencies, boundaries, and blast radius."
  },
  {
    left: "Conventional review starts deep in files.",
    right: "Striff starts at the system layer and lets reviewers drill in only where risk appears."
  },
  {
    left: "AI-generated PRs can look tidy line-by-line.",
    right: "Striff exposes architecture drift, coupling shifts, and the parts of the system most likely to need attention."
  }
];

const productPaths = [
  {
    eyebrow: "For Reviewers",
    title: "Chrome extension for pull request review",
    body: "Open structural diffs and review notes inside GitHub instead of switching between tabs, screenshots, and comments.",
    cta: "Install Plugin",
    href: "#plugin"
  },
  {
    eyebrow: "For Teams",
    title: "GitHub Check for architecture-aware merge gates",
    body: "Post architectural review signals directly into PR checks and move toward policy-based enforcement on risky changes.",
    cta: "See roadmap",
    href: "#github-check"
  },
  {
    eyebrow: "For Developers",
    title: "API and OSS library for deeper integration",
    body: "Generate Striffs from GitHub pull requests, uploaded code snapshots, or your own Java-based automation.",
    cta: "View GitHub",
    href: "https://github.com/hadi-technology/striff-lib"
  }
];

const heroLegend = [
  { label: "Added", swatchClass: "hero-legend-swatch-add" },
  { label: "Modified", swatchClass: "hero-legend-swatch-modify" },
  { label: "Removed", swatchClass: "hero-legend-swatch-remove" }
];

const callouts = [
  {
    icon: "palette",
    title: "Change coloring",
    accentBg: "#dff7e4",
    accentText: "#166534",
    snippet: howChangeSnippetSvg,
    description:
      "Each change type gets a distinct color so you can instantly scan for what matters.",
    details: [
      "Added marks new structure entering the system.",
      "Modified shows existing components whose internals changed.",
      "Removed makes deleted paths visible before they disappear into file diffs."
    ]
  },
  {
    icon: "network",
    title: "UML-based class structure",
    accentBg: "#e4f1f7",
    accentText: "#0f4c81",
    snippet: howUmlSnippetSvg,
    description:
      "Classes are boxes with compartments for name, attributes, and methods. Arrows show relationships like inheritance, implementation, and dependencies.",
    details: [
      "Solid arrows represent direct references or associations.",
      "Dashed arrows indicate looser dependencies or implementation edges.",
      "The structure view makes boundary changes readable at a glance."
    ]
  },
  {
    icon: "chart",
    title: "Object-oriented metrics",
    accentBg: "#fef3d6",
    accentText: "#92400e",
    snippet: howMetricsSnippetSvg,
    description:
      "Each class displays key metrics that help assess complexity, coupling, and change impact.",
    metrics: [
      { label: "NOC", icon: "branch", tone: "green", desc: "Number of children. Wider inheritance means more downstream impact." },
      { label: "DIT", icon: "depth", tone: "blue", desc: "Depth of inheritance. Deep trees are harder to reason about safely." },
      { label: "WMC", icon: "weight", tone: "gold", desc: "Weighted method complexity. Higher values usually mean heavier review effort." },
      { label: "AC", icon: "inbound", tone: "rose", desc: "Afferent coupling. More incoming dependencies mean the class is harder to change safely." },
      { label: "EC", icon: "outbound", tone: "slate", desc: "Efferent coupling. More outgoing dependencies suggest broader ripple effects." }
    ]
  },
  {
    icon: "note",
    title: "Review notes",
    accentBg: "#fff1dd",
    accentText: "#9a3412",
    snippet: howReviewNoteSvg,
    description:
      "Striffs can carry architectural review notes directly on the diagram so high-risk changes are visible in context, not buried in a comment thread.",
    details: [
      "Striff narrows review to the most relevant part of the change, then adds architecture-aware signals before generating notes.",
      "Notes are cleaned up, deduplicated, and ranked so reviewers see the highest-value guidance first.",
      "The final comments are rendered directly on the diagram, next to the package or component they refer to."
    ]
  },
];

const carouselItems = callouts.map((callout) => ({
  ...callout
}));
const featuredHowItem = carouselItems[0];
const secondaryHowItems = carouselItems.slice(1);

const languageSupport = [
  {
    name: "Java",
    logoUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/java/java-original.svg",
    status: "Supported",
    statusClass: "status-supported"
  },
  {
    name: "Python",
    logoUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg",
    status: "Supported",
    statusClass: "status-supported"
  },
  {
    name: "TypeScript",
    logoUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg",
    status: "Supported",
    statusClass: "status-supported"
  },
  {
    name: "CSharp",
    logoUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/csharp/csharp-original.svg",
    status: "Coming soon",
    statusClass: "status-soon"
  },
  {
    name: "GoLang",
    logoUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/go/go-original.svg",
    status: "Coming soon",
    statusClass: "status-soon"
  }
];

const heroAudienceCards = [
  {
    eyebrow: "For reviewers",
    icon: "review",
    accentColor: "#2563eb",
    title: "Start with system change, then drill into files only where needed."
  },
  {
    eyebrow: "For AI-heavy teams",
    icon: "agent",
    accentColor: "#16a34a",
    title: "Keep agent-generated code aligned with architecture, not just syntax."
  },
  {
    eyebrow: "For engineering leads",
    icon: "lead",
    accentColor: "#d97706",
    title: "Surface coupling, drift, and risky boundaries before they become cleanup work."
  }
];

const benefits = [
  {
    eyebrow: "Impact First",
    icon: "blast",
    title: "See blast radius before reading files",
    body: "Start with the architectural surface area of the PR, not a pile of changed files with no system context.",
    accent: "rgb(248 113 113)"
  },
  {
    eyebrow: "AI Guardrails",
    icon: "shield",
    title: "Review AI output at the architecture layer",
    body: "Agent-generated changes can pass syntax review while quietly bending boundaries. Striff makes that visible.",
    accent: "rgb(74 222 128)"
  },
  {
    eyebrow: "One Artifact",
    icon: "stack",
    title: "Keep risk and context in one view",
    body: "Metrics, dependency edges, and AI review notes stay on the diagram itself instead of being scattered across comments and tabs.",
    accent: "rgb(96 165 250)"
  },
  {
    eyebrow: "Large PRs",
    icon: "focus",
    title: "Handle large pull requests without drowning",
    body: "When a PR spans dozens of files, Striff helps reviewers focus on the structural changes that deserve attention first.",
    accent: "rgb(250 204 21)"
  }
];

const featureCards = [
  {
    eyebrow: "Diff Lens",
    icon: "structure",
    accent: "linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(14, 165, 233, 0.08))",
    accentColor: "#2563eb",
    title: "Structural diffs instead of file noise",
    body:
      "Review the shape of the change first: new dependencies, moved boundaries, changed classes, and the surrounding impact."
  },
  {
    eyebrow: "Review Engine",
    icon: "spark",
    accent: "linear-gradient(135deg, rgba(245, 158, 11, 0.22), rgba(251, 191, 36, 0.08))",
    accentColor: "#d97706",
    title: "AI review grounded in deterministic signals",
    body:
      "AI review is grounded in architecture-aware signals so comments are tied to real structural risk, not generic code-review advice."
  },
  {
    eyebrow: "Inline Context",
    icon: "note",
    accent: "linear-gradient(135deg, rgba(244, 114, 182, 0.18), rgba(251, 207, 232, 0.08))",
    accentColor: "#db2777",
    title: "Notes attached where the risk lives",
    body:
      "Review comments are rendered into the SVG itself so the architectural issue stays attached to the component or package it affects."
  },
  {
    eyebrow: "Workflow Fit",
    icon: "flow",
    accent: "linear-gradient(135deg, rgba(34, 197, 94, 0.18), rgba(134, 239, 172, 0.08))",
    accentColor: "#16a34a",
    title: "Built for real review flows",
    body:
      "Analyze GitHub pull requests or code snapshots, revisit saved results later, and keep the experience fast enough for active review."
  }
];

const reviewFlow = [
  {
    step: "1",
    eyebrow: "Input",
    icon: "ingest",
    accentColor: "#2563eb",
    title: "Generate the diagram",
    body: "Start from a pull request or two code snapshots and generate a structural view of what changed."
  },
  {
    step: "2",
    eyebrow: "Analysis",
    icon: "radar",
    accentColor: "#d97706",
    title: "Spot impact and risk",
    body: "Scan added, modified, and removed components, then use metrics and relationship changes to find the blast radius."
  },
  {
    step: "3",
    eyebrow: "Decision",
    icon: "action",
    accentColor: "#16a34a",
    title: "Act on the right questions",
    body: "Use inline review notes and heat to focus the conversation on coupling, drift, and boundary risk before merge."
  }
];

const installCtas = [
  { label: "Install Plugin", href: "#plugin", icon: "chrome" },
  { label: "View on GitHub", href: "https://github.com/hadi-technology/striff-browser-extension" }
];
---

<BaseLayout
  title="Striff - Architecture review for AI-era pull requests"
  description="Striff turns pull requests into structural diffs so teams can catch coupling drift, boundary risk, and system-level impact before merge."
  canonical="https://striff.io/"
  ogImage="https://striff.io/hero-diagram-main.svg"
>
  <header class="sticky top-0 z-50 border-b border-white/10 bg-[#24292e] backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="#" class="flex items-center gap-3 text-lg font-bold tracking-tight">
        <img src="/icon.svg" alt="Striff logo" class="h-9 w-9" />
        <span class="hidden sm:inline font-logo">Striff</span>
      </a>

      <style is:global>
        .font-logo {
          font-family: "Rubik", system-ui, sans-serif;
          background: linear-gradient(135deg, #fff5c0 0%, #ffec88 40%, #c9a830 100%);
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          background-clip: text;
          letter-spacing: 0.02em;
        }
      </style>
      <nav class="hidden items-center gap-2 md:flex">
        {navLinks.map((link) => (
          <a class="nav-link" href={link.href}>
            {link.label}
          </a>
        ))}
        <a class="nav-link" href="https://github.com/hadi-technology/striff-lib" target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>
      <div class="hidden md:flex">
        <a class="btn-primary" href={primaryCtaHref}>
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2A10 10 0 0 1 20.66 7H12Z" fill="#EA4335" />
            <path d="M20.66 7A10 10 0 0 1 12 22l4.33-7.5Z" fill="#FBBC04" />
            <path d="M12 22A10 10 0 0 1 3.34 7h8.66Z" fill="#34A853" />
            <circle cx="12" cy="12" r="4.1" fill="#4285F4" stroke="#EAF2FF" stroke-width="1" />
          </svg>
          {primaryCtaLabel}
        </a>
      </div>
      <button
        class="md:hidden"
        data-menu-toggle
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Open menu</span>
        <div class="flex h-10 w-10 items-center justify-center rounded-full border border-white/20 bg-white/10 text-white shadow-sm">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="4" y1="7" x2="20" y2="7" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="17" x2="20" y2="17" />
          </svg>
        </div>
      </button>
    </div>
    <div
      id="mobile-menu"
      data-mobile-menu
      class="hidden border-t border-white/10 bg-[#24292e] px-6 py-4 md:hidden"
    >
      <div class="flex flex-col gap-2">
        {navLinks.map((link) => (
          <a class="nav-link" href={link.href}>
            {link.label}
          </a>
        ))}
        <a class="nav-link" href="https://github.com/hadi-technology/striff-lib" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a class="nav-link flex items-center gap-2" href="https://github.com/hadi-technology/striff-lib">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.51 2.87 8.33 6.84 9.68.5.1.68-.22.68-.48 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1.01.07 1.54 1.08 1.54 1.08.9 1.58 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.15-4.56-5.11 0-1.13.39-2.05 1.03-2.78-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.06.8-.23 1.66-.34 2.52-.35.86.01 1.72.12 2.52.35 1.9-1.34 2.74-1.06 2.74-1.06.55 1.41.2 2.45.1 2.71.64.73 1.03 1.65 1.03 2.78 0 3.97-2.34 4.85-4.57 5.1.36.32.68.96.68 1.94 0 1.4-.01 2.53-.01 2.88 0 .27.18.59.69.48A10.03 10.03 0 0 0 22 12.26C22 6.58 17.52 2 12 2z" />
          </svg>
          GitHub
        </a>
        <a class="btn-primary w-full" href={primaryCtaHref}>{primaryCtaLabel}</a>
      </div>
    </div>
  </header>

  <main>
	    <section id="hero" class="scroll-mt-24 relative overflow-hidden pb-16 pt-20">
	      <!-- Ambient glow effects -->
	      <div class="pointer-events-none absolute inset-0 overflow-hidden">
	        <div class="absolute -top-40 -right-40 h-80 w-80 rounded-full opacity-20 blur-3xl" style="background: radial-gradient(circle, #7ee89d 0%, transparent 70%);"></div>
	        <div class="absolute -bottom-40 -left-40 h-80 w-80 rounded-full opacity-20 blur-3xl" style="background: radial-gradient(circle, #f0808e 0%, transparent 70%);"></div>
	        <div class="absolute top-1/2 -right-20 h-60 w-60 rounded-full opacity-15 blur-3xl" style="background: radial-gradient(circle, #6eaaee 0%, transparent 70%);"></div>
	      </div>

	      <div class="mx-auto flex max-w-5xl flex-col items-center gap-10 px-6 text-center relative z-10">
	        <div class="space-y-8 animate-fade-up">
	          <div class="space-y-6">
            <h1 class="text-balance">Architectural review for pull requests in the age of AI coding.</h1>
            <p class="subheadline-line">
              Striff gives reviewers a system-level view of every pull request so teams can{" "}
              <span class="type-rotator" data-type-rotator aria-live="polite">
                <span class="type-rotator-text">{rotatingPhrases[0]}</span>
                <span class="type-caret" aria-hidden="true"></span>
              </span>
            </p>
          </div>
          <div class="proof-pill-row">
            {proofPills.map((pill) => (
              <span class="proof-pill" style={`--proof-accent:${pill.tone};`}>
                <span class="proof-pill-badge" aria-hidden="true">{pill.glyph}</span>
                <span>{pill.label}</span>
              </span>
            ))}
          </div>
          <div class="flex flex-wrap justify-center gap-4">
            <a class="btn-primary" href={primaryCtaHref}>{primaryCtaLabel}</a>
            <a class="btn-secondary" href={secondaryCtaHref}>{secondaryCtaLabel}</a>
          </div>
	        </div>
	        <div class="w-full">
		          <div
		            class="hero-diagram-frame mx-auto w-full max-w-5xl"
		            data-panzoom
		            data-panzoom-initial-scale="2.3105"
                data-panzoom-initial-x="-612.455"
                data-panzoom-initial-y="-189.536"
		            data-panzoom-min-scale="0.5"
		            data-panzoom-max-scale="5"
		          >
		            <div class="hero-diagram-chrome" aria-hidden="true">
                  <div class="hero-chrome-left">
                    <div class="hero-window-controls">
		                  <span></span><span></span><span></span>
                    </div>
                    <div class="hero-github-context">
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.51 2.87 8.33 6.84 9.68.5.1.68-.22.68-.48 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1.01.07 1.54 1.08 1.54 1.08.9 1.58 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.15-4.56-5.11 0-1.13.39-2.05 1.03-2.78-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.06.8-.23 1.66-.34 2.52-.35.86.01 1.72.12 2.52.35 1.9-1.34 2.74-1.06 2.74-1.06.55 1.41.2 2.45.1 2.71.64.73 1.03 1.65 1.03 2.78 0 3.97-2.34 4.85-4.57 5.1.36.32.68.96.68 1.94 0 1.4-.01 2.53-.01 2.88 0 .27.18.59.69.48A10.03 10.03 0 0 0 22 12.26C22 6.58 17.52 2 12 2z" />
                      </svg>
                      <span class="hero-github-slug">openapitools/openapi-generator</span>
                      <span class="hero-github-pr">PR #19423</span>
                    </div>
                  </div>
	                  <p class="hero-pan-hint">
	                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
	                      <path d="M9 4H4v5M15 4h5v5M9 20H4v-5M15 20h5v-5" />
                      <path d="M12 9v6M9 12h6" />
                    </svg>
                    Scroll to zoom · Drag to pan
                  </p>
		            </div>
			            <div class="hero-diagram-viewport" data-panzoom-content style="transform: translate(-612.455px, -189.536px) scale(2.3105)">
			              <img
		                src="/hero-diagram-main.svg"
		                alt="Striff diagram overview"
		                class="hero-diagram-img"
	                loading="eager"
	                decoding="async"
		                fetchpriority="high"
			                draggable="false"
			              />
			            </div>
			          </div>
				          <div class="mt-5 flex flex-wrap items-center justify-center gap-2 md:mt-6">
			            <span class="hero-legend-label">PR diff legend</span>
			            {heroLegend.map((item) => (
			              <span class="hero-legend-chip">
			                <span class={`hero-legend-swatch ${item.swatchClass}`} aria-hidden="true"></span>
			                {item.label}
			              </span>
			            ))}
                  <span class="hero-strip-separator" aria-hidden="true"></span>
                  <span class="hero-legend-label">Languages</span>
                  {languageSupport.map((lang) => (
                    <span class="lang-chip lang-chip-minimal">
                      <span class="lang-icon" aria-hidden="true">
                        <img
                          class="lang-logo"
                          src={lang.logoUrl}
                          alt={`${lang.name} logo`}
                          loading="lazy"
                        />
                      </span>
                      <span class="lang-inline-name">
                        {lang.name}
                        {lang.status === "Coming soon" && <span class="lang-soon-tag"> soon</span>}
                      </span>
                    </span>
                  ))}
			          </div>
		          <p class="section-subcopy mx-auto mt-5 max-w-3xl text-sm md:text-base">
		            Review the PR the way your system was designed: as moving components, boundaries, dependencies, and risk hotspots instead of isolated files.
		          </p>
	        </div>
        <div class="grid w-full max-w-5xl gap-4 md:grid-cols-3">
          {heroAudienceCards.map((card) => (
            <div class="hero-audience-card" style={`--hero-card-accent:${card.accentColor};`}>
              <div class="hero-audience-card-top">
                <div class="hero-audience-icon" aria-hidden="true">
                  {card.icon === "review" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M5 4.5h14a1.5 1.5 0 0 1 1.5 1.5v8.7a1.5 1.5 0 0 1-1.5 1.5h-8.2L6.4 20.6a.6.6 0 0 1-1-.42v-4H5A1.5 1.5 0 0 1 3.5 14.7V6A1.5 1.5 0 0 1 5 4.5Z" />
                      <path d="M8 9h8M8 12h6" />
                    </svg>
                  )}
                  {card.icon === "agent" && (
