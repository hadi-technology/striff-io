    <!-- ==================== HOW IT IS COMPUTED, AND WHAT COMES OUT ==================== -->
    <!-- The pipeline and the artifact it produces, side by side: the mechanism answers
         where a number came from, the check answers what you actually get. -->
    <section id="pipeline" class="pipeline-section scroll-mt-24 pb-20 pt-20">
      <div class="mx-auto max-w-[90rem] px-6">
        <!-- The five steps run across, because they are a sequence and a reader follows a
             sequence left to right. Underneath, the two things the sequence produces sit side by
             side: what a reviewer is handed, and what one rule of it actually compiled to. -->
        <div class="compute-stack">
          <div data-reveal>
            <div class="compute-intro compute-intro-wide">
              <h2 class="text-balance">Every verdict is computed, not generated.</h2>
              <p class="section-subcopy mt-4">
                Striff is neurosymbolic: a language model reads your docs and proposes rules, and a program decides what is true. A parser turns your code before and after the pull request into a formal model of its types, members and references, resolved the way a compiler does, and each rule becomes a formula in first-order logic. <strong>Every verdict is formal model checking: does the model satisfy the formula?</strong> <strong>The language model is asked exactly one question, at the start, and it is asked in English</strong> &mdash; the grounding, the verdict and the sentence you read are all computed, and nothing is needed beyond the documents your repository already has.
              </p>
            </div>
            <p class="compute-label"><span>01</span> How a documented rule becomes a verdict</p>
            <ol class="pipeline-flow is-across" style={`--pipe-steps: ${pipeline.length}`}>
              {pipeline.map((step, i) => (
                <li class={`pipe-step pipe-${step.kind}`} data-pipe-step={i + 1}>
                  <span class="pipe-rail" aria-hidden="true"><span class="pipe-dot"></span></span>
                  <div class="pipe-body">
                    <p class="pipe-head">
                      <span class="pipe-num">{String(i + 1).padStart(2, "0")}</span>
                      <span class="pipe-name">{step.name}</span>
                      <span class="pipe-kind">{step.kind === "neural" ? "Language model" : "Deterministic"}</span>
                    </p>
                    <p class="pipe-text">{step.body}</p>
                    {/* What this step produced, appearing as the sequence reaches it. Small,
                        under the paragraph that describes the step, so the description and its
                        result are one thing rather than a card somewhere else on the page. */}
                    <p class={`pipe-out${step.tex ? " is-formula" : ""}`}>
                      {step.tex ? <span><Formula tex={step.tex} /></span> : <span>{step.out}</span>}
                    </p>
                  </div>
                </li>
              ))}
            </ol>
          </div>

          <BlogLink slug="grounded-ai-findings" kicker="How we keep the model honest" class="compute-invite" />
        </div>
      </div>

      <script is:inline>
        // Walks the five steps, revealing what each one produced. Plain DOM: the page is
        // static and this is the only thing on it that needs a clock.
        (function () {
          var flow = document.querySelector(".pipeline-flow.is-across");
          if (!flow) return;
          var steps = Array.prototype.slice.call(flow.querySelectorAll("[data-pipe-step]"));
          var LAST = steps.length;
          var still = window.matchMedia("(prefers-reduced-motion: reduce)");
          var timer = null;
          var at = 0;

          function show(stage) {
            at = stage;
            steps.forEach(function (li, i) {
              li.classList.toggle("is-on", i + 1 === stage);
              li.classList.toggle("is-done", i + 1 <= stage);
            });
          }
          function stop() { if (timer) { window.clearInterval(timer); timer = null; } }
          function run() {
            stop();
            timer = window.setInterval(function () {
              if (at >= LAST) { stop(); return; }
              show(at + 1);
            }, 1400);
          }

          steps.forEach(function (li, i) {
            li.setAttribute("tabindex", "0");
            li.setAttribute("role", "button");
            li.setAttribute("aria-label", "Show what step " + (i + 1) + " produced");
            function pick() { stop(); show(i + 1); }
            li.addEventListener("click", pick);
            li.addEventListener("keydown", function (e) {
              if (e.key === "Enter" || e.key === " ") { e.preventDefault(); pick(); }
            });
          });

          // Asked for less motion, or no observer to tell us when it is on screen: everything at
          // once, which is the content without the sequence.
          if (still.matches || !("IntersectionObserver" in window)) { show(LAST); return; }
          show(0);
          var watch = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              watch.disconnect();
              run();
            });
          }, { threshold: 0.4 });
          watch.observe(flow);
        })();
      </script>
    </section>

