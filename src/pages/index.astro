/**
 * How a documented rule becomes a verdict: the code parsed, the prose read, the rule grounded and
 * compiled, the formula checked at both revisions, and a break confirmed before it is shown.
 *
 * Two of the five stages involve a language model. Read proposes rules from English. Verify
 * (striff-api, doc-verify, since 2026-10-28) re-reads the sentence and the code for an accusing
 * verdict and can only withhold it: shown only when every run confirms it on shared evidence,
 * otherwise counted as couldn't check. Neither decides that a rule holds. There used to be a stage, "Narrate", which said a model
 * ranked and explained the results. It does not: the rules are ordered by CheckRunFormatter and
 * the English reading of a rule is composed from the rule's own body by ArchRuleRenderer, both of
 * them programs. The stage was describing the review notes, which are a different part of the
 * product, and putting them here made the model look like the last word on a verdict it never
 * touches.
 */
const pipeline = [
  {
    kind: "symbolic",
    name: "Parse",
    body: "Both revisions of the code become one structural model \u2014 types, members, references, packages \u2014 resolved the way a compiler resolves them, never matched as text. Everything after this point is about the model, not about the source.",
    tex: String.raw`\mathcal{M} = \langle\, T, M, R, P \,\rangle \quad |T| = 1{,}284 \quad |R| = 8{,}902`
  },
  {
    kind: "neural",
    name: "Read",
    body: "Your documents go to a language model, which proposes candidate rules from prose. It is the step most likely to be wrong, which is what the next step is for.",
    out: "\u201cNever import from legacy/ in new code\u201d \u00b7 AGENTS.md:18"
  },
  {
    kind: "symbolic",
    name: "Ground and compile",
    body: "Every name a proposed rule uses must resolve in the model. One that names a class your code does not contain is dropped rather than guessed at. What survives is compiled into a formula of first-order logic over the model \u2014 the point past which no prose is left to interpret.",
    tex: String.raw`\varphi \coloneqq \neg\exists\, c, d.\; \mathrm{in}(c, \mathtt{checkout}) \wedge \mathrm{in}(d, \mathtt{legacy}) \wedge \mathrm{refs}(c, d)`
  },
  {
    kind: "symbolic",
    name: "Evaluate",
    body: "The formula is model-checked at both revisions. Which of the two satisfy it is the whole verdict: satisfied before and not after is a rule this change broke; unsatisfied at both was already broken and is not blamed on the change. The sentence you read on the check is composed from the formula, so it cannot drift from what was actually checked.",
    tex: String.raw`\mathcal{M}_{\mathrm{before}} \models \varphi \qquad \mathcal{M}_{\mathrm{after}} \nvDash \varphi`
  },
  {
    kind: "neural",
    name: "Verify",
    body: "A rule the formula says is broken is not shown yet. An agent re-reads the sentence and the code, twice and independently, and the break reaches you only if both readings confirm it on the same evidence. This step can hold an accusation back; it can never make one, and it never decides that a rule holds.",
    out: "Broken \u00b7 confirmed 2 of 2 \u2192 shown"
  },
];


/**
 * The check section's sample: an illustrative example, not a real run, and labelled as one. It is
 * the same invented pull request as the hero card (acme/checkout-service #418, feat/csv-export):
 * the change adds checkout.export.CsvExporter, which imports legacy.pricing.PriceCalculator and so
 * breaks the AGENTS.md rule the hero leads with. Each rule names the diagram elements it is about
 * (`marks`), so hovering a row lights its part of the diagram and the broken path is drawn in red.
 */
const sampleCheck = {
  repo: "acme/checkout-service",
  pr: 418,
  branch: "feat/csv-export",
};
const sampleRules = [
  {
    n: 1,
    status: "broken",
    badge: "Broken by this PR",
    rule: "Nothing in `checkout` depends on `legacy`",
    doc: "AGENTS.md#L18",
    quote: "Never import from legacy/ in new code; use the equivalents in core/.",
    breaks: "checkout.export.CsvExporter → legacy.pricing.PriceCalculator (added in this pull request)",
  },
  {
    n: 2,
    status: "holds",
    badge: "Holds",
    rule: "`CheckoutController` depends on `CheckoutService`",
    doc: "ARCHITECTURE.md#L31",
    quote: "CheckoutController hands every request to CheckoutService and holds no logic of its own.",
  },
  {
    n: 3,
    status: "holds",
    badge: "Holds",
    rule: "`CheckoutService` depends on `OrderRepository`",
    doc: "ARCHITECTURE.md#L36",
    quote: "CheckoutService reads and writes orders through OrderRepository only.",
  },
  {
    n: 4,
    status: "holds",
    badge: "Holds",
    rule: "Only `billing` depends on `com.stripe`",
    doc: "docs/adr/0007-payments.md#L12",
