            <h2 class="text-balance text-white">Architecture review for every pull request.</h2>
            <p class="section-subcopy mx-auto mt-4 text-slate-300">
              Striff works alongside your existing review tools. Install free for public repos and it runs on your next PR.
            </p>
            <div class="mt-8 flex flex-wrap justify-center gap-4">
              <a class="btn-primary" href={extensionUrl} target="_blank" rel="noopener noreferrer">Install free in 30 seconds</a>
              <a class="btn-secondary" href={examplesUrl}>See real examples</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      var tabs = document.querySelectorAll("[data-tab-index]");
      var slides = document.querySelectorAll("[data-slide-index]");
      var dots = document.querySelectorAll("[data-dot-index]");
      var prevBtn = document.querySelector('[data-nav="prev"]');
      var nextBtn = document.querySelector('[data-nav="next"]');
      var current = 0;
      var total = tabs.length;

      function showSlide(index) {
        current = ((index % total) + total) % total;

        tabs.forEach(function (t, i) { t.classList.toggle("is-active", i === current); });
        slides.forEach(function (s, i) { s.classList.toggle("is-active", i === current); });
        dots.forEach(function (d, i) { d.classList.toggle("is-active", i === current); });

        var activeSlide = slides[current];
        if (activeSlide) {
          var stage = activeSlide.querySelector("[data-panzoom]");
          if (stage && stage._panzoomReset) {
            stage._panzoomReset();
          }
        }
      }

      tabs.forEach(function (tab, i) {
        tab.addEventListener("click", function () { showSlide(i); });
      });

      dots.forEach(function (dot, i) {
        dot.addEventListener("click", function () { showSlide(i); });
      });

      if (prevBtn) prevBtn.addEventListener("click", function () { showSlide(current - 1); });
      if (nextBtn) nextBtn.addEventListener("click", function () { showSlide(current + 1); });
    })();

    (function () {
      function clamp(value, min, max) {
        return Math.min(max, Math.max(min, value));
      }

      document.querySelectorAll("[data-panzoom]").forEach(function (stage) {
        var id = stage.getAttribute("data-panzoom");
        var media = stage.querySelector(".github-diff-graphic");
        var reset = document.querySelector('[data-panzoom-reset="' + id + '"]');
        if (!media) return;

        var hint = stage.querySelector("[data-panzoom-hint]");
        var hintHidden = false;

        function hideHint() {
          if (hint && !hintHidden) {
            hintHidden = true;
            hint.classList.add("is-hidden");
          }
        }

        var scale = 1;
        var x = 0;
        var y = 0;
        var startX = 0;
        var startY = 0;
        var dragging = false;

        function paint() {
          media.style.transform = "translate(" + x + "px, " + y + "px) scale(" + scale + ")";
        }

        function numberAttr(name, fallback) {
          var value = parseFloat(stage.getAttribute(name) || "");
          return Number.isFinite(value) ? value : fallback;
        }

        function resetView() {
          var mobile = window.innerWidth < 768;
          scale = numberAttr(mobile ? "data-mobile-scale" : "data-initial-scale", mobile ? 1.2 : 1.6);
          x = numberAttr(mobile ? "data-mobile-x" : "data-initial-x", mobile ? -40 : -120);
          y = numberAttr(mobile ? "data-mobile-y" : "data-initial-y", mobile ? -30 : -80);
          paint();
        }

        stage.addEventListener("wheel", function (event) {
          event.preventDefault();
          hideHint();
          var next = clamp(scale + (event.deltaY < 0 ? 0.12 : -0.12), 0.3, 5);
          scale = next;
          paint();
        }, { passive: false });

        stage.addEventListener("pointerdown", function (event) {
          hideHint();
          dragging = true;
          startX = event.clientX - x;
          startY = event.clientY - y;
          stage.setPointerCapture(event.pointerId);
          stage.classList.add("is-dragging");
        });

        stage.addEventListener("pointermove", function (event) {
          if (!dragging) return;
          x = event.clientX - startX;
          y = event.clientY - startY;
          paint();
        });

        function stopDragging() {
          dragging = false;
          stage.classList.remove("is-dragging");
        }

        stage.addEventListener("pointerup", stopDragging);
        stage.addEventListener("pointercancel", stopDragging);
        stage.addEventListener("pointerleave", stopDragging);

        if (reset) {
          reset.addEventListener("click", resetView);
        }

        stage._panzoomReset = resetView;
        resetView();
      });
    })();

    // Findings overlay toggle
    (function () {
      var overlay = document.querySelector("[data-findings-overlay]");
      var toggle = document.querySelector("[data-findings-toggle]");
      if (!overlay || !toggle) return;

      // Stop panzoom from swallowing clicks on the overlay
      ["pointerdown", "pointerup", "click", "wheel"].forEach(function (evt) {
        overlay.addEventListener(evt, function (e) { e.stopPropagation(); });
      });

      toggle.addEventListener("click", function (e) {
        e.preventDefault();
        e.stopPropagation();
        overlay.classList.toggle("is-open");
      });
    })();

    // Team showcase: autoplaying rotating tabs
    (function () {
      var root = document.querySelector("[data-teams-showcase]");
      if (!root) return;

      var tabs = root.querySelectorAll("[data-teams-tab-index]");
      var panels = root.querySelectorAll("[data-teams-panel-index]");
      var total = tabs.length;
      var current = 0;
      var timer = null;
      var startedAt = 0;
      var AUTOPLAY_MS = 6000;
      var reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      function currentFill() {
        var fill = tabs[current] && tabs[current].querySelector(".teams-tab-progress-fill");
        return fill || null;
      }

      function restartTimer(duration) {
        if (timer) clearTimeout(timer);
        timer = setTimeout(function () { activate(current + 1); }, duration);
      }

      function activate(index) {
        current = ((index % total) + total) % total;

        tabs.forEach(function (tab, i) {
          var isActive = i === current;
          tab.classList.toggle("is-active", isActive);
          tab.setAttribute("aria-selected", isActive ? "true" : "false");
          var fill = tab.querySelector(".teams-tab-progress-fill");
          if (fill) {
            fill.style.animation = "none";
            fill.style.animationPlayState = "";
            void fill.offsetWidth;
            fill.style.animation = "";
          }
        });

        panels.forEach(function (panel, i) { panel.classList.toggle("is-active", i === current); });

        startedAt = Date.now();
        if (!reduceMotion) restartTimer(AUTOPLAY_MS);
      }

      tabs.forEach(function (tab, i) {
        tab.addEventListener("click", function () { activate(i); });
      });

      root.addEventListener("mouseenter", function () {
        if (timer) { clearTimeout(timer); timer = null; }
        var fill = currentFill();
        if (fill) fill.style.animationPlayState = "paused";
      });

      root.addEventListener("mouseleave", function () {
        if (reduceMotion) return;
        var fill = currentFill();
        if (fill) fill.style.animationPlayState = "running";
        var elapsed = Date.now() - startedAt;
        restartTimer(Math.max(AUTOPLAY_MS - elapsed, 400));
      });

      activate(0);
    })();

    // Scales a fixed-natural-width mock down to fit its tile, preserving proportions
    // (used by both the live metrics dashboard preview and the GitHub checks mock).
    function setupPreviewScale(frameAttr, scaleAttr) {
      var frames = document.querySelectorAll("[" + frameAttr + "]");
      if (!frames.length) return;

      function rescale(frame) {
        var scaleEl = frame.querySelector("[" + scaleAttr + "]");
        // offsetWidth reads the untransformed layout box, so it stays a stable basis
        // to rescale from no matter what scale is currently applied.
        var naturalWidth = scaleEl && scaleEl.offsetWidth;
        if (!naturalWidth) return;
        var factor = frame.clientWidth / naturalWidth;
        scaleEl.style.transform = "scale(" + factor + ")";
      }

      var resizeObserver =
        typeof ResizeObserver !== "undefined"
          ? new ResizeObserver(function (entries) {
              entries.forEach(function (entry) { rescale(entry.target); });
            })
          : null;

      frames.forEach(function (frame) {
        if (resizeObserver) {
          resizeObserver.observe(frame);
        } else {
          window.addEventListener("resize", function () { rescale(frame); });
        }
        rescale(frame);
      });
    }

    setupPreviewScale("data-metrics-preview", "data-metrics-preview-scale");
    setupPreviewScale("data-github-preview", "data-github-preview-scale");
  </script>
</BaseLayout>
