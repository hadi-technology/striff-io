---
import BaseLayout from "../layouts/BaseLayout.astro";
import InlineCodeText from "../components/InlineCodeText.astro";
import { exampleReviews } from "../data/exampleReviews";
import MetricsTab from "../components/MetricsTab";
import { orgMetricsPreviewData } from "../data/orgMetricsPreview";

// ---- Problem-section visualization: the GitHub firehose ----
// A git graph of branches continuously merging into main (cool colors), beside a
// live activity feed of issues opened and PRs opened / pushed / merged. Both
// scroll seamlessly: the block is rendered twice and translated by one copy.
type Activity = { type: "issue" | "pr" | "push" | "merge"; text: string; meta: string };
const activityFeed: Activity[] = [
  { type: "pr", text: "opened PR", meta: "#1841" },
  { type: "push", text: "pushed 4 commits", meta: "feat/retry" },
  { type: "merge", text: "merged PR", meta: "#1841" },
  { type: "issue", text: "opened issue", meta: "#302" },
  { type: "pr", text: "opened PR", meta: "#1852" },
  { type: "push", text: "pushed 2 commits", meta: "bulk-import" },
  { type: "merge", text: "merged PR", meta: "#1852" },
  { type: "issue", text: "opened issue", meta: "#318" },
  { type: "pr", text: "opened PR", meta: "#1863" },
  { type: "merge", text: "merged PR", meta: "#1863" },
];

// Literal class names (kept out of interpolation so Tailwind's @layer purge
// doesn't drop the per-type feed styles).
const feedTypeClass = {
  issue: "gs-item-issue",
  pr: "gs-item-pr",
  push: "gs-item-push",
  merge: "gs-item-merge",
} as const;

const extensionUrl = "https://chromewebstore.google.com/detail/striffs-for-github/gcbcjajnjbplgkhnbemlkadgnjnfjoen";
const githubAppUrl = "https://github.com/apps/striff-app/installations/new";
const examplesUrl = "/#examples";

interface TeamPhilosophyItem {
  icon: string;
  color: string;
  title: string;
  body: string;
  image?: string;
  preview?: "metrics" | "docs" | "checks";
  link?: { href: string; label: string };
}

const teamPhilosophy: TeamPhilosophyItem[] = [
  {
    icon: "doc",
    color: "amber",
    title: "Your architecture decisions, actually enforced.",
    body: "Most teams write ADRs and an ARCHITECTURE.md, then watch PRs quietly drift from them anyway. Striff reads those docs and checks every PR against them. When a change contradicts what your team agreed on, it names the file and quotes the sentence. No rules to configure. The documentation is the rulebook.",
    preview: "docs",
    link: { href: "/blog/design-docs-are-enforceable-now", label: "How Striff turns design docs into enforced checks" }
  },
  {
    icon: "chart",
    color: "emerald",
    title: "Know which repos are getting harder to work in.",
    body: "Clean PR rate, high-risk PR rate, and the repos accumulating the most flags, tracked month over month across your team's repos. When you need to argue for time to fix something, you have the trend rather than an anecdote.",
    preview: "metrics"
  },
  {
    icon: "checklist",
    color: "blue",
    title: "A green check your team can actually trust.",
    body: "Striff runs twelve structural checks plus the rules it read out of your own docs on every PR, and reports every one of them, clean or not. A green check tells your team exactly what was looked at, so they stop assuming and start knowing. It stays one Check next to your CI: no comment threads, no bot spam.",
    preview: "checks"
  }
];

const chromeExtensionVideoId = "YR_DYyJwM-k";

const chromeExtensionHighlights = [
  {
    icon: "diagram",
    color: "blue",
    point: "Interactive dependency diagrams on any PR"
  },
  {
    icon: "comment",
    color: "emerald",
    point: "Comment straight from the diagram"
  },
  {
    icon: "sparkle",
    color: "amber",
    point: "AI findings pinned to the graph"
  },
  {
    icon: "bolt",
    color: "rose",
    point: "No backend, and your token stays local"
  }
];

const plans = [
  {
    eyebrow: "Free",
    icon: "globe",
    title: "Public repositories",
    body: "GitHub App checks on every public PR, plus the browser extension for any public PR you visit. Architecture diagrams, risk findings, and AI review notes.",
    price: "$0",
    priceDetail: "forever"
  },
  {
    eyebrow: "Starter",
    icon: "team",
    title: "One team's private repos",
    body: "GitHub App checks on every private PR. Automated architecture review with the full detector suite and risk scoring.",
    price: "$29",
    priceDetail: "/mo · 5 repos"
  },
  {
    eyebrow: "Enterprise",
    icon: "gear",
    title: "Self-hosted & 50+ repos",
    body: "Private deployment, SSO, and audit workflows for organizations that need full control.",
    price: "",
    priceDetail: "Talk to us"
  }
];

---

<BaseLayout
  title="Striff - Architecture-aware pull request review"
  description="Architecture review on every GitHub pull request. Catch structural damage before it merges, so your codebase stays easy to change and your team stays fast as it grows."
  canonical="https://striff.io/"
  ogImage="https://striff.io/og-image.png"
>
  <main>
    <!-- ==================== HERO ==================== -->
    <section class="hero-section relative overflow-hidden pb-12 pt-14">
      <div class="mx-auto max-w-[90rem] px-6">
        <!-- Wider than the old max-w-2xl so the headline gets two lines instead of three; the
             subcopy keeps its own narrower measure via .hero-subcopy. -->
        <div class="hero-copy relative z-10 mx-auto max-w-5xl space-y-6 text-center" data-reveal>
          <h1 class="mx-auto">More code isn't more <span class="font-bold text-blue-600">product</span>.</h1>
          <p class="section-subcopy hero-subcopy mx-auto">
            Your team merges more code every week than anyone can read, and every risky change routes to the one person who can judge it. <strong>Striff is architecture review for every GitHub pull request.</strong> It checks each change against the architecture you documented and reports back as one check, so approving a merge stops being a judgment call only your most senior engineer can make.
          </p>
          <div class="flex flex-wrap justify-center gap-3 pt-1">
            <a class="btn-primary" href={githubAppUrl} target="_blank" rel="noopener noreferrer">
              <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
              </svg>
              Get started
            </a>
            <a class="btn-secondary" href={examplesUrl}>
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="12" cy="18" r="2.5"/><path d="m8 7 3 9M16 7l-3 9M8.5 6h7"/>
              </svg>
              See it in action
            </a>
          </div>
        </div>

        <!-- Styled like a link and coloured like a link, so it is one. It also carries the only
             route to the report section on mobile, where the report thumbnail is hidden. -->
        <a class="hero-what-you-get" href="#report" data-reveal>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M12 19l-5-5M12 19l5-5"/></svg>
          What posts on your pull request: a diagram of what changed, and a report of every check that ran
        </a>

        <div class="relative z-10 mx-auto mt-4 w-full max-w-[90rem]" data-reveal>
          <div class="hero-stage-shell" data-hero-stage>
            <div class="hero-stage-head">
              <div class="hero-stage-context">
                <span class="hero-context-chip">apache/fineract</span>
                <span class="hero-context-chip hero-context-chip-muted">PR #6063</span>
                <span class="hero-context-chip hero-context-chip-muted">Java</span>
                <span class="hero-context-chip hero-context-chip-danger">2 HIGH · 2 MEDIUM</span>
              </div>
              <div class="hero-stage-actions">
                <!-- The stage invites scroll-to-zoom and drag-to-pan, so it needs the same way
                     back that every other diagram on the site has. -->
                <button class="github-diff-reset hero-stage-reset" type="button" data-panzoom-reset="pz-hero">Reset view</button>
                <div class="hero-stage-badge">Striff / architectural-review</div>
              </div>
            </div>

            <div class="hero-diagram-wrap">
              <!-- Framing is constrained on both sides: the report thumbnail floats over the
                   left ~260px and the findings overlay over the right ~416px. The class the
                   findings name has to land in the clear band between them, or the diagram
                   looks like it was cropped at random. Re-tune both axes together. -->
              <div
                class="github-diff-stage example-diff-stage hero-diagram-stage"
                style="--example-stage-height: 40rem; --example-stage-height-mobile: 26rem;"
                data-panzoom="pz-hero"
                data-initial-scale="1.55"
                data-mobile-scale="3.7"
                data-focus-x="0.6122"
                data-focus-y="0.4741"
                data-mobile-focus-y="0.5606"
              >
                <img
                  src="/examples/fineract.svg"
                  alt="Striff structural diff for apache/fineract PR #6063"
                  class="github-diff-graphic github-diff-image"
                  loading="eager"
                  draggable="false"
                />
                <div class="panzoom-hint" data-panzoom-hint>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6M8 11h6"/></svg>
                  Scroll to zoom · Drag to pan
                </div>

                <div class="hero-diagram-tag">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="12" cy="18" r="2.5"/><path d="m8 7 3 9M16 7l-3 9M8.5 6h7"/></svg>
                  Architecture diagram of this PR
                </div>

                <!-- A real miniature of the check report, parked in the corner. A text link asking
                     people to imagine a second artifact does not work; showing it does. -->
                <button class="hero-pip" type="button" data-panzoom-ignore data-report-jump="top" aria-label="Jump to the full check report Striff posts on this pull request">
                  <span class="hero-pip-frame">
                    <span class="hero-pip-doc" aria-hidden="true">
                      <span class="hpd-head">
                        <img src="/icon.svg" alt="" width="13" height="13" />
                        <span class="hpd-head-text">
                          <b>Striff / architectural-review</b>
                          <i>Successful in 26s</i>
                        </span>
                      </span>
                      <span class="hpd-row is-fail"><span class="hpd-dot"></span>Documented rules<em>1 violated</em></span>
                      <span class="hpd-row is-flag"><span class="hpd-dot"></span>Boundary crossings<em>1 flagged</em></span>
                      <span class="hpd-row is-flag"><span class="hpd-dot"></span>Complexity growth<em>1 flagged</em></span>
                      <span class="hpd-row"><span class="hpd-dot"></span>Package cycles<em>clean</em></span>
                      <span class="hpd-row"><span class="hpd-dot"></span>Layer integrity<em>clean</em></span>
                      <span class="hpd-row"><span class="hpd-dot"></span>Encapsulation<em>clean</em></span>
                    </span>
                    <span class="hero-pip-fade" aria-hidden="true"></span>
                  </span>
                  <span class="hero-pip-cap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M7 3h7l5 5v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path d="M14 3v5h5"/><path d="m9 13 1.5 1.5L13 12"/><path d="m9 17.5 1.5 1.5L13 16.5"/></svg>
                    <span class="hero-pip-cap-text">Check report<em>13 checks</em></span>
                    <svg class="hero-pip-cap-go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 5v14M12 19l-5-5M12 19l5-5"/></svg>
                  </span>
                </button>

                <!-- Findings overlay. Open on desktop, where it sits beside the diagram; collapsed
                     on mobile, where it goes full width and would otherwise cover the diagram
                     entirely. The class is set by the inline script below rather than rendered,
                     so there is no open-then-collapse flash on a phone. -->
                <div class="hero-findings-overlay" data-findings-overlay data-panzoom-ignore>
                  <button class="hero-findings-toggle" type="button" data-findings-toggle>
                    <span class="hero-findings-badge">4 findings · HIGH risk</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hero-findings-chevron"><path d="M6 9l6 6 6-6"/></svg>
                  </button>
                  <div class="hero-findings-panel">
                    <div class="hero-findings-list">
                      <div class="ai-finding ai-finding-danger" data-tour-finding="0" data-report-target="doc-conflict" role="button" tabindex="0">
                        <span class="ai-finding-severity"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="ai-severity-icon"><path d="M8 1L1 14h14L8 1z"/><path d="M8 6v4M8 12h.01"/></svg>HIGH</span>
                        <div>
                          <strong>Package structure violation</strong>
                          <p><code>DefaultCommandHandlerManager</code> sits in <code>implementation</code>, but <code>REFACTORING.md</code> requires command handlers to live in <code>handler</code>.</p>
                        </div>
                        <span class="hero-finding-go">In the report<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg></span>
                      </div>
                      <div class="ai-finding ai-finding-danger" data-tour-finding="1" data-report-target="structural-regression" role="button" tabindex="0">
                        <span class="ai-finding-severity"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="ai-severity-icon"><path d="M8 1L1 14h14L8 1z"/><path d="M8 6v4M8 12h.01"/></svg>HIGH</span>
                        <div>
                          <strong>New directional boundary crossing</strong>
                          <p>New dependency from <code>command</code> to <code>command.implementation</code>, with no prior edge in this direction.</p>
                        </div>
                        <span class="hero-finding-go">In the report<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg></span>
                      </div>
                      <div class="ai-finding ai-finding-warn" data-tour-finding="2" data-report-target="complexity" role="button" tabindex="0">
                        <span class="ai-finding-severity"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="ai-severity-icon"><path d="M8 1L1 14h14L8 1z"/><path d="M8 6v4M8 12h.01"/></svg>MED</span>
                        <div>
                          <strong>Complexity growth: WMC +10</strong>
                          <p><code>DefaultCommandHandlerManager</code> WMC grew from 4 to 14: rising cyclomatic complexity in the misplaced class.</p>
                        </div>
                        <span class="hero-finding-go">In the report<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg></span>
                      </div>
                      <div class="ai-finding ai-finding-warn" data-tour-finding="3" data-report-target="coupling" role="button" tabindex="0">
                        <span class="ai-finding-severity"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="ai-severity-icon"><path d="M8 1L1 14h14L8 1z"/><path d="M8 6v4M8 12h.01"/></svg>MED</span>
                        <div>
                          <strong>Coupling spike: EC +9</strong>
                          <p><code>DefaultCommandHandlerManager</code> efferent coupling grew from 8 to 17, making it harder to change in isolation.</p>
                        </div>
                        <span class="hero-finding-go">In the report<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg></span>
                      </div>
                    </div>
                    <div class="hero-findings-verdict">
                      <strong>Striff</strong> read <strong>REFACTORING.md</strong> out of this repo and flagged the exact class that contradicts it.
                    </div>
                    <button class="hero-findings-more" type="button" data-report-jump="top">
                      See all 13 checks that ran
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
                    </button>
                  </div>
                </div>
                <script is:inline>
                  // Runs inline, mid-parse, so the overlay is painted once in its final state.
                  (function () {
                    var el = document.currentScript.previousElementSibling;
                    if (el && window.innerWidth >= 768) el.classList.add("is-open");
                  })();
                </script>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== THE CHECK REPORT ==================== -->
    <!-- The report used to sit behind a tab in the hero, where most people never opened it.
         It is half the product, so it gets its own section and no click. -->
    <section id="report" class="report-section scroll-mt-24">
      <div class="mx-auto max-w-[90rem] px-6">
        <div class="report-intro" data-reveal>
          <p class="report-eyebrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M12 19l-5-5M12 19l5-5"/></svg>
            For whoever has to approve it
          </p>
          <h2 class="text-balance">Your reviewers stop guessing whether it's safe to merge.</h2>
          <p class="section-subcopy">
            Passing tests tell your team the code works today. They say nothing about whether this change made the system harder to work in tomorrow. Striff answers that on the pull request, names the exact class at fault and quotes the rule it broke, so <strong>any reviewer on your team can approve with the confidence your staff engineer would</strong>.
          </p>
        </div>

        <div class="hero-stage-shell report-stage-shell" data-reveal>
          <div class="hero-stage-head">
            <div class="hero-stage-context">
              <span class="hero-context-chip">apache/fineract</span>
              <span class="hero-context-chip hero-context-chip-muted">PR #6063</span>
              <span class="hero-context-chip hero-context-chip-muted">Checks tab</span>
              <span class="hero-context-chip hero-context-chip-danger">13 checks · 4 flagged</span>
            </div>
            <div class="hero-stage-badge">Striff / architectural-review</div>
          </div>
          <div class="ghc" data-report-top>
                <!-- Left rail: the PR's full check list, Striff selected -->
                <aside class="ghc-rail">
                  <div class="ghc-rail-head">
                    <svg class="ghc-icon-success" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 16A8 8 0 1 1 8 0a8 8 0 0 1 0 16Zm3.78-9.72a.75.75 0 0 0-1.06-1.06L6.75 9.19 5.28 7.72a.75.75 0 0 0-1.06 1.06l2 2a.75.75 0 0 0 1.06 0l4.5-4.5Z"/></svg>
                    <div>
                      <p class="ghc-rail-title">All checks have passed</p>
                      <p class="ghc-rail-sub">4 successful checks</p>
                    </div>
                  </div>
                  <ul class="ghc-rail-list">
                    <li class="ghc-rail-item">
                      <svg class="ghc-icon-success" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 16A8 8 0 1 1 8 0a8 8 0 0 1 0 16Zm3.78-9.72a.75.75 0 0 0-1.06-1.06L6.75 9.19 5.28 7.72a.75.75 0 0 0-1.06 1.06l2 2a.75.75 0 0 0 1.06 0l4.5-4.5Z"/></svg>
                      <span class="ghc-rail-name">build</span>
                      <span class="ghc-rail-time">44s</span>
                    </li>
                    <li class="ghc-rail-item">
                      <svg class="ghc-icon-success" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 16A8 8 0 1 1 8 0a8 8 0 0 1 0 16Zm3.78-9.72a.75.75 0 0 0-1.06-1.06L6.75 9.19 5.28 7.72a.75.75 0 0 0-1.06 1.06l2 2a.75.75 0 0 0 1.06 0l4.5-4.5Z"/></svg>
                      <span class="ghc-rail-name">test</span>
                      <span class="ghc-rail-time">1m 12s</span>
                    </li>
                    <li class="ghc-rail-item">
                      <svg class="ghc-icon-success" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 16A8 8 0 1 1 8 0a8 8 0 0 1 0 16Zm3.78-9.72a.75.75 0 0 0-1.06-1.06L6.75 9.19 5.28 7.72a.75.75 0 0 0-1.06 1.06l2 2a.75.75 0 0 0 1.06 0l4.5-4.5Z"/></svg>
                      <span class="ghc-rail-name">lint</span>
                      <span class="ghc-rail-time">18s</span>
                    </li>
                    <li class="ghc-rail-item is-selected">
                      <svg class="ghc-icon-success" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 16A8 8 0 1 1 8 0a8 8 0 0 1 0 16Zm3.78-9.72a.75.75 0 0 0-1.06-1.06L6.75 9.19 5.28 7.72a.75.75 0 0 0-1.06 1.06l2 2a.75.75 0 0 0 1.06 0l4.5-4.5Z"/></svg>
                      <span class="ghc-rail-name">Striff / architectural-review</span>
                      <span class="ghc-rail-time">26s</span>
                    </li>
                  </ul>
                </aside>

                <!-- Right pane: the check run output -->
                <section class="ghc-pane">
                  <header class="ghc-pane-head">
                    <img class="ghc-pane-mark" src="/icon.svg" alt="" width="32" height="32" aria-hidden="true" />
                    <div class="ghc-pane-headings">
                      <h3 class="ghc-pane-title">Striff / architectural-review</h3>
                      <p class="ghc-pane-sub">Successful in 26s</p>
                    </div>
                  </header>

                  <!-- "All checks have passed" beside "4 flagged" reads as a contradiction unless
                       you already know Striff reports rather than gates. Say so here. -->
                  <p class="ghc-pane-note">
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 1.5a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13ZM8 4a.9.9 0 1 0 0 1.8A.9.9 0 0 0 8 4Zm.75 3.5a.75.75 0 0 0-1.5 0v4a.75.75 0 0 0 1.5 0Z"/></svg>
                    Green because Striff reports, it doesn't gate. The findings below are advice your reviewer can act on, not a blocked merge. Mark the check required when you want it to hold the merge button.
                  </p>

                  <div class="ghc-md">
                    <h3>Review Summary</h3>
                    <p>This PR moves command-handling responsibility into <code>command.implementation</code>: <code>DefaultCommandHandlerManager</code> is added there, and the <code>command</code> package now depends on it. That dependency direction did not exist between these two packages before.</p>
                    <h3>Top Review Items</h3>
                    <ul class="ghc-items">
                      <li data-report-anchor="doc-conflict">
                        <p class="ghc-item-head"><span class="ghc-item-badge is-doc">📄 Doc Conflict</span> Handler placed outside the documented package</p>
