---
import BaseLayout from "../layouts/BaseLayout.astro";
import InlineCodeText from "../components/InlineCodeText.astro";
import { exampleReviews } from "../data/exampleReviews";

const extensionUrl = "https://chromewebstore.google.com/detail/striffs-for-github/gcbcjajnjbplgkhnbemlkadgnjnfjoen";
const githubAppUrl = "https://github.com/apps/striff-app/installations/new";
const examplesUrl = "/#examples";

const whatItCatches = [
  {
    icon: "layers",
    accent: "blue",
    title: "New cross-layer dependency",
    body: "Spot when an API or controller starts depending directly on persistence, internals, or the wrong side of a boundary."
  },
  {
    icon: "turn",
    accent: "emerald",
    title: "Reversed dependency direction",
    body: "See when a service starts reaching into transport DTOs or other upstream concerns that usually point the other way."
  },
  {
    icon: "hub",
    accent: "amber",
    title: "Coupling jump on a shared component",
    body: "Notice when fan-in, complexity, or architectural reach grows on a class other teams already depend on."
  },
  {
    icon: "alert",
    accent: "rose",
    title: "Structurally unusual new edges",
    body: "Flag new relationships that look rare compared with healthy codebases, then explain why they deserve attention."
  }
];

const comparisonRows = [
  {
    left: "Shows edited lines and moved code.",
    right: "Shows new dependencies, boundary movement, and architectural blast radius."
  },
  {
    left: "Makes reviewers hunt through files for the risky part.",
    right: "Highlights the changed components and relationships worth reading first."
  },
  {
    left: "Can make AI-generated changes look tidy at the syntax level.",
    right: "Focuses review on structural drift, unusual edges, and the questions to ask before merge."
  }
];

const surfaces = [
  {
    icon: "check",
    accent: "blue",
    eyebrow: "GitHub Check",
    title: "Scannable structural triage in the PR checks tab",
    body: "Use the Check Run to see what changed structurally, which edges look unusual, and which components deserve a second look."
  },
  {
    icon: "graph",
    accent: "amber",
    eyebrow: "Interactive Diff",
    title: "Dive into the structural diff when you need the why",
    body: "Open the diagram to inspect changed relationships, metric shifts, and grounded review notes attached to the part of the system they describe."
  }
];

const howItWorks = [
  {
    step: "1",
    icon: "split",
    title: "Generate the structural diff",
    body: "Parse the pull request into changed components, relationships, and architectural facts instead of treating it as a flat set of files."
  },
  {
    step: "2",
    icon: "focus",
    title: "Rank what deserves review",
    body: "Combine deterministic rules, learned graph signals, and GNN-style structure scoring to rank the unusual edges and changed components that deserve attention."
  },
  {
    step: "3",
    icon: "note",
    title: "Explain the concern in context",
    body: "Use a neurosymbolic pipeline to keep the model grounded in architectural facts, then render concise review notes directly on the affected component or relationship."
  }
];

const plans = [
  {
    eyebrow: "Public OSS",
    icon: "globe",
    title: "Free review workflow for public repositories",
    body: "Install the extension and use Striff on public pull requests where maintainers need fast architectural context."
  },
  {
    eyebrow: "Private Teams",
    icon: "team",
    title: "Automated checks for private-team review",
    body: "Add the GitHub App when your team wants shared structural checks and repeatable review coverage on private pull requests."
  },
  {
    eyebrow: "Deep Integration",
    icon: "gear",
    title: "Library and private deployment options",
    body: "Use the OSS library or talk to us about internal deployment when you need deeper integration with your engineering workflow."
  }
];
---

<BaseLayout
  title="Striff - Architecture-aware pull request review"
  description="Striff surfaces unusual dependencies, boundary drift, and structural blast radius in GitHub before merge."
  canonical="https://striff.io/"
  ogImage="https://striff.io/og-image.png"
>
  <main>
    <section class="hero-section relative overflow-hidden pb-20 pt-24">
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div class="absolute -top-40 -right-40 h-80 w-80 rounded-full opacity-20 blur-3xl" style="background: radial-gradient(circle, #7ee89d 0%, transparent 70%);"></div>
        <div class="absolute -bottom-40 -left-40 h-80 w-80 rounded-full opacity-20 blur-3xl" style="background: radial-gradient(circle, #f0808e 0%, transparent 70%);"></div>
        <div class="absolute top-1/2 right-10 h-56 w-56 rounded-full opacity-15 blur-3xl" style="background: radial-gradient(circle, #6eaaee 0%, transparent 70%);"></div>
      </div>

      <div class="mx-auto max-w-6xl px-6">
        <div class="hero-copy relative z-10 mx-auto max-w-4xl space-y-8 text-center" data-reveal>
          <div class="inline-flex rounded-full border border-sky-200/90 bg-white/70 px-4 py-1 text-xs font-semibold uppercase tracking-[0.22em] text-sky-800 shadow-sm backdrop-blur-sm">
            For public GitHub pull requests
          </div>
          <div class="space-y-5">
            <h1 class="mx-auto max-w-4xl text-balance">See architectural risk before merge.</h1>
            <p class="section-subcopy mx-auto max-w-3xl">
              Striff reviews pull requests at the system level inside GitHub, surfacing unusual dependencies, boundary drift, and structural blast radius before line-by-line review eats your time.
            </p>
          </div>
          <div class="flex flex-wrap justify-center gap-4">
            <a class="btn-primary" href={extensionUrl} target="_blank" rel="noopener noreferrer">Install extension</a>
            <a class="btn-secondary" href={examplesUrl}>View examples</a>
          </div>
          <p class="mx-auto max-w-2xl text-sm text-slate-500">
            Start in public repos. Move into private-team checks only after the signal proves itself on real pull requests.
          </p>
        </div>

        <div class="relative z-10 mx-auto mt-14 w-full max-w-5xl space-y-5" data-reveal>
          <div class="hero-stage-shell" data-hero-stage>
            <div class="hero-stage-head">
              <div class="hero-stage-context">
                <span class="hero-context-chip">openapitools/openapi-generator</span>
                <span class="hero-context-chip hero-context-chip-muted">PR #19423</span>
                <span class="hero-context-chip hero-context-chip-muted">Java</span>
              </div>
              <div class="hero-stage-badge">Structural diff in GitHub</div>
            </div>

            <div class="hero-stage-canvas-wrap">
              <article class="hero-diagram-card">
                <div class="hero-diagram-topbar">
                  <span>Structural diff</span>
                  <span>Changed relationships in context</span>
                </div>
                <div class="hero-diagram-window">
                  <div class="hero-diagram-board hero-diagram-board-standalone">
                    <div class="hero-diagram-board-header">
                      <span class="hero-board-chip">Changed packages</span>
                      <span class="hero-board-chip hero-board-chip-muted">1 unusual edge</span>
                    </div>
                    <div class="hero-diagram-canvas">
                      <svg class="hero-diagram-lines" viewBox="0 0 700 420" aria-hidden="true">
                        <path d="M166 120C230 120 248 168 314 176" />
                        <path d="M166 120C232 120 246 80 316 76" />
                        <path d="M362 176C430 188 450 228 526 248" />
                        <path d="M364 78C428 94 452 138 526 148" />
                        <path d="M364 78C438 72 472 70 544 74" class="is-highlighted" />
                        <path d="M548 150C592 158 616 192 624 234" />
                      </svg>

                      <div class="hero-node hero-node-a">
                        <span class="hero-node-label">adapter/web</span>
                        <strong>BillingController</strong>
                      </div>
                      <div class="hero-node hero-node-b">
                        <span class="hero-node-label">review/core</span>
                        <strong>ReviewOrchestrator</strong>
                      </div>
                      <div class="hero-node hero-node-c">
                        <span class="hero-node-label">review/core</span>
                        <strong>StructuralSignals</strong>
                      </div>
                      <div class="hero-node hero-node-d">
                        <span class="hero-node-label">storage</span>
                        <strong>RepositoryStore</strong>
                      </div>
                      <div class="hero-node hero-node-e hero-node-highlight">
                        <span class="hero-node-label">shared/core</span>
                        <strong>ModelUtils</strong>
                      </div>
                      <div class="hero-node hero-node-f">
                        <span class="hero-node-label">github/checks</span>
                        <strong>CheckRunWriter</strong>
                      </div>

                      <div class="hero-diagram-pin">
                        <span class="hero-diagram-pin-line"></span>
                        <div class="hero-diagram-pin-card">
                          <p class="hero-pin-kicker">Grounded note</p>
                          <p class="hero-pin-copy"><strong>BillingController</strong> now reaches into <strong>ModelUtils</strong>, which usually sits behind review-core services.</p>
                        </div>
                      </div>
                    </div>
                    <div class="hero-diagram-bottom-strip">
                      <div class="hero-bottom-stat">
                        <span class="hero-bottom-label">Anomalous edges</span>
                        <strong>2</strong>
                      </div>
                      <div class="hero-bottom-stat">
                        <span class="hero-bottom-label">Flagged components</span>
                        <strong>1</strong>
                      </div>
                      <div class="hero-bottom-stat">
                        <span class="hero-bottom-label">Structural changes</span>
                        <strong>3</strong>
                      </div>
                    </div>
                  </div>
                </div>
              </article>

              <aside class="hero-overlay-check hero-overlay-check-scroll" data-hero-check aria-hidden="true">
                <div class="hero-overlay-check-head">
                  <span class="hero-overlay-check-title">GitHub Check</span>
                  <span class="hero-overlay-check-pill">Flags</span>
                </div>
                <div class="hero-overlay-check-item hero-overlay-check-item-danger">
                  <span class="hero-overlay-check-dot"></span>
                  <div>
                    <strong>Unusual edge</strong>
                    <p><code>BillingController</code> now depends on <code>ModelUtils</code>.</p>
                  </div>
                </div>
                <div class="hero-overlay-check-item hero-overlay-check-item-warn">
                  <span class="hero-overlay-check-dot"></span>
                  <div>
                    <strong>Shared component changed</strong>
                    <p><code>AbstractJavaCodegen</code> changed with dependents touching shared core.</p>
                  </div>
                </div>
              </aside>
            </div>

            <div class="hero-stage-footer">
              <div class="hero-stage-footer-copy">
                <p class="hero-slide-kicker">One artifact first</p>
                <h3>The structural diff is the main review surface.</h3>
                <p>The GitHub Check slides in while you scroll the hero so the story is clear: Striff shows the architecture, then points at the specific risky changes it wants reviewed.</p>
              </div>
              <div class="hero-overlay-check hero-overlay-check-mobile" aria-hidden="true">
                <div class="hero-overlay-check-head">
                  <span class="hero-overlay-check-title">GitHub Check</span>
                  <span class="hero-overlay-check-pill">Flags</span>
                </div>
                <div class="hero-overlay-check-item hero-overlay-check-item-danger">
                  <span class="hero-overlay-check-dot"></span>
                  <div>
                    <strong>Unusual edge</strong>
                    <p><code>BillingController</code> now depends on <code>ModelUtils</code>.</p>
                  </div>
                </div>
                <div class="hero-overlay-check-item hero-overlay-check-item-warn">
                  <span class="hero-overlay-check-dot"></span>
                  <div>
                    <strong>Shared component changed</strong>
                    <p><code>AbstractJavaCodegen</code> changed with dependents touching shared core.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="signals" class="scroll-mt-24 pb-16 pt-10">
      <div class="mx-auto max-w-6xl px-6">
        <div class="max-w-3xl" data-reveal>
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-500">What it catches</p>
          <h2 class="mt-3 text-balance">Catch the changes file diffs hide.</h2>
          <p class="section-subcopy mt-4">
            Striff earns attention when a pull request changes the shape of the system, not just the lines in a file. These are the changes it should make easier to see first.
          </p>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          {whatItCatches.map((signal) => (
            <article class={`signal-card signal-card-${signal.accent} rounded-[1.7rem] border border-white/70 bg-white/88 p-6 shadow-[0_18px_42px_rgba(15,23,42,0.06)] backdrop-blur-sm`} data-reveal>
              <div class="signal-card-top">
                <span class={`icon-badge icon-badge-${signal.accent}`} aria-hidden="true">
                  {signal.icon === "layers" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 4 4 8l8 4 8-4-8-4Z"/><path d="m4 12 8 4 8-4"/><path d="m4 16 8 4 8-4"/></svg>
                  )}
                  {signal.icon === "turn" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 7h8a4 4 0 1 1 0 8H9"/><path d="m12 14-3 3-3-3"/></svg>
                  )}
                  {signal.icon === "hub" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M19.1 4.9l-2.8 2.8M7.7 16.3l-2.8 2.8"/></svg>
                  )}
                  {signal.icon === "alert" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.5 2.9 16.3A2 2 0 0 0 4.6 19h14.8a2 2 0 0 0 1.7-2.7L13.7 3.5a2 2 0 0 0-3.4 0Z"/></svg>
                  )}
                </span>
              </div>
              <div class={`signal-mini signal-mini-${signal.accent}`} aria-hidden="true">
                <div class="signal-mini-top">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
                <div class="signal-mini-body">
                  <div class="signal-mini-node signal-mini-node-a"></div>
                  <div class="signal-mini-link"></div>
                  <div class="signal-mini-node signal-mini-node-b"></div>
                  <div class="signal-mini-callout"></div>
                </div>
              </div>
              <p class="font-semibold text-slate-900">{signal.title}</p>
              <p class="mt-3 text-sm leading-7 text-slate-600">{signal.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="proof" class="scroll-mt-24 pb-16 pt-8">
      <div class="mx-auto max-w-6xl px-6" data-reveal>
        <div class="rounded-[2.2rem] border border-white/70 bg-white/78 p-8 shadow-[0_24px_80px_rgba(15,23,42,0.08)] backdrop-blur-xl md:p-10">
        <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
          <div class="space-y-5">
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-500">Why Striff</p>
            <h2 class="text-balance">Why not just use file diffs?</h2>
            <div class="why-striff-callout">
              <p class="why-striff-callout-title">File diffs are good at edits. Striff is built for architecture movement.</p>
              <p class="why-striff-callout-copy">Large, AI-generated, or cross-cutting pull requests often hide the risky part in plain sight. Striff gives reviewers a structural first pass before they dive into files.</p>
            </div>
            <div class="flex items-center gap-3 rounded-xl border border-slate-200/80 bg-white/72 px-4 py-3 text-sm text-slate-700 backdrop-blur-sm">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="shrink-0 text-slate-400" aria-hidden="true">
                <path d="M12 14l9-5-9-5-9 5 9 5z"></path>
                <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
              </svg>
              <span>Research roots at <a class="font-medium text-slate-800 underline decoration-slate-300 underline-offset-2 hover:text-ink" href="https://www.iccq.ru/2021.html" target="_blank" rel="noopener noreferrer">ICCQ 2021</a>, with the product focused on practical PR review.</span>
            </div>
          </div>
          <div class="grid gap-4">
            {comparisonRows.map((row) => (
              <div class="comparison-row" data-reveal>
                <div class="comparison-side comparison-side-muted">
                  <p class="comparison-label">File Diff</p>
                  <p class="comparison-copy">{row.left}</p>
                </div>
                <div class="comparison-side comparison-side-strong">
                  <p class="comparison-label">Striff</p>
                  <p class="comparison-copy">{row.right}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        </div>
      </div>
    </section>

    <section id="features" class="section-dark scroll-mt-24 pb-20 pt-20">
      <div class="mx-auto max-w-6xl px-6">
        <div class="max-w-3xl" data-reveal>
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-sky-200">Two surfaces</p>
          <h2 class="mt-3 text-balance text-white">The check says what is concerning. The diff explains why.</h2>
          <p class="section-subcopy mt-4 text-slate-300">
            Striff makes more sense as review infrastructure with two linked views than as a diagram tool with extra features.
          </p>
        </div>
        <div class="mt-8 grid gap-5 lg:grid-cols-2">
          {surfaces.map((surface, index) => (
            <article class="rounded-[1.9rem] border border-white/10 bg-white/6 p-7 shadow-[0_22px_70px_rgba(0,0,0,0.18)] backdrop-blur-md" data-reveal>
              <div class="flex items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                  <span class={`icon-badge icon-badge-dark-${surface.accent}`} aria-hidden="true">
                    {surface.icon === "check" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m5 12 4 4L19 6"/></svg>
                    )}
                    {surface.icon === "graph" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19h16"/><path d="m6 15 4-5 4 3 4-7"/></svg>
                    )}
                  </span>
                  <p class="text-xs font-semibold uppercase tracking-[0.24em] text-sky-100/80">{surface.eyebrow}</p>
                </div>
                <span class={`rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-[0.16em] ${index === 0 ? "bg-blue-400/15 text-blue-100" : "bg-amber-300/15 text-amber-100"}`}>
                  {index === 0 ? "Fast triage" : "Deep review"}
                </span>
              </div>
              <div class={`surface-mini surface-mini-${surface.accent}`} aria-hidden="true">
                {index === 0 ? (
                  <div class="surface-mini-check">
                    <div class="surface-mini-check-row surface-mini-check-row-danger"></div>
                    <div class="surface-mini-check-row surface-mini-check-row-warn"></div>
                    <div class="surface-mini-check-row"></div>
                  </div>
                ) : (
                  <div class="surface-mini-diff">
                    <span class="surface-mini-pill"></span>
                    <span class="surface-mini-pill surface-mini-pill-warn"></span>
                    <div class="surface-mini-map">
                      <span class="surface-mini-box surface-mini-box-a"></span>
                      <span class="surface-mini-box surface-mini-box-b"></span>
                      <span class="surface-mini-box surface-mini-box-c"></span>
                    </div>
                  </div>
                )}
              </div>
              <h3 class="mt-4 text-2xl text-white">{surface.title}</h3>
              <p class="mt-4 text-base leading-8 text-slate-300">{surface.body}</p>
              <ul class="mt-5 space-y-3 text-sm text-slate-200">
                {index === 0 ? (
                  <>
                    <li>Highlights unusual new edges and flagged components.</li>
                    <li>Keeps the summary terse, structured, and easy to scan in GitHub.</li>
                    <li>Works even when AI notes are unavailable.</li>
                  </>
                ) : (
                  <>
                    <li>Attaches review notes to the package or component they describe.</li>
                    <li>Keeps changed relationships, metrics, and context in one artifact.</li>
                    <li>Lets maintainers judge the system effect before debating line edits.</li>
                  </>
                )}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="examples" class="scroll-mt-24 examples-section pb-20 pt-20">
      <div class="mx-auto max-w-6xl px-6">
        <div class="examples-section-header flex flex-col gap-5 md:flex-row md:items-end md:justify-between" data-reveal>
          <div class="max-w-3xl">
            <p class="examples-kicker">Real OSS examples</p>
            <h2 class="mt-3 text-balance">One polished PR example for each supported language.</h2>
            <p class="section-subcopy mt-4">
              These rows now use real Striff output from public PRs. Open any language to see a GitHub-style check summary layered directly over the structural diff artifact, with pan and zoom for the diagram.
            </p>
          </div>
          <div class="example-meta self-start md:self-auto">
            <span class="example-meta-badge">Live public PR artifacts</span>
          </div>
        </div>
        <div class="mt-8 grid gap-5">
          {exampleReviews.map((example) => (
            <details class="example-accordion rounded-[1.9rem] border border-white/75 bg-white/92 shadow-[0_24px_64px_rgba(15,23,42,0.08)] backdrop-blur-sm" data-reveal open={example.id === "java"}>
              <summary class="example-summary">
                <div class="example-summary-main">
                  <div class="example-summary-top">
                    <span class={`example-summary-mark example-summary-mark-${example.accent}`} aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 6h10"/><path d="M8 12h8"/><path d="M8 18h6"/><path d="M4 6h.01M4 12h.01M4 18h.01"/></svg>
                    </span>
                    <span class="example-language-label">{example.language}</span>
                    <span class="example-github-repo">{example.repo}</span>
                    <span class="example-pr-number">{example.pr}</span>
                    <span class="example-status-pill">Public PR</span>
                  </div>
                  <div class="example-summary-copy">
                    <h3 class="example-summary-title">{example.prTitle}</h3>
                    <p class="example-summary-subtitle">{example.summary}</p>
                  </div>
                </div>
                <span class="example-chevron" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m6 9 6 6 6-6"/></svg>
                </span>
              </summary>

              <div class="example-panel">
                <div class="example-toolbar">
                  <div class="example-toolbar-left">
                    <span class="example-toolbar-pill example-toolbar-pill-active">Focused review surface</span>
                  </div>
                  <div class="example-toolbar-right">
                    {example.metrics.slice(0, 2).map((metric) => (
                      <span class="example-metric-chip">{metric}</span>
                    ))}
                  </div>
                </div>

                <div class="example-panel-grid">
                  <div class="example-visual-shell">
                    <div class="github-diff-shell github-diff-shell-background">
                      <div class="github-pr-bar">
                        <div class="github-pr-bar-left">
                          <span class="github-pr-state github-pr-state-open">
