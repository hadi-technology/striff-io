        </div>

        <script is:inline>
        // A rule row lights its part of the diagram: hover or focus picks the row, and leaving the
        // table goes back to the broken rule, which is the one a reader needs first.
        (function () {
          var box = document.querySelector("[data-sc]");
          if (!box) return;
          var home = box.getAttribute("data-active");
          var pick = function (n) { box.setAttribute("data-active", n); };
          box.querySelectorAll("[data-rule]").forEach(function (row) {
            var n = row.getAttribute("data-rule");
            row.addEventListener("mouseenter", function () { pick(n); });
            row.addEventListener("focus", function () { pick(n); });
            row.addEventListener("click", function () { pick(n); });
          });
          var table = box.querySelector("tbody");
          if (table) {
            table.addEventListener("mouseleave", function () { pick(home); });
            table.addEventListener("focusout", function (e) { if (!table.contains(e.relatedTarget)) pick(home); });
          }
        })();
        </script>

        <!-- The two links the intro used to stack. One is about the engine that drew the picture
             directly above it; the other is the long-form account of how a sentence becomes a
             checked rule. Side by side under the check, not queued in front of it. -->
        <div class="check-foot" data-reveal>
          <a class="oss-link" href="https://github.com/hadi-technology/striff-lib" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
            <span>The diagram engine is open source: <b>striff-lib</b> on GitHub</span>
            <em>MIT</em>
          </a>
          <BlogLink slug="design-docs-are-enforceable-now" kicker="One sentence, one pull request, one verdict" />
        </div>
      </div>
