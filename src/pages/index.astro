---
import BaseLayout from "../layouts/BaseLayout.astro";
import InlineCodeText from "../components/InlineCodeText.astro";
import { exampleReviews } from "../data/exampleReviews";

const extensionUrl = "https://chromewebstore.google.com/detail/striffs-for-github/gcbcjajnjbplgkhnbemlkadgnjnfjoen";
const githubAppUrl = "https://github.com/apps/striff-app/installations/new";
const examplesUrl = "/#examples";

const comparisonRows = [
  {
    left: "Shows edited lines and moved code.",
    right: "Shows new dependencies, boundary movement, and architectural blast radius."
  }
];

const howItWorks = [
  {
    step: "1",
    icon: "split",
    title: "Parses your code into a dependency graph",
    body: "Striff builds a structural model of every pull request — components, relationships, and OOP metrics — not a flat list of changed files."
  },
  {
    step: "2",
    icon: "focus",
    title: "Scores every edge with a GNN",
    body: "A graph neural network trained on 129 well-architected codebases flags structurally unusual dependencies. 9 deterministic detectors find cycles, coupling spikes, and boundary violations."
  },
  {
    step: "3",
    icon: "note",
    title: "Explains each finding with grounded AI",
    body: "Striff's neurosymbolic pipeline keeps AI notes anchored to architectural facts — clear explanations, not hallucinated concerns. Every finding links to the exact component and relationship it describes."
  }
];

const plans = [
  {
    eyebrow: "Free",
    icon: "globe",
    title: "Public repositories",
    body: "Install the browser extension and review architectural risk on any public pull request. No setup, no config.",
    price: "$0"
  },
  {
    eyebrow: "Team",
    icon: "team",
    title: "Private repositories",
    body: "Add the GitHub App for automated structural checks on every private pull request. Shared team workflow.",
    price: "$29–$149/mo"
  },
  {
    eyebrow: "Enterprise",
    icon: "gear",
    title: "Self-hosted",
    body: "Private deployment, SSO, and audit workflows for organizations that need full control.",
    price: "Custom"
  }
];

const proofStats = [
  { value: "4", label: "Languages", detail: "Java, TypeScript, Python, C#" },
  { value: "9", label: "Detectors", detail: "cycles, coupling, boundaries, complexity" },
  { value: "129", label: "Training codebases", detail: "GNN validated at AUC 0.91" },
  { value: "0", label: "Config required", detail: "works on any PR out of the box" }
];

const proofLogos = [
  "Apache Phoenix",
  "JanssenProject / Jans",
  "Line / Armeria",
  "ArcadeDB",
  "Mastra AI",
  "pnpm",
  "Appsmith",
  "junit-team / junit5"
];
---

<BaseLayout
  title="Striff - Architecture-aware pull request review"
  description="Striff surfaces unusual dependencies, boundary drift, and structural blast radius in GitHub before merge."
  canonical="https://striff.io/"
  ogImage="https://striff.io/og-image.png"
>
  <main>
    <!-- ==================== HERO ==================== -->
    <section class="hero-section relative overflow-hidden pb-12 pt-24">
      <div class="mx-auto max-w-[90rem] px-6">
        <div class="hero-copy relative z-10 mx-auto max-w-2xl space-y-6 text-center" data-reveal>
          <p class="hero-badge">
            <span class="hero-badge-dot"></span>
            AI-generated code is creating architectural debt you can't see
          </p>
          <h1 class="mx-auto max-w-2xl text-balance">Catch the <span class="hero-gradient-text">structural debt</span> AI tools leave behind.</h1>
          <p class="section-subcopy mx-auto max-w-lg">
            Striff reviews PRs at the architecture level — catching what file diffs and AI reviewers miss.
          </p>
          <div class="flex flex-wrap justify-center gap-3 pt-1">
            <a class="btn-primary" href={extensionUrl} target="_blank" rel="noopener noreferrer">Get started free</a>
            <a class="btn-secondary" href={examplesUrl}>See it in action</a>
          </div>
          <div class="hero-trust pt-2">
            <span class="hero-trust-item">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" class="h-3.5 w-3.5"><path d="M2 8a6 6 0 1 1 12 0 6 6 0 0 1-12 0z"/><path d="M2 8h12M8 2c2 2 2 10 0 12M8 2c-2 2-2 10 0 12"/></svg>
              Free for public repos
            </span>
            <span class="hero-trust-item">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" class="h-3.5 w-3.5"><rect x="2" y="4" width="12" height="9" rx="1.5"/><path d="M2 7h12M5 10h2"/></svg>
              No credit card required
            </span>
            <div class="hero-lang-badges">
              <span class="hero-lang-badge" title="Java">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4"><path d="M8 17c-2 0-3-1-3-3s1-3 3-3c0-3 2-5 5-5s5 2 5 5c2 0 3 1 3 3s-1 3-3 3H8z"/><path d="M9 21c-1 0-2-1-2-2M12 21c-1 0-2-1-2-2"/></svg>
              </span>
              <span class="hero-lang-badge" title="TypeScript">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 12h5M11.5 12v5M16 16c0 1 .5 1.5 2 1.5s2.5-.5 2.5-2-1-1.5-2.5-2-2.5-.5-2.5-2 1-2 2.5-2 2 .5 2 1.5"/></svg>
              </span>
              <span class="hero-lang-badge" title="Python">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4"><path d="M12 2c-3 0-5 1-5 3v3h6v1H5c-2 0-3 2-3 5s1 5 3 5h2v-3c0-2 2-4 4-4h4c2 0 3-1 3-3V5c0-2-2-3-5-3h-1z"/><circle cx="9" cy="5" r=".5" fill="currentColor"/></svg>
              </span>
              <span class="hero-lang-badge" title="C#">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4"><path d="M10 3L5 6v12l5 3M14 3l5 3v12l-5 3M11 7l-2 5h4l-2 5"/></svg>
              </span>
            </div>
          </div>
        </div>

        <div class="relative z-10 mx-auto mt-12 w-full max-w-[90rem] space-y-5" data-reveal>
          <div class="hero-stage-shell" data-hero-stage>
            <div class="hero-stage-head">
              <div class="hero-stage-context">
                <span class="hero-context-chip">JanssenProject/jans</span>
                <span class="hero-context-chip hero-context-chip-muted">PR #14256</span>
                <span class="hero-context-chip hero-context-chip-muted">Java</span>
                <span class="hero-context-chip hero-context-chip-danger">HIGH risk</span>
              </div>
              <div class="hero-stage-badge">Structural diff in GitHub</div>
            </div>

            <div class="hero-stage-canvas-wrap hero-stage-canvas-full">
              <article class="hero-diagram-card">
                <div class="hero-diagram-topbar">
                  <span>Structural diff</span>
                  <span>Crypto package cycle detected</span>
                </div>
                <div class="hero-diagram-window hero-diagram-window-full">
                  <div class="hero-diagram-board hero-diagram-board-standalone">
                    <div class="hero-diagram-board-header">
                      <span class="hero-board-chip">5 crypto packages</span>
                      <span class="hero-board-chip hero-board-chip-muted">7 findings</span>
                      <span class="hero-board-chip hero-board-chip-danger">3 HIGH</span>
                    </div>
                    <div class="hero-diagram-canvas hero-diagram-canvas-full">
                      <div
                        class="github-diff-stage hero-panzoom-stage"
                        style="--example-stage-height: 28rem; --example-stage-height-mobile: 18rem;"
                        data-panzoom="pz-hero"
                        data-initial-scale="1.8"
                        data-initial-x="-200"
                        data-initial-y="-120"
                        data-mobile-scale="1.4"
                        data-mobile-x="-80"
                        data-mobile-y="-40"
                      >
                        <img
                          src="/examples/jans.svg"
                          alt="Striff structural diff for JanssenProject/jans PR #14256 — crypto package cycle"
                          class="github-diff-graphic hero-diagram-svg"
                          loading="eager"
                          draggable="false"
                        />
                        <div class="panzoom-hint" data-panzoom-hint>
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6M8 11h6"/></svg>
                          Scroll to zoom · Drag to pan
                        </div>
                      </div>

                      <button class="github-diff-reset hero-diff-reset" type="button" data-panzoom-reset="pz-hero">Reset view</button>

                      <div class="hero-float-check hero-float-check-tr">
                        <span class="hero-float-check-dot hero-float-check-dot-danger"></span>
                        <div>
                          <p class="hero-float-check-kicker">HIGH</p>
                          <strong>New package cycle</strong>
                          <p>crypto → signature → configuration → jwk → util → crypto</p>
                        </div>
                      </div>

                      <div class="hero-float-check hero-float-check-mr">
                        <span class="hero-float-check-dot hero-float-check-dot-danger"></span>
                        <div>
                          <p class="hero-float-check-kicker">HIGH</p>
                          <strong>220 dependents impacted</strong>
                          <p><code>SignatureAlgorithm</code> — afferent coupling 220, WMC +5</p>
                        </div>
                      </div>

                      <div class="hero-float-check hero-float-check-bl">
                        <span class="hero-float-check-dot hero-float-check-dot-warn"></span>
                        <div>
                          <p class="hero-float-check-kicker">MEDIUM</p>
                          <strong>Coupling spike</strong>
                          <p><code>Base64Util</code> EC 8→9, <code>SignatureAlgorithm</code> EC 62→63</p>
                        </div>
                      </div>
                    </div>
                    <div class="hero-diagram-bottom-strip">
                      <div class="hero-bottom-stat hero-bottom-stat-danger">
                        <span class="hero-bottom-label">Dependents impacted</span>
                        <strong>220</strong>
                      </div>
                      <div class="hero-bottom-stat hero-bottom-stat-danger">
                        <span class="hero-bottom-label">Package cycle</span>
                        <strong>5 nodes</strong>
                      </div>
                      <div class="hero-bottom-stat hero-bottom-stat-info">
                        <span class="hero-bottom-label">Total findings</span>
                        <strong>7</strong>
                      </div>
                    </div>
                  </div>
                </div>
              </article>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== PROBLEM + WHY COMBINED ==================== -->
    <section id="problem" class="scroll-mt-24 bg-slate-100/60 pb-12 pt-6">
      <div class="mx-auto max-w-[90rem] px-6" data-reveal>
        <div class="rounded-3xl bg-white p-8 shadow-xl border border-slate-200 md:p-10">
          <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-start">
            <div class="space-y-5">
              <p class="text-xs font-bold uppercase tracking-[0.2em] text-rose-500">The problem</p>
              <h2 class="text-balance">AI writes clean code. It builds messy architecture.</h2>
              <p class="section-subcopy">
                Every AI-generated PR looks tidy in the file diff. But underneath, new dependencies cross boundaries, coupling grows on shared components, and package cycles form. This structural debt compounds with every merge — until the codebase becomes unmaintainable.
              </p>
              <div class="problem-callout">
                <div class="flex items-start gap-3">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="mt-0.5 h-5 w-5 shrink-0 text-rose-400" aria-hidden="true"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.5 2.9 16.3A2 2 0 0 0 4.6 19h14.8a2 2 0 0 0 1.7-2.7L13.7 3.5a2 2 0 0 0-3.4 0Z"/></svg>
                  <div>
                    <p class="problem-callout-title">Real example: JanssenProject/jans PR #14256</p>
                    <p class="problem-callout-copy">CodeRabbit found the implementation bugs. But only Striff detected that <strong>SignatureAlgorithm (220 dependents)</strong> was modified, WMC grew by 5, and a <strong>5-package dependency cycle</strong> was introduced in core crypto.</p>
                  </div>
                </div>
              </div>
              <div class="problem-callout">
                <div class="flex items-start gap-3">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="mt-0.5 h-5 w-5 shrink-0 text-amber-500" aria-hidden="true"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.5 2.9 16.3A2 2 0 0 0 4.6 19h14.8a2 2 0 0 0 1.7-2.7L13.7 3.5a2 2 0 0 0-3.4 0Z"/></svg>
                  <div>
                    <p class="problem-callout-title">Real example: apache/phoenix PR #2527</p>
                    <p class="problem-callout-copy">Copilot caught line-length violations. But only Striff detected a <strong>40-node dependency cycle</strong> spanning nearly the entire codebase — plus a new class with 16 outgoing dependencies on day one.</p>
                  </div>
                </div>
              </div>
            </div>
            <div class="space-y-5">
              <div class="problem-diff-mock">
                <div class="problem-diff-header">
                  <span class="problem-diff-tab problem-diff-tab-active">Files changed</span>
                  <span class="problem-diff-badge problem-diff-badge-clean">All checks passed</span>
                </div>
                <div class="problem-diff-body">
                  <div class="problem-diff-file">
                    <p class="problem-diff-filename">SignatureAlgorithm.java</p>
                    <div class="problem-diff-lines">
                      <div class="problem-diff-line problem-diff-line-add"><span>+62</span> <span>if (curveBytes.length &lt; 32) {</span></div>
                      <div class="problem-diff-line problem-diff-line-add"><span>+63</span> <span>  bytes = padTo32(curveBytes);</span></div>
                      <div class="problem-diff-line problem-diff-line-add"><span>+64</span> <span>}</span></div>
                    </div>
                  </div>
                  <div class="problem-diff-verdict">
                    <p class="problem-diff-verdict-label">What the diff shows</p>
                    <p class="problem-diff-verdict-clean">Looks fine. 3 lines added. Move on.</p>
                  </div>
                </div>
              </div>
              <div class="problem-striff-mock">
                <div class="problem-striff-header">
                  <span class="problem-striff-tab">Striff</span>
                  <span class="problem-striff-badge">1 unusual edge</span>
                </div>
                <div class="problem-striff-body">
                  <div class="problem-striff-flag">
                    <span class="problem-striff-dot problem-striff-dot-danger"></span>
                    <div>
                      <strong>220 dependents impacted</strong>
                      <p><code>SignatureAlgorithm</code> has afferent coupling of 220. WMC grew from 17 to 22. Any change ripples across the auth server.</p>
                    </div>
                  </div>
                  <div class="problem-striff-flag">
                    <span class="problem-striff-dot problem-striff-dot-warn"></span>
                    <div>
                      <strong>Package cycle detected</strong>
                      <p>New circular dependency: <code>crypto</code> → <code>signature</code> → <code>configuration</code> → <code>jwk</code> → <code>util</code> → <code>crypto</code></p>
                    </div>
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-3 rounded-xl border border-slate-200/80 bg-white px-4 py-3 text-sm text-slate-600">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="shrink-0 text-slate-400" aria-hidden="true">
                  <path d="M12 14l9-5-9-5-9 5 9 5z"></path>
                  <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
                </svg>
                <span>Research-backed — roots at <a class="font-medium text-slate-800 underline decoration-slate-300 underline-offset-2 hover:text-blue-600" href="https://www.iccq.ru/2021.html" target="_blank" rel="noopener noreferrer">ICCQ 2021</a></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== QUANTIFIED VALUE ==================== -->
    <section class="pb-8 pt-2">
      <div class="mx-auto max-w-[90rem] px-6">
        <div class="value-band" data-reveal>
          <div class="value-band-item">
            <p class="value-band-label">Without Striff</p>
            <p class="value-band-time value-band-time-old">Hidden</p>
            <p class="value-band-desc">Dependency cycles, coupling spikes, and boundary violations accumulate silently across every merge</p>
          </div>
          <div class="value-band-arrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </div>
          <div class="value-band-item">
            <p class="value-band-label">With Striff</p>
            <p class="value-band-time value-band-time-new">Visible</p>
            <p class="value-band-desc">Every architectural risk surfaced, ranked, and explained before merge — in 30 seconds</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== EXAMPLES ==================== -->
    <section id="examples" class="scroll-mt-24 examples-section pb-16 pt-12">
      <div class="mx-auto max-w-[90rem] px-6">
        <div class="examples-section-header flex flex-col gap-5 md:flex-row md:items-end md:justify-between" data-reveal>
          <div class="max-w-3xl">
            <p class="examples-kicker">Same PR. Different reviewer. Different findings.</p>
            <h2 class="mt-3 text-balance">We ran Striff alongside CodeRabbit, Copilot, and Codex on the same PRs.</h2>
            <p class="section-subcopy mt-4">
              Here's what each tool found — and what only Striff could see. Open any row to explore the structural diff and toggle between reviewers.
            </p>
          </div>
          <div class="example-meta self-start md:self-auto">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Compared with</span>
            </div>
            <div class="flex flex-wrap items-center gap-1.5">
              <span class="ai-tool-chip">CodeRabbit</span>
              <span class="ai-tool-chip">Copilot</span>
              <span class="ai-tool-chip">Codex</span>
              <span class="ai-tool-chip ai-tool-chip-dim">+ Claude, Greptile</span>
            </div>
          </div>
          <div class="example-meta self-start md:self-auto">
            <span class="example-meta-badge">Live public PR artifacts</span>
          </div>
        </div>
        <!-- Tab selector strip -->
        <div class="example-tabs" data-reveal>
          {exampleReviews.map((example, i) => (
            <button
              class={`example-tab ${i === 0 ? "is-active" : ""}`}
              type="button"
              data-tab-index={i}
            >
              <span class={`example-tab-lang example-tab-lang-${example.accent}`}>{example.language}</span>
              <span class="example-tab-repo">{example.repo}</span>
            </button>
          ))}
        </div>

        <!-- Carousel slides -->
        <div class="example-carousel mt-4" data-reveal>
          {exampleReviews.map((example, i) => (
            <div class={`example-slide ${i === 0 ? "is-active" : ""}`} data-slide-index={i}>
              <div class="example-slide-card">
                <div class="example-slide-header">
                  <div>
                    <h3 class="example-slide-title">{example.prTitle}</h3>
                    <p class="example-slide-sub">{example.repo} {example.pr} · {example.summary}</p>
                  </div>
                  <a class="btn-secondary example-slide-link" href={example.href} target="_blank" rel="noopener noreferrer">
                    Open PR
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
                  </a>
                </div>

                <div class="example-split">
                  <div class="example-split-diagram">
                    <div class="example-diagram-toolbar">
                      <span class="example-diagram-label">Structural diff</span>
                      <button class="github-diff-reset" type="button" data-panzoom-reset={`pz-${example.id}`}>Reset view</button>
                    </div>
                    <div
                      class="github-diff-stage example-diff-stage"
                      style={`--example-stage-height:${example.viewport.desktopHeight}; --example-stage-height-mobile:${example.viewport.mobileHeight};`}
                      data-panzoom={`pz-${example.id}`}
                      data-initial-scale={example.panzoom.desktop.scale}
                      data-initial-x={example.panzoom.desktop.x}
                      data-initial-y={example.panzoom.desktop.y}
                      data-mobile-scale={example.panzoom.mobile.scale}
                      data-mobile-x={example.panzoom.mobile.x}
                      data-mobile-y={example.panzoom.mobile.y}
                    >
                      <img
                        src={example.svg}
                        alt={`${example.language} Striff structural diff for ${example.repo} ${example.pr}`}
                        class="github-diff-graphic github-diff-image"
                        loading="lazy"
                        draggable="false"
                      />
                      <div class="panzoom-hint" data-panzoom-hint>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6M8 11h6"/></svg>
                        Scroll to zoom · Drag to pan
                      </div>
                    </div>
                  </div>

                  <div class="example-split-findings">
                    {example.aiTool ? (
                      <>
                        <div class="ai-toggle" data-ai-toggle={example.id}>
                          <button class="ai-toggle-btn is-active" type="button" data-toggle-target={`striff-${example.id}`}>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ai-toggle-icon"><circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/><path d="m4.9 4.9 2.8 2.8M16.3 16.3l2.8 2.8"/></svg>
                            Striff
                          </button>
                          <button class="ai-toggle-btn" type="button" data-toggle-target={`ai-${example.id}`}>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ai-toggle-icon"><path d="M20 16V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v9m16 0H4m16 0l1.28 2.55a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45L4 16"/></svg>
                            {example.aiTool.name}
                          </button>
                        </div>
                        <div class="ai-toggle-panels">
                          <div class="ai-toggle-panel is-active" data-panel={`striff-${example.id}`}>
                            <div class="ai-findings-card ai-findings-card-striff">
                              <div class="ai-findings-header">
                                <div class="flex items-center gap-2">
                                  <span class="ai-findings-logo">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 text-blue-600"><circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/><path d="m4.9 4.9 2.8 2.8M16.3 16.3l2.8 2.8"/></svg>
                                  </span>
                                  <p class="ai-findings-title">Striff</p>
                                </div>
                                <span class="ai-findings-badge ai-findings-badge-arch">{example.checks.length} findings</span>
                              </div>
                              <div class="ai-findings-list">
                                {example.checks.map((check) => (
                                  <div class={`ai-finding ai-finding-${check.level === "danger" ? "danger" : "warn"}`}>
