---
import BaseLayout from "../layouts/BaseLayout.astro";
import InlineCodeText from "../components/InlineCodeText.astro";
import { exampleReviews } from "../data/exampleReviews";
import MetricsTab from "../components/MetricsTab";
import { orgMetricsPreviewData } from "../data/orgMetricsPreview";

// ---- Problem-section visualization: the GitHub firehose ----
// A git graph of branches continuously merging into main (cool colors), beside a
// live activity feed of issues opened and PRs opened / pushed / merged. Both
// scroll seamlessly: the block is rendered twice and translated by one copy.
type Activity = { type: "issue" | "pr" | "push" | "merge"; text: string; meta: string };
const activityFeed: Activity[] = [
  { type: "pr", text: "opened PR", meta: "#1841" },
  { type: "push", text: "pushed 4 commits", meta: "feat/retry" },
  { type: "merge", text: "merged PR", meta: "#1841" },
  { type: "issue", text: "opened issue", meta: "#302" },
  { type: "pr", text: "opened PR", meta: "#1852" },
  { type: "push", text: "pushed 2 commits", meta: "bulk-import" },
  { type: "merge", text: "merged PR", meta: "#1852" },
  { type: "issue", text: "opened issue", meta: "#318" },
  { type: "pr", text: "opened PR", meta: "#1863" },
  { type: "merge", text: "merged PR", meta: "#1863" },
];

// Literal class names (kept out of interpolation so Tailwind's @layer purge
// doesn't drop the per-type feed styles).
const feedTypeClass = {
  issue: "gs-item-issue",
  pr: "gs-item-pr",
  push: "gs-item-push",
  merge: "gs-item-merge",
} as const;

const extensionUrl = "https://chromewebstore.google.com/detail/striffs-for-github/gcbcjajnjbplgkhnbemlkadgnjnfjoen";
const githubAppUrl = "https://github.com/apps/striff-app/installations/new";
const examplesUrl = "/#examples";

const comparisonRows = [
  {
    left: "Shows edited lines and moved code.",
    right: "Shows new dependencies, boundary movement, and architectural blast radius."
  }
];

interface TeamPhilosophyItem {
  icon: string;
  color: string;
  title: string;
  body: string;
  image?: string;
  preview?: "metrics" | "docs" | "checks";
}

const teamPhilosophy: TeamPhilosophyItem[] = [
  {
    icon: "doc",
    color: "amber",
    title: "Your architecture decisions, actually enforced.",
    body: "Most teams write ADRs and an ARCHITECTURE.md, then watch PRs quietly drift from them anyway. Striff reads those docs and checks every PR against them. When a change contradicts what your team agreed on, it cites the exact file and line. No rules to configure. The documentation is the rulebook.",
    preview: "docs"
  },
  {
    icon: "chart",
    color: "emerald",
    title: "Org-wide architectural health, on one dashboard.",
    body: "Clean PR rate, high-risk PR rate, and the repos accumulating the most flags: a live read on where architecture is holding and where it's slipping, across every repo you own. Peace of mind about compliance, without reading every diff yourself.",
    preview: "metrics"
  },
  {
    icon: "mute",
    color: "blue",
    title: "Quiet by design. Loud when it matters.",
    body: "Striff posts once, as a single GitHub Check next to your CI. No comment threads, no bot spam your team learns to tune out. Clean PR, green Check, nothing else. It only speaks up for changes that put your architecture at real risk.",
    preview: "checks"
  }
];

const chromeExtensionVideoId = "gte1iFYRN88";

const chromeExtensionHighlights = [
  {
    icon: "diagram",
    color: "blue",
    title: "Live architecture diagrams, right on the PR",
    body: "A new \"Striffs\" tab appears next to GitHub's Files changed. Click it and get a real, pannable, zoomable dependency diagram of the change, not a static screenshot."
  },
  {
    icon: "comment",
    color: "emerald",
    title: "Click a component, drop a comment",
    body: "Hover any class or package in the diagram, hit +, and post a real PR comment with a rendered sub-diagram attached. No screenshotting, no leaving the page."
  },
  {
    icon: "sparkle",
    color: "amber",
    title: "AI notes overlaid directly on the graph",
    body: "Architectural findings sit right on the diagram entities they describe, with inline thumbs up/down so your team can rate findings in place."
  },
  {
    icon: "bolt",
    color: "rose",
    title: "Fast setup on any public repo",
    body: "No backend to stand up. Add your GitHub token once (a free fine-grained token works, and it stays in your browser) and go. Repeat visits to the same PR load instantly from cache."
  }
];

const plans = [
  {
    eyebrow: "Free",
    icon: "globe",
    title: "Public repositories",
    body: "Browser extension for any public PR. Architecture diagrams, risk findings, and AI review notes.",
    price: "$0",
    priceDetail: "forever"
  },
  {
    eyebrow: "Starter",
    icon: "team",
    title: "Private repos",
    body: "GitHub App checks on every private PR. Automated architecture review with the full detector suite and risk scoring.",
    price: "$29",
    priceDetail: "/mo · 5 repos"
  },
  {
    eyebrow: "Enterprise",
    icon: "gear",
    title: "Self-hosted & 50+ repos",
    body: "Private deployment, SSO, and audit workflows for organizations that need full control.",
    price: "",
    priceDetail: "Talk to us"
  }
];

---

<BaseLayout
  title="Striff - Architecture-aware pull request review"
  description="Striff surfaces unusual dependencies, boundary drift, and structural blast radius in GitHub before merge."
  canonical="https://striff.io/"
  ogImage="https://striff.io/og-image.png"
>
  <main>
    <!-- ==================== HERO ==================== -->
    <section class="hero-section relative overflow-hidden pb-12 pt-14">
      <div class="mx-auto max-w-[90rem] px-6">
        <div class="hero-copy relative z-10 mx-auto max-w-2xl space-y-6 text-center" data-reveal>
          <h1 class="mx-auto max-w-2xl text-balance">Code review for your <span class="font-bold text-blue-600">architecture</span>.</h1>
          <p class="section-subcopy mx-auto max-w-lg">
            Striff reviews every pull request as a dependency graph, not a file diff, catching boundary violations, coupling growth, and package cycles before they merge.
          </p>
          <div class="flex flex-wrap justify-center gap-3 pt-1">
            <a class="btn-primary" href={extensionUrl} target="_blank" rel="noopener noreferrer">Get started free</a>
            <a class="btn-secondary" href={examplesUrl}>See it in action</a>
          </div>
        </div>

        <div class="hero-what-you-get" data-reveal>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M12 19l-5-5M12 19l5-5"/></svg>
          What posts on your pull request: a diagram of what changed, plus ranked findings
        </div>

        <div class="relative z-10 mx-auto mt-4 w-full max-w-[90rem]" data-reveal>
          <div class="hero-stage-shell" data-hero-stage>
            <div class="hero-stage-head">
              <div class="hero-stage-context">
                <span class="hero-context-chip">apache/fineract</span>
                <span class="hero-context-chip hero-context-chip-muted">PR #6063</span>
                <span class="hero-context-chip hero-context-chip-muted">Java</span>
                <span class="hero-context-chip hero-context-chip-danger">2 HIGH · 2 MEDIUM</span>
              </div>
              <div class="hero-stage-badge">Striff / architectural-review</div>
            </div>

            <div class="hero-diagram-wrap">
              <div
                class="github-diff-stage example-diff-stage hero-diagram-stage"
                style="--example-stage-height: 40rem; --example-stage-height-mobile: 26rem;"
                data-panzoom="pz-hero"
                data-initial-scale="1.38"
                data-initial-x="-403"
                data-initial-y="-4"
                data-mobile-scale="2.2"
                data-mobile-x="-260"
                data-mobile-y="-140"
              >
                <img
                  src="/examples/fineract.svg"
                  alt="Striff structural diff for apache/fineract PR #6063"
                  class="github-diff-graphic github-diff-image"
                  loading="eager"
                  draggable="false"
                />
                <div class="panzoom-hint" data-panzoom-hint>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6M8 11h6"/></svg>
                  Scroll to zoom · Drag to pan
                </div>

                <div class="hero-diagram-tag">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="12" cy="18" r="2.5"/><path d="m8 7 3 9M16 7l-3 9M8.5 6h7"/></svg>
                  Architecture diagram of this PR
                </div>

                <!-- Findings overlay (starts open, collapsible) -->
                <div class="hero-findings-overlay is-open" data-findings-overlay>
                  <button class="hero-findings-toggle" type="button" data-findings-toggle>
                    <span class="hero-findings-badge">4 findings · HIGH risk</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hero-findings-chevron"><path d="M6 9l6 6 6-6"/></svg>
                  </button>
                  <div class="hero-findings-panel">
                    <div class="hero-findings-list">
                      <div class="ai-finding ai-finding-danger" data-tour-finding="0">
                        <span class="ai-finding-severity"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="ai-severity-icon"><path d="M8 1L1 14h14L8 1z"/><path d="M8 6v4M8 12h.01"/></svg>HIGH</span>
                        <div>
                          <strong>Package structure violation</strong>
                          <p><code>DefaultCommandHandlerManager</code> sits in <code>implementation</code>, but <code>REFACTORING.md</code> requires command handlers to live in <code>handler</code>. Doc-grounded: cites the file by name.</p>
                        </div>
                      </div>
                      <div class="ai-finding ai-finding-danger" data-tour-finding="1">
                        <span class="ai-finding-severity"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="ai-severity-icon"><path d="M8 1L1 14h14L8 1z"/><path d="M8 6v4M8 12h.01"/></svg>HIGH</span>
                        <div>
                          <strong>New directional boundary crossing</strong>
                          <p>New dependency from <code>command</code> to <code>command.implementation</code>, with no prior edge in this direction.</p>
                        </div>
                      </div>
                      <div class="ai-finding ai-finding-warn" data-tour-finding="2">
                        <span class="ai-finding-severity"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="ai-severity-icon"><path d="M8 1L1 14h14L8 1z"/><path d="M8 6v4M8 12h.01"/></svg>MED</span>
                        <div>
                          <strong>Complexity growth: WMC +10</strong>
                          <p><code>DefaultCommandHandlerManager</code> WMC grew from 4 to 14: rising cyclomatic complexity in the misplaced class.</p>
                        </div>
                      </div>
                      <div class="ai-finding ai-finding-warn" data-tour-finding="3">
                        <span class="ai-finding-severity"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="ai-severity-icon"><path d="M8 1L1 14h14L8 1z"/><path d="M8 6v4M8 12h.01"/></svg>MED</span>
                        <div>
                          <strong>Coupling spike: EC +9</strong>
                          <p><code>DefaultCommandHandlerManager</code> efferent coupling grew from 8 to 17, making it harder to change in isolation.</p>
                        </div>
                      </div>
                    </div>
                    <div class="hero-findings-verdict">
                      No other tool reads your docs. <strong>Striff</strong> cites <strong>REFACTORING.md</strong> by name and flags the exact class that violates it.
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== PROBLEM + WHY COMBINED ==================== -->
    <section id="problem" class="scroll-mt-24 bg-slate-100/60 pb-16 pt-14">
      <div class="mx-auto max-w-[90rem] px-6" data-reveal>
        <div class="rounded-3xl bg-white p-6 shadow-xl border border-slate-200 md:p-8">
          <div class="problem-split">
            <div class="problem-copy">
              <p class="text-xs font-bold uppercase tracking-[0.2em] text-rose-500">The problem</p>
              <h2 class="mt-3 text-balance">Your architecture is eroding one merge at a time.</h2>
              <p class="section-subcopy mt-4">
                Your team merges more AI-written code every week than anyone can read. Left unchecked, each merge piles on coupling and cycles until the architecture is unmaintainable. Striff catches that structural drift on every pull request.
              </p>
              <a class="blog-link-btn" href="/blog/architecture-matters-more-not-less">
                Why AI makes this worse, not better
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
              </a>
            </div>

            <!-- The firehose: branches merging into main, beside the activity feed -->
            <figure class="gs" data-reveal aria-hidden="true">
              <div class="gs-head">
                <span class="gs-live"><span class="gs-live-dot"></span> live on <span class="gs-live-repo">acme-corp</span></span>
                <span class="gs-head-tag">every day</span>
              </div>
              <div class="gs-body">
                <!-- Git branch graph: feature branches continuously merging into main -->
                <div class="gs-col">
                  <span class="gs-col-head">branches → main</span>
                  <div class="gs-graph">
                  <div class="gs-graph-scroll">
                    {[0, 1].map(() => (
                      <svg class="gs-graph-unit" viewBox="0 0 140 320" preserveAspectRatio="xMidYMid meet">
                        <path class="gs-line gs-line-main" d="M30 0 L30 320" />
                        <path class="gs-line gs-line-a" d="M30 256 C 52 256 70 242 70 218 L 70 172 C 70 148 52 144 30 144" />
                        <path class="gs-line gs-line-b" d="M30 224 C 60 224 104 206 104 178 L 104 92 C 104 66 60 64 30 64" />
                        <circle class="gs-dot gs-dot-main" cx="30" cy="32" r="5" />
                        <circle class="gs-dot gs-dot-main" cx="30" cy="96" r="5" />
                        <circle class="gs-dot gs-dot-main" cx="30" cy="160" r="5" />
                        <circle class="gs-dot gs-dot-main" cx="30" cy="224" r="5" />
                        <circle class="gs-dot gs-dot-main" cx="30" cy="288" r="5" />
                        <circle class="gs-dot gs-dot-a" cx="70" cy="196" r="4.5" />
                        <circle class="gs-dot gs-dot-b" cx="104" cy="168" r="4.5" />
                        <circle class="gs-dot gs-dot-b" cx="104" cy="102" r="4.5" />
                        <circle class="gs-merge gs-merge-a" cx="30" cy="144" r="6.5" />
                        <circle class="gs-merge gs-merge-b" cx="30" cy="64" r="6.5" />
                      </svg>
                    ))}
                  </div>
                  </div>
                </div>

                <!-- Activity feed: issues opened, PRs opened / pushed / merged -->
                <div class="gs-col gs-col-feed">
                  <span class="gs-col-head">activity</span>
                  <div class="gs-feed">
                  <div class="gs-feed-scroll">
                    {[0, 1].map(() => activityFeed.map((a) => (
                      <div class={`gs-item ${feedTypeClass[a.type]}`}>
                        <span class="gs-item-icon">
                          {a.type === "issue" ? (
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.6" fill="currentColor" stroke="none"/></svg>
                          ) : a.type === "pr" ? (
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><path d="M6 8.5v7"/><circle cx="18" cy="7" r="2.5"/><path d="M18 9.5c0 4-6 2.5-6 8"/></svg>
                          ) : a.type === "push" ? (
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21V9"/><path d="M6 15l6-6 6 6"/><path d="M5 4h14"/></svg>
                          ) : (
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><path d="M6 8.5v7"/><circle cx="18" cy="16" r="2.5"/><path d="M18 13.5c0-5-6-1.5-6-7"/></svg>
                          )}
                        </span>
                        <span class="gs-item-text">{a.text}</span>
                        <span class="gs-item-meta">{a.meta}</span>
                      </div>
                    )))}
                  </div>
                  </div>
                </div>
              </div>
              <figcaption class="gs-caption">More PRs, branches and issues than any human can review, every single day.</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== EXAMPLES ==================== -->
    <section id="examples" class="scroll-mt-24 section-dark examples-band pb-20 pt-20">
      <div class="mx-auto max-w-[90rem] px-6">
        <div class="examples-section-header flex flex-col gap-5 md:flex-row md:items-end md:justify-between" data-reveal>
          <div class="max-w-3xl">
            <p class="examples-kicker">Real pull requests, real findings</p>
            <h2 class="mt-3 text-balance">The riskiest changes look safe in a file diff.</h2>
            <p class="section-subcopy mt-4">
              These are real public pull requests. Each one looked routine file-by-file. Striff read the structure underneath (<strong>a core engine reaching into a plugin, drivers rewired into the platform layer, query internals one step from a namespace cycle</strong>) and posted the findings before merge.
            </p>
          </div>
          <ul class="example-proof-stack self-start md:self-auto">
            <li>Live public PRs: open any of them and verify</li>
            <li>Findings posted on the PR before merge</li>
            <li>Zero overlap with AI reviewers' comments</li>
          </ul>
        </div>
        <!-- Tab selector strip -->
        <div class="example-tabs mt-9" data-reveal>
          {exampleReviews.map((example, i) => (
            <button
              class={`example-tab ${i === 0 ? "is-active" : ""}`}
              type="button"
              data-tab-index={i}
            >
              <span class={`example-tab-lang example-tab-lang-${example.accent}`}>{example.language}</span>
              <span class="example-tab-repo">{example.repo}</span>
            </button>
          ))}
        </div>

        <!-- Carousel slides -->
        <div class="example-carousel mt-6" data-reveal>
          {exampleReviews.map((example, i) => (
            <div class={`example-slide ${i === 0 ? "is-active" : ""}`} data-slide-index={i}>
              <div class="example-slide-card">
                <div class="example-slide-header">
                  <div>
                    <h3 class="example-slide-title"><a href={example.href} target="_blank" rel="noopener noreferrer">{example.prTitle}</a></h3>
                    <p class="example-slide-sub">{example.repo} {example.pr} · {example.summary}</p>
                  </div>
                  <a class="btn-secondary example-slide-link" href={example.href} target="_blank" rel="noopener noreferrer">
                    Open PR
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
                  </a>
                </div>

                <!-- Head-to-head scoreboard -->
                <div class="ex-score">
                  {example.scoreboard.map((tile) => (
                    <div class={`ex-score-tile ex-score-${tile.tone}`}>
                      <span class="ex-score-value">{tile.value}</span>
                      <InlineCodeText class="ex-score-label" text={tile.label} />
                    </div>
                  ))}
                </div>

                <div class="example-split">
                  <div class="example-split-diagram">
                    <div class="example-diagram-toolbar">
                      <span class="example-diagram-label">Structural diff</span>
                      <button class="github-diff-reset" type="button" data-panzoom-reset={`pz-${example.id}`}>Reset view</button>
                    </div>
                    <div
                      class="github-diff-stage example-diff-stage"
                      style="--example-stage-height: 26rem; --example-stage-height-mobile: 18rem;"
                      data-panzoom={`pz-${example.id}`}
                      data-initial-scale={example.panzoom.desktop.scale}
                      data-initial-x={example.panzoom.desktop.x}
                      data-initial-y={example.panzoom.desktop.y}
                      data-mobile-scale={example.panzoom.mobile.scale}
                      data-mobile-x={example.panzoom.mobile.x}
                      data-mobile-y={example.panzoom.mobile.y}
                    >
                      <img
                        src={example.svg}
                        alt={`${example.language} Striff structural diff for ${example.repo} ${example.pr}`}
                        class="github-diff-graphic github-diff-image"
                        loading="lazy"
                        draggable="false"
                      />
                      <div class="panzoom-hint" data-panzoom-hint>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6M8 11h6"/></svg>
                        Scroll to zoom · Drag to pan
                      </div>
                    </div>
                  </div>

                  <div class="example-split-compare">
                    <!-- Striff lane: hero finding + supporting findings -->
                    <div class="ex-lane ex-lane-striff">
                      <div class="ex-lane-head">
                        <span class="ex-lane-name">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ex-lane-icon"><circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/><path d="m4.9 4.9 2.8 2.8M16.3 16.3l2.8 2.8"/></svg>
                          Striff
                        </span>
                        <span class="ex-lane-tag ex-lane-tag-striff">reads the structure</span>
                      </div>
                      <div class="ex-lane-scroll">
                        <div class="ex-hero">
                          <p class="ex-hero-stat">{example.hero.stat}</p>
                          <InlineCodeText class="ex-hero-statlabel" text={example.hero.statLabel} />
                          <p class="ex-hero-title"><InlineCodeText text={example.hero.title} /></p>
                          <InlineCodeText class="ex-hero-body" text={example.hero.body} />
                        </div>
                        {example.checks.map((check) => (
                          <div class={`ex-row ex-row-${check.level === "danger" ? "danger" : "warn"}`}>
                            <span class="ex-row-sev">{check.level === "danger" ? "HIGH" : check.level === "warn" ? "MED" : "INFO"}</span>
                            <div>
                              <strong><InlineCodeText text={check.title} /></strong>
                              <InlineCodeText class="ex-row-body" text={check.body} />
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>

                    <div class="ex-verdict">
                      {example.aiTool ? (
                        <p><strong>AI reviewers on this PR caught implementation bugs, and zero of these findings.</strong> Striff reads the layer diff-based tools can't see. Use both.</p>
                      ) : (
                        <p><InlineCodeText text={example.checkHeader} /></p>
                      )}
                      <a class="blog-link-btn blog-link-btn--compact" href="/blog/architectural-findings-in-oss">
                        More findings from major OSS repos
                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Navigation -->
        <div class="example-nav" data-reveal>
          <button class="example-nav-btn" type="button" data-nav="prev" aria-label="Previous example">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <div class="example-dots">
            {exampleReviews.map((_, i) => (
              <button class={`example-dot ${i === 0 ? "is-active" : ""}`} type="button" data-dot-index={i} aria-label={`Go to example ${i + 1}`} />
            ))}
          </div>
          <button class="example-nav-btn" type="button" data-nav="next" aria-label="Next example">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>

