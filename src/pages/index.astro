  <script is:inline>
    (function () {
      var tabs = document.querySelectorAll("[data-tab-index]");
      var slides = document.querySelectorAll("[data-slide-index]");
      var dots = document.querySelectorAll("[data-dot-index]");
      var prevBtn = document.querySelector('[data-nav="prev"]');
      var nextBtn = document.querySelector('[data-nav="next"]');
      var current = 0;
      var total = tabs.length;

      function showSlide(index) {
        current = ((index % total) + total) % total;

        tabs.forEach(function (t, i) { t.classList.toggle("is-active", i === current); });
        slides.forEach(function (s, i) { s.classList.toggle("is-active", i === current); });
        dots.forEach(function (d, i) { d.classList.toggle("is-active", i === current); });

        var activeSlide = slides[current];
        if (activeSlide) {
          var stage = activeSlide.querySelector("[data-panzoom]");
          if (stage && stage._panzoomReset) {
            stage._panzoomReset();
          }
        }
      }

      tabs.forEach(function (tab, i) {
        tab.addEventListener("click", function () { showSlide(i); });
      });

      dots.forEach(function (dot, i) {
        dot.addEventListener("click", function () { showSlide(i); });
      });

      if (prevBtn) prevBtn.addEventListener("click", function () { showSlide(current - 1); });
      if (nextBtn) nextBtn.addEventListener("click", function () { showSlide(current + 1); });
    })();

    (function () {
      document.querySelectorAll("[data-ai-toggle]").forEach(function (toggle) {
        var buttons = toggle.querySelectorAll("[data-toggle-target]");

        buttons.forEach(function (btn) {
          btn.addEventListener("click", function () {
            var target = btn.getAttribute("data-toggle-target");

            buttons.forEach(function (b) { b.classList.remove("is-active"); });
            btn.classList.add("is-active");

            var container = toggle.parentElement;
            var panels = container.querySelectorAll("[data-panel]");
            panels.forEach(function (panel) {
              if (panel.getAttribute("data-panel") === target) {
                panel.classList.add("is-active");
              } else {
                panel.classList.remove("is-active");
              }
            });
          });
        });
      });
    })();

    (function () {
      function clamp(value, min, max) {
        return Math.min(max, Math.max(min, value));
      }

      document.querySelectorAll("[data-panzoom]").forEach(function (stage) {
        var id = stage.getAttribute("data-panzoom");
        var media = stage.querySelector(".github-diff-graphic");
        var reset = document.querySelector('[data-panzoom-reset="' + id + '"]');
        if (!media) return;

        var hint = stage.querySelector("[data-panzoom-hint]");
        var hintHidden = false;

        function hideHint() {
          if (hint && !hintHidden) {
            hintHidden = true;
            hint.classList.add("is-hidden");
          }
        }

        var scale = 1;
        var x = 0;
        var y = 0;
        var startX = 0;
        var startY = 0;
        var dragging = false;

        function paint() {
          media.style.transform = "translate(" + x + "px, " + y + "px) scale(" + scale + ")";
        }

        function numberAttr(name, fallback) {
          var value = parseFloat(stage.getAttribute(name) || "");
          return Number.isFinite(value) ? value : fallback;
        }

        function resetView() {
          var mobile = window.innerWidth < 768;
          scale = numberAttr(mobile ? "data-mobile-scale" : "data-initial-scale", mobile ? 1.2 : 1.6);
          x = numberAttr(mobile ? "data-mobile-x" : "data-initial-x", mobile ? -40 : -120);
          y = numberAttr(mobile ? "data-mobile-y" : "data-initial-y", mobile ? -30 : -80);
          paint();
        }

        stage.addEventListener("wheel", function (event) {
          event.preventDefault();
          hideHint();
          var next = clamp(scale + (event.deltaY < 0 ? 0.12 : -0.12), 1, 2.8);
          scale = next;
          paint();
        }, { passive: false });

        stage.addEventListener("pointerdown", function (event) {
          hideHint();
          dragging = true;
          startX = event.clientX - x;
          startY = event.clientY - y;
          stage.setPointerCapture(event.pointerId);
          stage.classList.add("is-dragging");
        });

        stage.addEventListener("pointermove", function (event) {
          if (!dragging || scale <= 1) return;
          x = event.clientX - startX;
          y = event.clientY - startY;
          paint();
        });

        function stopDragging() {
          dragging = false;
          stage.classList.remove("is-dragging");
        }

        stage.addEventListener("pointerup", stopDragging);
        stage.addEventListener("pointercancel", stopDragging);
        stage.addEventListener("pointerleave", stopDragging);

        if (reset) {
          reset.addEventListener("click", resetView);
        }

        stage._panzoomReset = resetView;
        resetView();
      });
    })();
  </script>
</BaseLayout>
