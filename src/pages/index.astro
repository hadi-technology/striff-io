  { num: 421, title: "Bump jackson-databind from 2.17.1 to 2.18.2", who: "dependabot[bot]", when: "12 minutes ago", review: "Approved", label: "dependencies", verdict: "held" },
  { num: 420, title: "Add incremental repair history", who: "kchen", when: "2 hours ago", review: "Approved", verdict: "held" },
  { num: 419, title: "Fix typo in scheduler log line", who: "sam-new-hire", when: "4 hours ago", review: "Approved", verdict: "held" },
  { num: 418, title: "Refactor NodeWorker lifecycle", who: "coding-agent[bot]", when: "yesterday", review: "Review required", label: "agent", verdict: "violated" }
];

const mgrSlides = [
  {
    title: "Your senior engineers stop being the bottleneck.",
    body: "Architecture review usually waits on the few people who know the system, and agent-written pull requests have made that queue longer. Striff checks every pull request against what those people already wrote down, so they are pulled in when a rule breaks, not to re-check the ones that held."
  },
  {
    title: "Your documentation stops rotting.",
    body: "A document nobody checks drifts until nobody trusts it, and then nobody writes the next one. Once every pull request is checked against it, a stale sentence gets caught: a README describing a call the code has just dropped shows up on the pull request that dropped it."
  },
  {
    title: "See which repositories are drifting from their docs.",
    body: "The dashboard shows, month over month, which repositories and pull requests break your documented rules: rules held, broken and already broken, the share of pull requests that broke none, and the repositories flagged most. You know where to spend fix-up time."
  }
]

const plans = [
  {
    eyebrow: "Free",
    icon: "globe",
    title: "Public repositories",
    body: "Your documented rules checked on every public pull request, with a diagram of each change, plus the browser extension for any public PR you visit.",
    price: "$0",
    priceDetail: "forever"
  },
  {
    eyebrow: "Starter",
    icon: "team",
    title: "One team's private repos",
    body: "Your documented rules checked on every private pull request, with a diagram of each change, for one team\u2019s repositories.",
    price: "$29",
    priceDetail: "/mo · 5 repos"
  },
  {
    eyebrow: "Enterprise",
    icon: "gear",
