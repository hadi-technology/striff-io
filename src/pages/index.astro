/**
 * For teams: the section for the engineering lead, not the reviewer. It sells what changes for the
 * organisation (the docs become guardrails, drift is visible before it is a rewrite, nothing to roll
 * out), shows the one dashboard view that is the lead's own (metrics, live, on the demo workspace),
 * and answers the four questions a lead asks before bringing a tool in. The other two dashboard
 * views are links into the demo.
 */
const teamsPoints = [
  {
    title: "The docs your team wrote become the guardrails",
    body: "ADRs, design docs and AGENTS.md are checked on every pull request, by people and agents alike. No rules to write, no new process to teach.",
  },
  {
    title: "See drift before it turns into a rewrite",
    body: "Which repositories broke a documented rule this month, which pull requests did it, and which docs have gone stale. The places your clean-up time should go.",
  },
  {
    title: "Nothing to roll out",
    body: "One install covers the organisation. No per-developer setup, and the check is advisory until you choose to make it required.",
  },
];
const teamsAnswers = [
  { q: "Will it be noisy?", a: "Every break is confirmed by a second, independent reading of the doc and the code before anyone sees it. Rules it can't settle are counted, never guessed." },
  { q: "Is our code safe?", a: "Source is parsed in memory and not stored. Self-hosted deployment is available on Enterprise." },
  { q: "What does it cost?", a: "A flat monthly price by how many private repos Striff works on: $29, $59 or $149. Public repos are free." },
  { q: "How long to get value?", a: "The first pull request after install. Striff reads the docs you already have; there is nothing to configure." },
];
/** Public repositories whose pull requests Striff checks today (check runs visible on GitHub). */
const teamsInUse = [
  { name: "objectionary/eo", url: "https://github.com/objectionary/eo" },
  { name: "AArnott/Nerdbank.MessagePack", url: "https://github.com/AArnott/Nerdbank.MessagePack" },
];
/**
 * What people who run Striff say. Empty until each quote is approved by the person who wrote it;
 * the block is not rendered while it is empty. { quote, name, role }.
 */
const teamsQuotes: { quote: string; name: string; role: string }[] = [];


const plans = [
  {
    eyebrow: "Free",
    icon: "globe",
    title: "Public repositories",
    body: "Your documented rules checked on every public pull request, with a diagram of each change. Free for open source, forever.",
    price: "$0",
    priceDetail: "forever"
  },
  {
    eyebrow: "Starter",
    icon: "team",
    title: "One team's private repos",
    body: "Your documented rules checked on every private pull request, with a diagram of each change, for one team\u2019s repositories.",
    price: "$29",
    priceDetail: "/mo · up to 5 private repos"
  },
  {
    eyebrow: "Enterprise",
    icon: "gear",
    title: "Self-hosted & 50+ repos",
    body: "Private deployment, SSO, and audit workflows for organizations that need full control.",
    price: "",
    priceDetail: "Talk to us"
  }
];

/**
 * The FAQ, as data: the page renders it and the FAQPage structured data repeats it, so the two can
 * never say different things. Answers are HTML.
 */
const faqs: { id?: string; q: string; a: string }[] = [
  {
    q: `How does Striff know what my architecture is supposed to look like?`,
    a: `<strong>You already wrote it down.</strong> Striff reads the documents in your repository that make claims about the code, turns those sentences into rules, and checks them against the code your pull request produces, quoting the sentence and linking the file it came from. <em>Nothing is configured and no rule format is invented:</em> your documentation is the rulebook. A rule can be as plain as where a class lives or as sharp as <em>&ldquo;the domain module must not depend on infrastructure&rdquo;</em>. Alongside the rules, every pull request gets a <strong>diagram of what changed</strong> and <strong>review notes</strong> on the components it touched. If your docs make no checkable claim about the code, Striff invents no rules of its own: you still get the diagram and the review notes.`
  },
  {
    q: `Does Striff work with spec-driven development?`,
    a: `<strong>Yes: it is the check that comes after the spec.</strong> Spec-driven workflows help you write a spec and build from it, and nothing in them checks, on the pull requests that follow, that the code still does what the spec says it does. Striff reads the specs, plans and design docs committed to your repository alongside your <code>AGENTS.md</code>, <code>CLAUDE.md</code> and ADRs, turns each sentence that makes a claim about the structure of the code into a rule, and checks every pull request against it. <em>A sentence that describes work still to come is not held against code nobody has written yet.</em> When a change contradicts the spec, the check quotes the line: that is <a href="/spec-drift/" class="font-semibold text-blue-600 hover:underline">spec drift</a>, caught while it is still a one-line fix.`
  },
  {
    id: "languages",
    q: `What languages does Striff support?`,
    a: `Striff reads <strong>Java, Kotlin, TypeScript, Python and C#</strong>. Striff parses source into a full structural model with its own parser, not regex or text matching, so references, inheritance and dependencies resolve the way a compiler sees them. Go is coming.`
  },
  {
    q: `Is it just an LLM wrapper?`,
    a: `<strong>No, and the architecture is the answer.</strong> A language model reads your docs and proposes rules; a program decides whether each one holds. The parser builds a model of the code at both revisions, each documented rule becomes a query over that model, and a rule is held when nothing in the pull request breaks it. When a rule looks broken, <strong>an agent re-reads the sentence and the code twice, independently, before you see it</strong>, and the break is shown only if both readings confirm it on the same evidence. That step can hold an accusation back; <em>it cannot invent one, and it cannot turn &ldquo;could not answer&rdquo; into a pass.</em> A rule Striff cannot answer from the code is reported as one it couldn&rsquo;t check, never counted as green.`
  },
  {
    q: `Will it slow down or block my pull requests?`,
    a: `<strong>No.</strong> Striff runs as a GitHub Check next to your CI and posts its results when the analysis finishes, typically <em>within a few minutes</em>. It never blocks a merge <strong>unless you choose to make the check required</strong>.`
  },
  {
    q: `What do I need to set up?`,
    a: `<strong>Just install the GitHub App.</strong> It works on public and private repos alike and posts checks automatically on every PR, with <em>no per-developer setup</em>. Plans start at <strong>$29/month</strong>, based on how many private repos Striff <em>works on</em> each month (it checks one of their pull requests or reads their documents after a push), not how many you connect. A quiet month costs $29, the Starter price. <strong>Public repositories are free.</strong>`
  },
  {
    q: `Is this the same as writing architecture tests?`,
    a: `<strong>It is architecture tests you don&rsquo;t have to write.</strong> Each sentence in your docs that makes a checkable claim about the code (a dependency direction, where a class lives, what a module must not import, which methods a type has) becomes a check that runs on every pull request. The docs stay the source of truth: when someone edits a sentence, the rule changes with it on the next pull request, and nothing has to be kept in sync by hand.`
  },
  {
    q: `Does Striff tell me what it couldn&rsquo;t check?`,
    a: `<strong>Yes.</strong> Every rule has one of five states: <em>Held</em>, <em>Newly broken</em> by this pull request, <em>Already broken</em> before it, <em>Restored</em> by it, or <em>Couldn&rsquo;t check</em>. A rule the code can&rsquo;t settle, or a break the verifier would not confirm, is counted under Couldn&rsquo;t check and never passed off as held. The dashboard lists each document Striff read and the rules it took from it, so you can see what is covered and what isn&rsquo;t.`
  },
  {
    q: `What happens when a rule breaks?`,
    a: `The check on the pull request lists it first, quotes the sentence, links the line in the doc and names the code that breaks it. In the dashboard, every finding can be <strong>opened as a GitHub issue that is already written</strong>, or <strong>copied as a prompt for your coding agent</strong> to fix the code or update the doc. A rule that breaks on the default branch is emailed to the people watching the repository.`
  },
  {
    q: `Is my source code sent to a third party or stored?`,
    a: `Your code is parsed on Striff's servers <strong>in memory, and the source itself is not stored</strong>. Rules are proposed from your documents and verdicts are computed from the structural model of your code. When a rule looks broken, the verifier reads the files involved to confirm it, and the notes it made on that decision are kept for a limited time. For teams that need full control, <strong>self-hosted deployment</strong> is available on the Enterprise plan.`
  }
];

const plainText = (html: string) =>
  html.replace(/<[^>]+>/g, "").replace(/&rsquo;/g, "\u2019").replace(/&ldquo;/g, "\u201c").replace(/&rdquo;/g, "\u201d").replace(/&amp;/g, "&");

/**
 * Who Striff is, what it is, and the FAQ, for search engines. "Striff" is also a shop, a
 * construction part and a surname, so the organisation and the application are named outright.
 */
const structuredData = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Striff",
    url: "https://striff.io/",
    logo: "https://striff.io/icon-192.png",
    sameAs: ["https://github.com/hadi-technology"]
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Striff",
    url: "https://striff.io/",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Web, GitHub",
    description:
      "Striff turns the sentences in a repository's specs, AGENTS.md, ADRs and architecture docs into rules and checks every GitHub pull request against them, catching spec drift before the merge.",
    offers: [
      { "@type": "Offer", name: "Public repositories", price: "0", priceCurrency: "USD" },
      { "@type": "Offer", name: "Starter", price: "29", priceCurrency: "USD" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: plainText(faq.q),
      acceptedAnswer: { "@type": "Answer", text: plainText(faq.a) }
    }))
  }
]).replace(/</g, "\\u003c");
---

<BaseLayout
  title="Striff: your specs and architecture docs, checked on every PR"
  description="Striff turns the sentences in your specs, AGENTS.md, ADRs and architecture docs into rules and checks every GitHub pull request against them."
  canonical="https://striff.io/"
  ogImage="https://striff.io/og-image.png"
>
  <script slot="head" type="application/ld+json" is:inline set:html={structuredData} />
  <main>
    <!-- ==================== HERO ==================== -->
    <!-- The product is a GitHub check, so the hero is one, rendered light and at full
         fidelity: an illustrative example (acme/checkout-service, labelled Example), not a
         real run. Each row is the sentence, the file and line it is on, the rule it became,
         and what happened to it on this pull request; the broken row leads because that is
         the row a reviewer needs first. The real ecChronos run is in the report below. -->
    <section class="hero-section relative overflow-hidden">
      <div class="mx-auto max-w-[90rem] px-6">
        <div class="hero-copy relative z-10 mx-auto max-w-4xl space-y-5 text-center" data-reveal>
          <h1 class="mx-auto">
            <span class="sr-only">Your specs and architecture docs, enforced on every pull request.</span>
            <span aria-hidden="true">Your <span class="h1-rot" data-h1-rot><span class="h1-rot-word is-on">specs</span><span class="h1-rot-word">architecture docs</span><span class="h1-rot-word">design docs</span><span class="h1-rot-word">AGENTS.md</span></span>,<br /> <span class="hero-h1-accent">enforced on every pull request</span>.</span>
          </h1>
          <p class="section-subcopy hero-subcopy mx-auto">
            Your docs already state the rules. Striff checks every pull request against them, and <strong>when a change contradicts one, it quotes the sentence, before the merge.</strong>
          </p>

          <div class="flex flex-wrap justify-center gap-3 pt-2">
            <a class="btn-primary btn-primary-lg" href={githubAppUrl} target="_blank" rel="noopener noreferrer">
              <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
              </svg>
              Install the GitHub App
            </a>
            <a class="btn-secondary btn-secondary-lg" href="#pipeline">How it works</a>
          </div>
        </div>

        <div class="hero-check-wrap" data-reveal>
          <div class="hero-check-card">
            <!-- Styled as the check it is, and in the same clothes as the real one further down
                 the page, so a reader meets one idea twice rather than two designs once. The
                 branch and the pull request number are the part that was missing: without them
                 the card was a table of rules with no occasion. -->
            <header class="hcc-head ghcheck-head">
              <span class="ghcheck-mark"><img src="/icon.svg" alt="" width="18" height="18" /></span>
              <!-- A check exists on a pull request, and the header is the only thing that says
                   which one. It used to say it in the same small mono line as the branch, where
                   the number a reviewer would quote was the least visible thing on the card. -->
              <span class="ghcheck-title">
                <b>
                  Striff
                  <span class="ghcheck-on">on</span>
                  <span class="ghcheck-pr">
                    <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M1.5 3.25a2.25 2.25 0 1 1 3 2.122v5.256a2.251 2.251 0 1 1-1.5 0V5.372A2.25 2.25 0 0 1 1.5 3.25Zm5.677-.177L9.573.677A.25.25 0 0 1 10 .854V2.5h1A2.5 2.5 0 0 1 13.5 5v5.628a2.251 2.251 0 1 1-1.5 0V5a1 1 0 0 0-1-1h-1v1.646a.25.25 0 0 1-.427.177L7.177 3.427a.25.25 0 0 1 0-.354ZM3.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm0 9.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm8.25.75a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Z"/></svg>
                    Pull request #418
                  </span>
                </b>
                <i>{heroExampleRepo} &middot; feat/csv-export &rarr; main</i>
              </span>
              <span class="ghcheck-state is-bad">
                <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M2.343 13.657A8 8 0 1 1 13.658 2.343 8 8 0 0 1 2.343 13.657ZM6.03 4.97a.751.751 0 0 0-1.06 1.06L6.94 8 4.97 9.97a.75.75 0 1 0 1.06 1.06L8 9.06l1.97 1.97a.75.75 0 0 0 1.06-1.06L9.06 8l1.97-1.97a.75.75 0 0 0-1.06-1.06L8 6.94Z"/></svg>
                1 rule broken
              </span>
            </header>

            <div class="hcc-banner">
              <span class="hcc-banner-dot" aria-hidden="true"></span>
              <p class="hcc-banner-text">
                <strong>One of the {heroExampleTally.broken + heroExampleTally.held} rules Striff checked in this repository&rsquo;s own docs no longer holds.</strong>
                <span>Nothing was configured.</span>
              </p>
              <span class="hcc-tally">
                <span class="hcc-tally-item hcc-tally-violated"><b>{heroExampleTally.broken}</b><i>broken</i></span>
                <span class="hcc-tally-item hcc-tally-held"><b>{heroExampleTally.held}</b><i>held</i></span>
              </span>
            </div>

            <RuleRows rows={heroExampleRules} />
          </div>
          <!-- The notation named once, where it is being looked at. Without this the formulas
               are a signal that something is being computed; with it they are the thing being
               computed, which is the claim the whole page rests on. -->
          <p class="hero-check-more">
            <Formula tex={String.raw`\varphi`} /> is the rule compiled to a formula,
            <Formula tex={String.raw`\mathcal{M}`} /> your code parsed at each revision; the
            verdict is whether one satisfies the other. Three of the {heroExampleTally.broken + heroExampleTally.held} rules
            this repository&rsquo;s docs state. <a href="/demo/">The dashboard lists all of them &rarr;</a>
          </p>
          <div class="hero-langs" aria-label="Supported languages">
            <span class="hero-langs-label">Works with</span>
            {heroLanguages.map((lang) => (
              <span class="lang-chip" style={`--lang: ${lang.color}`}>
                <span class="lang-chip-mark" aria-hidden="true">{lang.mark}</span>
                {lang.name}
              </span>
            ))}
          </div>
        </div>

        <!-- Found in open source: repositories people know, each with its report's rules tally and
             linking to the report, which is the case study. Under the example check, so a reader
             knows what Striff does before following a link to a report. The repositories are
             static (src/data/ossFindings.ts); the tallies are read from the live reports when the
             site is built (src/data/ossTally.js). The list scrolls slowly and stops under a pointer
             or keyboard focus, and with reduced motion it stands still. The second copy of the list
             exists only to make the loop seamless, so it is hidden from assistive technology and
             the tab order. -->
        <section id="found-in-oss" class="proof-strip" aria-labelledby="proof-strip-label" data-reveal>
          <div class="proof-strip-inner">
            <p id="proof-strip-label" class="proof-strip-label">Recent findings in</p>
            <div class="proof-strip-viewport">
              <div class="proof-strip-rail">
                {[false, true].map((copy) => (
                  <ul class="proof-strip-list" aria-hidden={copy ? "true" : undefined} aria-labelledby={copy ? undefined : "proof-strip-label"}>
                    {ossShown.map((r) => (
                      <li>
                        <a
                          class="proof-item"
                          href={reportPath(r)}
                          tabindex={copy ? -1 : undefined}
                          aria-label={copy ? undefined : `${r.owner}/${r.repo}, ${r.stars} stars: ${tallyWords(r.tally)}`}
                          title={`Read Striff's report on ${r.owner}/${r.repo}`}
                        >
                          <img class="proof-item-avatar" src={r.avatar} alt="" width="24" height="24" decoding="async" />
                          <span class="proof-item-body">
                            <span class="proof-item-head">
                              <span class="proof-item-name"><span class="proof-item-owner">{r.owner}<span class="proof-item-slash">/</span></span><span class="proof-item-repo">{r.repo}</span></span>
                              <span class="proof-item-stars">{r.stars}<span aria-hidden="true"> &#9733;</span></span>
                            </span>
                            <span class="proof-tally">
                              <span class="proof-tally-item is-held">
                                <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M8 16A8 8 0 1 1 8 0a8 8 0 0 1 0 16Zm3.78-9.72a.751.751 0 0 0-1.06-1.06L6.75 9.19 5.28 7.72a.751.751 0 0 0-1.06 1.06l2 2a.75.75 0 0 0 1.06 0Z"/></svg>
                                <b>{r.tally.held}</b><i>held</i>
                              </span>
                              <span class={`proof-tally-item is-broken${r.tally.broken === 0 ? " is-none" : ""}`}>
                                <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M2.343 13.657A8 8 0 1 1 13.658 2.343 8 8 0 0 1 2.343 13.657ZM6.03 4.97a.751.751 0 0 0-1.06 1.06L6.94 8 4.97 9.97a.75.75 0 1 0 1.06 1.06L8 9.06l1.97 1.97a.75.75 0 1 0 1.06-1.06L9.06 8l1.97-1.97a.75.75 0 0 0-1.06-1.06L8 6.94Z"/></svg>
                                <b>{r.tally.broken}</b><i>broken</i>
                              </span>
                              <span class="proof-tally-item is-stale"><b>{r.tally.staleNames}</b><i>stale names</i></span>
                            </span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                ))}
              </div>
            </div>
            <a class="proof-strip-all" href="/reports/">All reports &rarr;</a>
          </div>
        </section>
      </div>
    </section>

    <!-- ==================== PROBLEM ==================== -->
    <section id="problem" class="scroll-mt-24 bg-slate-100/60 pb-16 pt-10">
      <div class="mx-auto max-w-[90rem] px-6" data-reveal>
        <div class="rounded-3xl bg-white p-6 shadow-xl border border-slate-200 md:p-8">
          <div class="problem-split">
            <div class="problem-copy">
              <p class="text-xs font-bold uppercase tracking-[0.2em] text-rose-500">The problem</p>
              <h2 class="mt-3 text-balance">Nobody re-reads the docs on every pull request.</h2>
              <p class="section-subcopy mt-4">
                Spec-driven development made your docs the instructions: coding agents read your specs and architecture docs as context, then write code that quietly contradicts them, and no reviewer re-reads those documents on every change to catch it. That gap is <a href="/spec-drift/" class="font-semibold text-blue-600 hover:underline">spec drift</a>. Left unchecked, each merge drifts a little further from what your team agreed, until <strong>every change costs more than it should and nobody wants to touch the core</strong>. Striff catches the contradiction on the pull request, while it is still a one-line fix.
              </p>
              <p class="problem-stat">
                In <a href="/blog/architecture-matters-more-not-less/">our survey of 335 open-source repositories</a> that write their architecture down, <strong>63% already hand their coding agents docs to build from</strong>, and <strong>only 8% of those run anything that checks the code still matches.</strong>
              </p>
              <BlogLink slug="architecture-matters-more-not-less" kicker="Why coding agents make architecture review matter more" class="mt-6" />
            </div>

            <!-- The firehose, run by agents: every lane is an agent's branch and every row in the
                 feed is an agent acting on the repo. -->
            <figure class="gs" data-reveal aria-hidden="true">
              <svg width="0" height="0" style="position:absolute"><defs><linearGradient id="gs-gemini" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#4f8df9" /><stop offset="55%" stop-color="#9b72cb" /><stop offset="100%" stop-color="#d96570" /></linearGradient></defs></svg>
              <div class="gs-head">
                <span class="gs-live"><span class="gs-live-dot"></span><span class="gs-live-repo">5 agents</span> working on acme-corp</span>
                <span class="gs-head-tag">last hour</span>
              </div>
              <div class="gs-body">
                <div class="gs-col">
                  <span class="gs-col-head">agent branches → main</span>
                  <div class="gs-graph">
                  <div class="gs-graph-scroll">
                    {[0, 1].map(() => (
                      <svg class="gs-graph-unit" viewBox="0 0 140 320" preserveAspectRatio="xMidYMid meet">
                        <path class="gs-line gs-line-main" d="M30 0 L30 320" />
                        <path class="gs-line gs-line-a" d="M30 256 C 52 256 70 242 70 218 L 70 172 C 70 148 52 144 30 144" />
                        <path class="gs-line gs-line-b" d="M30 224 C 60 224 104 206 104 178 L 104 92 C 104 66 60 64 30 64" />
                        <circle class="gs-dot gs-dot-main" cx="30" cy="32" r="5" />
                        <circle class="gs-dot gs-dot-main" cx="30" cy="96" r="5" />
                        <circle class="gs-dot gs-dot-main" cx="30" cy="160" r="5" />
                        <circle class="gs-dot gs-dot-main" cx="30" cy="224" r="5" />
                        <circle class="gs-dot gs-dot-main" cx="30" cy="288" r="5" />
                        <g class="gs-agent gs-agent-a"><circle cx="70" cy="196" r="9.5" class="gs-agent-bg" /><g transform="translate(64 190) scale(0.5)"><g class="gs-agent-mark"><path d="M11.04 19.32Q12 21.51 12 24q0-2.49.93-4.68.96-2.19 2.58-3.81t3.81-2.55Q21.51 12 24 12q-2.49 0-4.68-.93a12.3 12.3 0 0 1-3.81-2.58 12.3 12.3 0 0 1-2.58-3.81Q12 2.49 12 0q0 2.49-.96 4.68-.93 2.19-2.55 3.81a12.3 12.3 0 0 1-3.81 2.58Q2.49 12 0 12q2.49 0 4.68.96 2.19.93 3.81 2.55t2.55 3.81" /></g></g></g>
