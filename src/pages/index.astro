  <script is:inline>
    (function () {
      var stage = document.querySelector("[data-hero-stage]");
      var overlay = document.querySelector("[data-hero-check]");
      if (!stage || !overlay) return;

      function clamp(value, min, max) {
        return Math.min(max, Math.max(min, value));
      }

      function updateOverlay() {
        if (window.innerWidth < 768) {
          stage.style.removeProperty("--hero-check-progress");
          return;
        }

        var rect = stage.getBoundingClientRect();
        var viewport = window.innerHeight || document.documentElement.clientHeight;
        var enterStart = viewport * 0.92;
        var enterEnd = viewport * 0.38;
        var exitStart = viewport * 0.14;
        var exitEnd = -rect.height * 0.32;

        var enterProgress = clamp((enterStart - rect.top) / (enterStart - enterEnd), 0, 1);
        var exitProgress = clamp((exitStart - rect.top) / (exitStart - exitEnd), 0, 1);
        var progress = enterProgress * (1 - exitProgress);

        stage.style.setProperty("--hero-check-progress", progress.toFixed(3));
      }

      updateOverlay();
      window.addEventListener("scroll", updateOverlay, { passive: true });
      window.addEventListener("resize", updateOverlay);
    })();

    (function () {
      function clamp(value, min, max) {
        return Math.min(max, Math.max(min, value));
      }

      document.querySelectorAll("[data-panzoom]").forEach(function (stage) {
        var id = stage.getAttribute("data-panzoom");
        var media = stage.querySelector(".github-diff-graphic");
        var reset = document.querySelector('[data-panzoom-reset="' + id + '"]');
        if (!media) return;

        var scale = 1;
        var x = 0;
        var y = 0;
        var startX = 0;
        var startY = 0;
        var dragging = false;

        function paint() {
          media.style.transform = "translate(" + x + "px, " + y + "px) scale(" + scale + ")";
        }

        function numberAttr(name, fallback) {
          var value = parseFloat(stage.getAttribute(name) || "");
          return Number.isFinite(value) ? value : fallback;
        }

        function resetView() {
          var mobile = window.innerWidth < 768;
          scale = numberAttr(mobile ? "data-mobile-scale" : "data-initial-scale", mobile ? 1.2 : 1.6);
          x = numberAttr(mobile ? "data-mobile-x" : "data-initial-x", mobile ? -40 : -120);
          y = numberAttr(mobile ? "data-mobile-y" : "data-initial-y", mobile ? -30 : -80);
          paint();
        }

        stage.addEventListener("wheel", function (event) {
          event.preventDefault();
          var next = clamp(scale + (event.deltaY < 0 ? 0.12 : -0.12), 1, 2.8);
          scale = next;
          paint();
        }, { passive: false });

        stage.addEventListener("pointerdown", function (event) {
          dragging = true;
          startX = event.clientX - x;
          startY = event.clientY - y;
          stage.setPointerCapture(event.pointerId);
          stage.classList.add("is-dragging");
        });

        stage.addEventListener("pointermove", function (event) {
          if (!dragging || scale <= 1) return;
          x = event.clientX - startX;
          y = event.clientY - startY;
          paint();
        });

        function stopDragging() {
          dragging = false;
          stage.classList.remove("is-dragging");
        }

        stage.addEventListener("pointerup", stopDragging);
        stage.addEventListener("pointercancel", stopDragging);
        stage.addEventListener("pointerleave", stopDragging);

        if (reset) {
          reset.addEventListener("click", resetView);
        }

        resetView();
      });
    })();
  </script>
