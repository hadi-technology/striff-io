---
import BaseLayout from "../layouts/BaseLayout.astro";

/**
 * The browser extension has its own page rather than a band on the homepage.
 * It runs the same pipeline the App does: one load brings up the diagram and the
 * review of the repository's documented rules together, and a Findings button opens
 * that review beside the diagram. What it does not do is
 * run unprompted on every pull request your team opens, post where the team
 * reviews, or accumulate the history that becomes the dashboard. That is the
 * difference the page draws, and it is why this lives here rather than competing
 * with the homepage.
 */

const extensionUrl = "https://chromewebstore.google.com/detail/striffs-for-github/gcbcjajnjbplgkhnbemlkadgnjnfjoen";
const githubAppUrl = "https://github.com/apps/striff-app/installations/new";
const chromeExtensionVideoId = "YR_DYyJwM-k";

const chromeExtensionHighlights = [
  {
    icon: "diagram",
    color: "blue",
    point: "An interactive dependency diagram of any public PR"
  },
  {
    icon: "sparkle",
    color: "amber",
    point: "Its documented rules checked, one click from the diagram"
  },
  {
    icon: "comment",
    color: "emerald",
    point: "Comment straight from the diagram"
  },
  {
    icon: "bolt",
    color: "rose",
    point: "No backend, and your token stays local"
  }
];

const faqs = [
  {
    q: "Do I need to install anything on the repository?",
    a: "No. The extension runs in your browser on any public pull request you visit, so you can point it at somebody else's repository without touching it. Bring a free GitHub token for rate limits; it never leaves your browser."
  },
  {
    q: "Does the extension check documented rules too?",
    a: "Yes. One load brings up the diagram and checks the rules that repository's own documents state. When it finishes, a \u201cFindings\u201d button with the rule count on it opens the full list beside the diagram. Same pipeline as the GitHub App, on a repository you do not have to own."
  },
  {
    q: "Is it free?",
    a: "Yes, on every public pull request, with no account."
  }
];
---

<BaseLayout
  title="Browser extension | Striff"
  description="See the dependency graph of any public GitHub pull request, and that repository's own documented rules checked against the change, in a tab beside Files changed. Free, and your token stays in your browser."
  canonical="https://striff.io/extension"
>
  <main>
    <section class="section-dark pb-16 pt-16">
      <div class="mx-auto max-w-[90rem] px-6">
        <div class="chrome-ext-grid" data-reveal>
          <div class="chrome-ext-copy">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-cyan-300">Free Chrome extension</p>
            <h1 class="mt-3 text-balance">See what any GitHub PR really touches.</h1>
            <p class="section-subcopy mt-4">
              Reviewing an unfamiliar change means holding somebody else's dependency graph in your head. Striff draws it for you, in a tab right beside Files changed, so <strong>you see what a change touches before you approve it</strong>. The rules that repository states in its own documents are checked in the same load, and a Findings button opens them beside the diagram, so the intent sits next to the code. You never leave GitHub.
            </p>

            <ul class="chrome-ext-list">
              {chromeExtensionHighlights.map((item) => (
                <li class="chrome-ext-point">
                  <span class={`icon-badge icon-badge-${item.color}`} aria-hidden="true">
                    {item.icon === "diagram" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><circle cx="12" cy="18" r="3"/><path d="M8.5 7.5 11 16M15.5 7.5 13 16M9 6h6"/></svg>
                    )}
                    {item.icon === "comment" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12a8 8 0 1 1-3.2-6.4"/><path d="M21 3v6h-6"/><path d="M8 12h6M8 9h3"/></svg>
                    )}
                    {item.icon === "sparkle" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v4M12 17v4M3 12h4M17 12h4"/><path d="m6 6 2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18"/></svg>
                    )}
                    {item.icon === "bolt" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z"/></svg>
                    )}
                  </span>
                  <span class="chrome-ext-point-text">{item.point}</span>
                </li>
              ))}
            </ul>

            <a class="btn-chrome chrome-ext-cta" href={extensionUrl} target="_blank" rel="noopener noreferrer">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <circle cx="12" cy="12" r="4" />
                <line x1="21.17" y1="8" x2="12" y2="8" />
                <line x1="3.95" y1="6.06" x2="8.54" y2="14" />
                <line x1="10.88" y1="21.94" x2="15.46" y2="14" />
              </svg>
              Add to Chrome
            </a>
          </div>

          <!-- Autoplays, muted and looping. On the homepage that was a cookie surface and
               a large first paint for a section strategy had deprioritised; on the page
               whose whole job is showing the extension work, the walkthrough is the point. -->
          <div class="chrome-ext-video rounded-3xl border border-white/10 bg-slate-950 shadow-xl">
            <div class="aspect-video overflow-hidden rounded-3xl">
              <iframe
                class="h-full w-full"
                src={`https://www.youtube.com/embed/${chromeExtensionVideoId}?autoplay=1&mute=1&loop=1&playlist=${chromeExtensionVideoId}&playsinline=1&modestbranding=1&rel=0`}
                title="Striff Chrome extension walkthrough"
                loading="eager"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-slate-100/60 pb-20 pt-16">
      <div class="mx-auto max-w-3xl px-6">
        <div class="max-w-2xl" data-reveal>
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-600">Extension or App</p>
          <h2 class="mt-3 text-balance">One is for you. The other is for the team.</h2>
          <p class="section-subcopy mt-4">
            Both read the documents and answer the rules. The difference is who sees it and when. The extension is one person, one pull request, on demand, on any public repository you happen to be looking at. The App runs on every pull request your team opens, posts the result where the whole team reviews, and keeps the history that becomes your dashboard.
          </p>
        </div>

        <div class="faq-list mt-9" data-reveal>
          {faqs.map((item) => (
            <details class="faq-item">
              <summary class="faq-q">{item.q}</summary>
              <p class="faq-a">{item.a}</p>
            </details>
          ))}
        </div>

        <div class="mt-9 flex flex-wrap gap-3" data-reveal>
          <a class="btn-primary" href={githubAppUrl} target="_blank" rel="noopener noreferrer">
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
            </svg>
            Install the GitHub App
          </a>
          <a class="btn-secondary" href="/#pipeline">How it works</a>
        </div>
      </div>
    </section>
  </main>

</BaseLayout>
