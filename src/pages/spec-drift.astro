---
/**
 * The spec drift page: what the term means, what it looks like in real repositories, and how to
 * catch it. A standing reference rather than a dated post, so it lives at /spec-drift/ and wears
 * the blog's reading layout without joining the blog's list.
 *
 * Every example is a public repository's own document against its own code, checked by hand
 * against the default branch in October 2026, and every number is one the blog already published
 * with its method. The FAQ is data: the page renders it and the FAQPage structured data repeats
 * it, so the two cannot say different things.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogHead from "../components/blog/BlogHead.astro";
import PostCover from "../components/blog/PostCover.astro";
import { SITE } from "../lib/blog";
import "../styles/blog.css";

const url = `${SITE}/spec-drift/`;
const installUrl = "https://github.com/apps/striffs/installations/new";
const published = "2026-10-29";
const modified = "2026-10-29";

const title = "Spec drift: what it is and how to catch it";
const description =
  "Spec drift is when code stops matching its specs, ADRs and AGENTS.md. Real examples, how to find it by hand, and how to catch it on every pull request.";
const definition =
  "Spec drift is the gap that opens when the code no longer does what its committed specs, design docs, ADRs or agent instruction files (AGENTS.md, CLAUDE.md) say it does.";

const toc = [
  { id: "what-is-spec-drift", text: "What is spec drift?" },
  { id: "why-agents-make-it-worse", text: "Why coding agents make it worse" },
  { id: "what-it-looks-like", text: "What spec drift looks like in real repositories" },
  { id: "spec-driven-development", text: "Spec drift in spec-driven development" },
  { id: "detect-by-hand", text: "How to detect spec drift by hand" },
  { id: "detect-on-every-pull-request", text: "How to catch spec drift on every pull request" },
  { id: "write-checkable-docs", text: "How to write docs that stay checkable" },
  { id: "faq", text: "Spec drift FAQ" },
];

const faqs: { q: string; a: string }[] = [
  {
    q: "What is spec drift?",
    a: `Spec drift is the gap between what a repository&rsquo;s committed documents say about the code and what the code does. The documents are specs, design docs, ADRs, READMEs and agent instruction files such as <code>AGENTS.md</code> and <code>CLAUDE.md</code>. A refactor moves a call, deletes a class or adds a dependency, the document is not in the diff, and from that merge on the sentence is false.`,
  },
  {
    q: "Is spec drift the same as documentation drift?",
    a: `Mostly, with a difference in stakes. Documentation drift usually means docs that fell behind the code and mislead a human reader. Spec drift is the same gap in documents that something builds from: a coding agent reads the spec or <code>AGENTS.md</code> as instructions, so a stale sentence steers the next change instead of only confusing the next reader.`,
  },
  {
    q: "Can AGENTS.md or CLAUDE.md drift?",
    a: `Yes, and they drift the same way any architecture doc does: they name classes, say where things live and say what must not depend on what. In <a href="https://github.com/catatafishen/agentbridge/blob/master/AGENTS.md">agentbridge</a>, <code>AGENTS.md</code> holds up <code>MessageFormatter.kt</code> as an exemplary pattern with zero UI dependencies, and the file has imported from the <code>ui</code> package since a refactor in May 2026. An agent told to copy that file is copying the break.`,
  },
  {
    q: "How do I detect spec drift in CI?",
    a: `Turn the checkable sentences in your docs into rules and evaluate them on every pull request, at the base and at the head, so a rule the change broke is told apart from one that was already broken. Striff does this as a GitHub check: it reads the docs already in the repository, quotes the sentence behind each rule, and needs no rule files or configuration.`,
  },
  {
    q: "Which sentences can be checked automatically?",
    a: `Claims about structure: that a named class exists or has a member, where a type lives, what depends on what, and what must never depend on what. Statements of intent or behaviour (&ldquo;we prefer composition&rdquo;, &ldquo;retries are idempotent&rdquo;) are not claims a parser can answer, and Striff counts them as <em>couldn&rsquo;t check</em> rather than reporting them as passing.`,
  },
  {
    q: "Does Striff work on private repositories, and what does it cost?",
    a: `Striff is free on public repositories, documented rules included. Private repositories need a plan from $29 a month, based on how many private repositories Striff works on in a month. See <a href="/pricing/">pricing</a>.`,
  },
];

const plainText = (html: string) =>
  html
    .replace(/<[^>]+>/g, "")
    .replace(/&rsquo;/g, "’")
    .replace(/&ldquo;/g, "“")
    .replace(/&rdquo;/g, "”")
    .replace(/&amp;/g, "&");

const jsonLd = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    datePublished: published,
    dateModified: modified,
    author: { "@type": "Organization", name: "Striff", url: SITE },
    publisher: {
      "@type": "Organization",
      name: "Striff",
      url: SITE,
      logo: { "@type": "ImageObject", url: `${SITE}/icon-192.png` },
    },
    mainEntityOfPage: url,
    image: `${SITE}/og-image.png`,
    about: { "@id": `${url}#term` },
  },
  {
    "@context": "https://schema.org",
    "@type": "DefinedTerm",
    "@id": `${url}#term`,
    name: "Spec drift",
    alternateName: ["specification drift", "documentation drift", "architecture drift"],
    description: definition,
    url,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: plainText(faq.a) },
    })),
  },
]).replace(/</g, "\\u003c");
---

<BaseLayout title={`${title} | Striff`} ogTitle={title} description={description} canonical={url} ogType="article" scheme="auto">
