  </Fragment>

  <main class="sb sb-post">
    <div class="sb-progress" aria-hidden="true"></div>

    <article>
      <header class="sb-hero">
        <div class="sb-shell">
          <div class="sb-frame">
            <div class="sb-hero-main">
              <p class="sb-kicker">
                <a class="sb-kicker-home" href="/blog/">Striff Engineering</a>
