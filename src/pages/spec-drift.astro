---
/**
 * The spec drift landing page: what the term means, why it matters now, what it looks like in real
 * repositories, and how to catch it. A standing page rather than a dated post, so it lives at
 * /spec-drift/ in the blog's reading layout without joining the blog's list.
 *
 * Every example is a public repository's own document against its own code, checked by hand
 * against the default branch in October 2026, and every number is one the blog already published
 * with its method. The FAQ is data: the page renders it and the FAQPage structured data repeats
 * it, so the two cannot say different things.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogHead from "../components/blog/BlogHead.astro";
import { SITE } from "../lib/blog";
import "../styles/blog.css";

const url = `${SITE}/spec-drift/`;
const installUrl = "https://github.com/apps/striffs/installations/new";
const published = "2026-10-29";
const modified = "2026-10-29";

const title = "Spec drift: what it is and how to catch it";
const description =
  "Spec drift is when code stops matching its specs, ADRs and AGENTS.md. Real examples, why agents make it worse, and how to catch it on every pull request.";
const definition =
  "Spec drift is the gap that opens when the code no longer does what its committed specs, design docs, ADRs or agent instruction files (AGENTS.md, CLAUDE.md) say it does.";

const toc = [
  { id: "what-is-spec-drift", text: "What is spec drift?" },
  { id: "why-it-matters", text: "Why it matters now" },
  { id: "examples", text: "What it looks like" },
  { id: "how-to-catch-it", text: "How to catch it" },
  { id: "faq", text: "FAQ" },
];

const faqs: { q: string; a: string }[] = [
  {
    q: "Is spec drift the same as documentation drift?",
    a: `It is the same gap with higher stakes. Documentation drift misleads a human reader. Spec drift is that gap in a document something builds from: a coding agent reads the spec or <code>AGENTS.md</code> as instructions, so a stale sentence steers the next change.`,
  },
  {
    q: "Can AGENTS.md or CLAUDE.md drift?",
    a: `Yes. They name classes, say where things live and say what must not depend on what, and every one of those sentences can go false on a refactor that never touches the file.`,
  },
  {
    q: "How do I detect spec drift in CI?",
    a: `Turn the checkable sentences in your docs into rules and evaluate them on every pull request, at the base and at the head, so a rule the change broke is told apart from one that was already broken. Striff does this as a GitHub check, from the docs already in the repository, with nothing to configure.`,
  },
  {
    q: "Which sentences can be checked?",
    a: `Claims about structure: that a class exists or has a member, where a type lives, what depends on what, and what must never depend on what. Statements of intent (&ldquo;we prefer composition&rdquo;) are not claims a parser can answer, and Striff counts them as <em>couldn&rsquo;t check</em> rather than passing them.`,
  },
  {
    q: "What does Striff cost?",
    a: `Free on public repositories. Private repositories start at $29 a month. See <a href="/pricing/">pricing</a>.`,
  },
];

const plainText = (html: string) =>
  html
    .replace(/<[^>]+>/g, "")
    .replace(/&rsquo;/g, "’")
    .replace(/&ldquo;/g, "“")
    .replace(/&rdquo;/g, "”")
    .replace(/&amp;/g, "&");

const jsonLd = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    datePublished: published,
    dateModified: modified,
    author: { "@type": "Organization", name: "Striff", url: SITE },
    publisher: {
      "@type": "Organization",
      name: "Striff",
      url: SITE,
      logo: { "@type": "ImageObject", url: `${SITE}/icon-192.png` },
    },
    mainEntityOfPage: url,
    image: `${SITE}/og-image.png`,
    about: { "@id": `${url}#term` },
  },
  {
    "@context": "https://schema.org",
    "@type": "DefinedTerm",
    "@id": `${url}#term`,
    name: "Spec drift",
    alternateName: ["specification drift", "documentation drift", "architecture drift"],
    description: definition,
    url,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [{ q: "What is spec drift?", a: definition }, ...faqs].map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: plainText(faq.a) },
    })),
  },
]).replace(/</g, "\\u003c");
---

<BaseLayout title={`${title} | Striff`} ogTitle={title} description={description} canonical={url} ogType="article" scheme="auto">
  <Fragment slot="head">
    <BlogHead />
    <meta property="article:published_time" content={published} />
    <meta property="article:modified_time" content={modified} />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </Fragment>

  <main class="sb sb-post">
    <div class="sb-progress" aria-hidden="true"></div>

    <article>
      <header class="sb-hero">
        <div class="sb-shell">
          <div class="sb-frame">
            <div class="sb-hero-main">
              <p class="sb-kicker"><span class="sb-cat sb-tone-blue">Spec drift</span></p>
              <h1 class="sb-title">{title}</h1>
              <p class="sb-dek">{definition}</p>
              <div class="sb-cta-actions">
                <a class="sb-btn sb-btn--primary" href={installUrl} target="_blank" rel="noopener noreferrer">
                  Catch it on every pull request
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
                <a class="sb-btn sb-btn--quiet" href="/#diagram">See a real check</a>
              </div>
            </div>
          </div>
        </div>
      </header>

      <div class="sb-shell">
        <div class="sb-frame sb-body">
          <div class="sb-main">
            <div class="sb-prose" data-sb-prose>
              <h2 id="what-is-spec-drift">What is spec drift?</h2>
              <p>
                A repository&rsquo;s docs make claims about its code: <code>NodeWorker</code> calls
                <code>RepairScheduler</code>, the domain never imports infrastructure, the parsers live in
                <code>core.parse</code>. Spec drift is what happens when a pull request makes one of those claims
                false and the document isn&rsquo;t in the diff. Nothing fails. The tests pass, the review passes,
                and from that merge on the document describes code that no longer exists.
              </p>

              <h2 id="why-it-matters">Why it matters now</h2>
              <p>
                A stale doc used to cost a new contributor an afternoon. Now coding agents read
                <code>AGENTS.md</code>, <code>CLAUDE.md</code>, specs and design docs as instructions, and they
                don&rsquo;t get suspicious. Told that <code>NodeWorker</code> calls <code>RepairScheduler</code>,
                an agent will happily put back the dependency your last refactor removed. A stale spec is a set of
                instructions for undoing your own work.
              </p>
              <div class="bp-keystat bp-keystat--danger" data-reveal>
                <div class="bp-keystat-value">8%</div>
                <div class="bp-keystat-body">
                  63% of open-source repositories that document their architecture give their coding agents docs to build from. <b>Only 8% of those check that the code still matches.</b>
                  <span class="bp-keystat-src"><a href="/blog/architecture-matters-more-not-less/">Striff survey of 335 repositories, September 2026</a></span>
                </div>
              </div>

              <h2 id="examples">What it looks like</h2>
              <p>Three real cases from public repositories. Each links to the line and the commit.</p>

              <h3>A refactor moves the work; the doc still credits the old class</h3>
              <p>
                Ericsson&rsquo;s <a href="https://github.com/Ericsson/ecchronos">ecChronos</a> README says
                <code>NodeWorker</code> &ldquo;calls <code>RepairScheduler.putConfigurations()</code> to keep jobs up
                to date&rdquo;. Pull request <a href="https://github.com/Ericsson/ecchronos/pull/1786">#1786</a> moved
                that call into a new class, <code>SchemaRefresher</code>. The refactor was fine; the README was not in
                the diff. <a href="/blog/design-docs-are-enforceable-now/">The walk-through</a> shows both revisions.
              </p>

              <h3>The pattern agents are told to copy breaks its own rule</h3>
              <p>
                In <a href="https://github.com/catatafishen/agentbridge">agentbridge</a>, <code>AGENTS.md</code> points
                agents at <code>MessageFormatter.kt</code> as an exemplary pattern with &ldquo;Zero UI
                dependencies&rdquo;. Since a <a href="https://github.com/catatafishen/agentbridge/commit/b55868a9e5">refactor
                in May</a>, the file imports from the <code>ui</code> package. Every agent that follows the
                instructions copies the dependency along with the pattern. Striff&rsquo;s
                <a href="https://github.com/catatafishen/agentbridge/runs/122211791267">check on pull request #1201</a>
                lists it as already broken on master.
              </p>

              <h3>The doc names a class that no longer exists</h3>
              <p>
                <a href="https://github.com/objectionary/eo">objectionary/eo</a>&rsquo;s Maven plugin README said
                <code>org.eolang.parser.Program</code> runs the XSLT transformations and <code>Pack</code> holds the
                list. Neither class existed any more. After Striff listed both names as out of date, the maintainer
                replaced them with <code>Pipeline</code> and <code>Canonical</code> in
                <a href="https://github.com/objectionary/eo/commit/9c2adafbc83580dd15f29a43f8b5d032ada15538">one commit</a>.
              </p>

              <h2 id="how-to-catch-it">How to catch it</h2>
              <p>
                <strong>By hand,</strong> read the doc with the code open and check only the sentences that make a
                claim about structure: every name it mentions still exists, every &ldquo;A calls B&rdquo; is still in
                A&rsquo;s imports, every &ldquo;must not&rdquo; is still true, every file held up as an example still
                has the property it is praised for. It works once. It doesn&rsquo;t survive the next fifty merges.
              </p>
              <p>
                <strong>On every pull request,</strong> Striff does it for you, as a GitHub check beside your tests:
              </p>
              <ol>
                <li><strong>It reads the docs you already have:</strong> specs, ADRs, READMEs, <code>AGENTS.md</code>, <code>CLAUDE.md</code>. No rule files, no configuration.</li>
                <li><strong>It turns each checkable sentence into a rule</strong> and checks it against the code before and after the change, so it knows whether this pull request broke it or it was already broken.</li>
                <li><strong>It confirms every break before showing it:</strong> an agent re-reads the sentence and the code twice, and anything not confirmed is withheld.</li>
                <li><strong>It quotes the sentence and links the line,</strong> so the reviewer decides whether the code or the doc is wrong.</li>
              </ol>
              <p>
                <a href="/#diagram">See a real check</a>, the <a href="/demo/">dashboard demo</a>, or
                <a href="/reports/">reports on open-source repositories</a>.
              </p>

              <h2 id="faq">FAQ</h2>
              {faqs.map((faq) => (
                <Fragment>
                  <h3>{faq.q}</h3>
                  <p set:html={faq.a} />
                </Fragment>
              ))}
            </div>
          </div>

          <aside class="sb-rail" aria-label="Table of contents">
            <nav class="sb-toc">
              <p class="sb-label">On this page</p>
              <ol>
                {toc.map((heading) => (
                  <li><a href={`#${heading.id}`} data-toc-link={heading.id}>{heading.text}</a></li>
                ))}
              </ol>
            </nav>
          </aside>
        </div>
      </div>

      <footer class="sb-shell">
        <div class="sb-frame">
          <div class="sb-frame-main">
            <section class="sb-cta" aria-labelledby="sb-cta-title">
              <div>
                <p class="sb-label">The Striff GitHub App</p>
                <h2 id="sb-cta-title" class="sb-cta-title">Catch spec drift on the pull request that causes it. Free for public repositories.</h2>
              </div>
              <div class="sb-cta-actions">
                <a class="sb-btn sb-btn--primary" href={installUrl} target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" /></svg>
                  Install the GitHub App
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
                <a class="sb-btn sb-btn--quiet" href="/demo/">See the demo</a>
              </div>
            </section>
          </div>
        </div>
      </footer>
    </article>
  </main>

  <style>
    /* The page's call to action, under the definition rather than only at the foot. */
    .sb-hero .sb-cta-actions { margin-top: 1.75rem; justify-content: flex-start; }
  </style>

  <script is:inline>
    (function () {
      // Reading progress, for browsers without scroll-driven animations (the CSS covers the rest).
      var bar = document.querySelector(".sb-progress");
      if (bar && !(window.CSS && CSS.supports("animation-timeline: scroll()"))) {
        var pending = false;
        var draw = function () {
          pending = false;
          var root = document.documentElement;
          var max = root.scrollHeight - root.clientHeight;
          bar.style.transform = "scaleX(" + (max > 0 ? Math.min(1, root.scrollTop / max) : 0) + ")";
        };
        window.addEventListener("scroll", function () {
          if (pending) return;
          pending = true;
          requestAnimationFrame(draw);
        }, { passive: true });
        draw();
      }

      // Table of contents: the active section is the last heading above the upper third of the screen.
      var links = Array.prototype.slice.call(document.querySelectorAll("[data-toc-link]"));
      var targets = links.map(function (link) {
        return document.getElementById(link.getAttribute("data-toc-link"));
      });
      if (links.length) {
        var current = -2;
        var queued = false;
        var update = function () {
          queued = false;
          var line = window.innerHeight * 0.3;
          var active = -1;
          for (var i = 0; i < targets.length; i++) {
            if (targets[i] && targets[i].getBoundingClientRect().top <= line) active = i;
          }
          if (active === current) return;
          current = active;
          links.forEach(function (link, i) {
            var on = i === active;
            link.classList.toggle("is-active", on);
            if (on) link.setAttribute("aria-current", "location");
            else link.removeAttribute("aria-current");
          });
        };
        window.addEventListener("scroll", function () {
          if (queued) return;
          queued = true;
          requestAnimationFrame(update);
        }, { passive: true });
        window.addEventListener("resize", update);
        update();
      }
    })();
  </script>
</BaseLayout>
