---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact - Striff"
  description="Talk to the Striff team about product questions, private-repo rollout, or architecture-review workflows."
  canonical="https://striff.io/contact"
>
  <main class="contact-page">
    <section class="mx-auto max-w-[90rem] px-6 py-16 md:py-24">
      <div class="contact-shell">
        <div class="contact-intro" data-reveal>
          <p class="contact-eyebrow">Contact us</p>
          <h1 class="contact-title">Talk to the team behind Striff.</h1>
          <p class="contact-copy">
            Use this for rollout questions, private-repo interest, bug reports, or anything blocking adoption. We read for specifics and respond like engineers, not marketers.
          </p>
          <div class="contact-notes">
            <p><span class="contact-note-icon" aria-hidden="true">↗</span><strong>Community:</strong> Ask questions, share feedback, review the product, or suggest features on our <a href="https://github.com/hadi-technology/striff-io/discussions" target="_blank" rel="noopener noreferrer">GitHub Discussions</a> page.</p>
            <p><span class="contact-note-icon" aria-hidden="true">◆</span><strong>Enterprise or private deployment?</strong> Include your deployment model, repository scale, and security requirements so we can respond clearly.</p>
          </div>
        </div>

        <div class="contact-panel" data-reveal>
          <!-- Without an action, a successful submit lands on Netlify's own unbranded success
               page. Send people to a page that still looks like Striff and tells them what
               happens next. -->
          <form
            class="contact-form"
            name="contact"
            method="POST"
            action="/contact/thanks"
            data-netlify="true"
            netlify-honeypot="bot-field"
          >
            <input type="hidden" name="form-name" value="contact" />
            <!-- Netlify registers a form's fields from the static HTML at deploy time, so this
                 has to exist here even though only the dashboard ever fills it. -->
            <input type="hidden" name="context" id="contact-context" value="" />

            <!-- Shown, not smuggled. Someone who arrived from the dashboard should be able to
                 see what is being sent with their message, and delete it if they would rather
                 not. Hidden on a plain visit, where there is nothing to say. -->
            <div class="contact-context" id="contact-context-panel" hidden>
              <p class="contact-context-head">
                <span>Sent with your message</span>
                <button type="button" id="contact-context-drop">Don&rsquo;t include this</button>
              </p>
              <dl class="contact-context-list" id="contact-context-list"></dl>
            </div>
            <p class="hidden">
              <label>
                Don't fill this out if you're human:
                <input name="bot-field" />
              </label>
            </p>

            <div class="contact-form-grid">
              <div>
                <label class="waitlist-label" for="contact-name">Name <span class="text-red-500">*</span></label>
                <input id="contact-name" class="waitlist-input" type="text" name="name" required />
              </div>

              <div>
                <label class="waitlist-label" for="contact-email">Email <span class="text-red-500">*</span></label>
                <input id="contact-email" class="waitlist-input" type="email" name="email" required />
              </div>

              <div>
                <label class="waitlist-label" for="contact-topic">Topic <span class="text-red-500">*</span></label>
                <select id="contact-topic" class="waitlist-input" name="topic" required>
                  <option value="" disabled selected>Select a topic</option>
                  <option value="general">General question</option>
                  <option value="feedback">Feedback or feature request</option>
                  <option value="bug">Bug report</option>
                  <option value="billing">Billing or subscription issue</option>
                  <option value="private-repo">Private repository setup</option>
                  <option value="enterprise">Enterprise or private deployment</option>
                  <option value="partnership">Partnership inquiry</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div>
                <label class="waitlist-label" for="contact-company">Company <span class="contact-optional">(optional)</span></label>
                <input id="contact-company" class="waitlist-input" type="text" name="company" />
              </div>

              <div class="contact-form-full">
                <label class="waitlist-label" for="contact-message">Message <span class="text-red-500">*</span></label>
                <textarea
                  id="contact-message"
                  class="waitlist-input waitlist-textarea"
                  name="message"
                  placeholder="Tell us what's on your mind."
                  required
                ></textarea>
              </div>
            </div>

            <div class="contact-form-actions">
              <button class="btn-primary" type="submit">Send message</button>
              <p class="contact-form-note">We'll reply by email.</p>
            </div>
          </form>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  // What the dashboard knew and the form would otherwise have to ask for. The first reply to a
  // help request used to be "which account, which repository, which page" -- three questions
  // whose answers the page already had when the link was clicked.
  (function () {
    var params = new URLSearchParams(window.location.search);
    if (params.get("from") !== "dashboard") return;

    var LABELS = {
      name: "Name on GitHub",
      login: "GitHub user",
      account: "Account",
      installation: "Installation",
      repo: "Repository",
      section: "Was looking at",
    };
    var SECTIONS = {
      repos: "Repositories",
      docs: "Docs & rules",
      metrics: "Metrics",
      billing: "Billing",
    };

    var rows = [];
    Object.keys(LABELS).forEach(function (key) {
      var value = params.get(key);
      if (!value) return;
      rows.push([LABELS[key], key === "section" ? SECTIONS[value] || value : value]);
    });
    if (rows.length === 0) return;

    var panel = document.getElementById("contact-context-panel");
    var list = document.getElementById("contact-context-list");
    var field = document.getElementById("contact-context");
    if (!panel || !list || !field) return;

    rows.forEach(function (row) {
      var dt = document.createElement("dt");
      dt.textContent = row[0];
      var dd = document.createElement("dd");
      dd.textContent = row[1];
      list.appendChild(dt);
      list.appendChild(dd);
    });
    field.value = rows.map(function (row) { return row[0] + ": " + row[1]; }).join("\n");
    panel.hidden = false;

    // Their message, not ours: whoever would rather not send this can take it off.
    var drop = document.getElementById("contact-context-drop");
    if (drop) {
      drop.addEventListener("click", function () {
        field.value = "";
        panel.hidden = true;
      });
    }

    // The name is the one field this can fill without guessing at something that has to be
    // right: the email must be one they actually read, so it stays theirs to type.
    var nameField = document.getElementById("contact-name");
    var known = params.get("name") || params.get("login");
    if (nameField && known && !nameField.value) nameField.value = known;

    // Someone who pressed Help from inside the product has a product problem.
    var topic = document.getElementById("contact-topic");
    if (topic && !topic.value) topic.value = params.get("section") === "billing" ? "billing" : "general";
  })();
</script>
