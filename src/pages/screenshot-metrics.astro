              pullNo: String(412 - i),
              pullUrl: `https://github.com/acme-corp/${["core-api", "billing-service", "web-app"][i % 3]}/pull/${412 - i}`,
              regressionCount: i % 3 === 0 ? 1 : 0,
              hotspotCount: i % 3 === 0 ? 0 : 1,
              createdAtMs: Date.now() - i * 24 * 60 * 60 * 1000,
            })),
          },
        ],
      };

      const root = document.getElementById("metrics-screenshot-root");
      if (root) {
        createRoot(root).render(
          createElement(MetricsTab, { data: fakeData, loading: false, error: "" })
        );
      }
    </script>
  </body>
</html>
