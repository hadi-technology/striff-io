            highRiskPrCount: 5,
            prCheckWebhooksReceivedCount: 66,
            topFlaggedRepos: [
              { repoOwner: "acme-corp", repoName: "core-api", flaggedCount: 7 },
              { repoOwner: "acme-corp", repoName: "billing-service", flaggedCount: 4 },
              { repoOwner: "acme-corp", repoName: "web-app", flaggedCount: 3 },
            ],
            recentFlaggedPrs: [],
          },
          {
            yearMonth: "2026-03",
            structuralRegressionCount: 6,
            reviewHotspotCount: 10,
            prsAnalyzedCount: 68,
            cleanPrCount: 48,
            highRiskPrCount: 6,
            prCheckWebhooksReceivedCount: 72,
            topFlaggedRepos: [
              { repoOwner: "acme-corp", repoName: "core-api", flaggedCount: 8 },
              { repoOwner: "acme-corp", repoName: "billing-service", flaggedCount: 5 },
              { repoOwner: "acme-corp", repoName: "web-app", flaggedCount: 3 },
            ],
            recentFlaggedPrs: [],
          },
          {
            yearMonth: "2026-04",
            structuralRegressionCount: 7,
            reviewHotspotCount: 12,
            prsAnalyzedCount: 74,
            cleanPrCount: 51,
            highRiskPrCount: 7,
            prCheckWebhooksReceivedCount: 80,
            topFlaggedRepos: [
