---
// TEMPORARY page for capturing a marketing screenshot of the metrics dashboard with fake
// data. Not linked from anywhere in the site. Safe to delete once the screenshot is taken.
import "../styles/global.css";
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Metrics screenshot (temporary)</title>
  </head>
  <body>
    <main class="dashboard-page text-slate-900">
      <section class="mx-auto max-w-4xl px-6 py-16">
        <div class="dashboard-shell">
          <div class="dashboard-account-bar">
            <div>
              <p class="dashboard-kicker">Striff account</p>
              <p class="text-lg font-bold">Acme Corp</p>
            </div>
            <span class="dashboard-plan-badge">Team plan</span>
          </div>
          <div class="dashboard-installation-card">
            <div id="metrics-screenshot-root"></div>
          </div>
        </div>
      </section>
    </main>

    <script>
      import { createRoot } from "react-dom/client";
      import { createElement } from "react";
      import MetricsTab, { type OrgMetricsData } from "../components/MetricsTab";

      const fakeData: OrgMetricsData = {
        installationId: 1,
        accountLogin: "acme-corp",
        activeRepos: [
          { repoOwner: "acme-corp", repoName: "core-api", active: true },
          { repoOwner: "acme-corp", repoName: "billing-service", active: true },
          { repoOwner: "acme-corp", repoName: "web-app", active: true },
        ],
        months: [
          {
            yearMonth: "2026-02",
