              { repoOwner: "acme-corp", repoName: "billing-service", flaggedCount: 6 },
              { repoOwner: "acme-corp", repoName: "web-app", flaggedCount: 4 },
            ],
            recentFlaggedPrs: [],
          },
          {
            yearMonth: "2026-05",
            structuralRegressionCount: 5,
            reviewHotspotCount: 9,
